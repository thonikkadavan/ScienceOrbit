---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DashboardSidebar from "../../components/DashboardSidebar.astro";
import { createClient } from "../../lib/supabase";
import { getProfile, getProfileById, getSessionUser } from "../../lib/auth";

const supabase = createClient({ request: Astro.request, cookies: Astro.cookies });
const sessionUser = await getSessionUser(supabase);
const targetUserId = Astro.url.searchParams.get("user");

let profile: any;
if (targetUserId) {
  profile = await getProfileById(supabase, targetUserId);
  if (!profile) return Astro.redirect("/dashboard");
} else {
  profile = await getProfile(supabase);
  if (!profile) return Astro.redirect("/login");
}

const isOwner = sessionUser?.id === profile.id;
const avatarUrl = profile.avatar_url
  ? supabase.storage.from("avatars").getPublicUrl(profile.avatar_url).data.publicUrl
  : null;
const campusName = profile.campuses?.name ?? "";
const mentorName = profile.mentors?.name || profile.mentor_name;
const portfolioUrl = `${Astro.url.origin}/dashboard?user=${profile.id}`;
const projectTitle = profile.project_title || "";
const projectDescription = profile.project_description || "";
const projectProgress = profile.project_progress || 0;
const githubHandle = profile.github_handle || "";
const linkedinUrl = profile.linkedin_url || "";
const techStack: string[] = profile.tech_stack || [];
const repoUrl = profile.repo_url || "";
const deployUrl = profile.deploy_url || "";

// Parse milestones from JSONB
let milestones: { title: string; issuer: string; url: string }[] = [];
try {
  milestones = typeof profile.milestones === "string" ? JSON.parse(profile.milestones) : (profile.milestones || []);
} catch { milestones = []; }

// Parse social links
let socialLinks: { platform: string; value: string }[] = [];
try {
  socialLinks = typeof profile.social_links === "string" ? JSON.parse(profile.social_links) : (profile.social_links || []);
} catch {}

// Platform icon/URL mapping
const platformConfig: Record<string, { icon: string; urlPrefix: string }> = {
  GitHub: { icon: "github", urlPrefix: "https://github.com/" },
  LinkedIn: { icon: "linkedin", urlPrefix: "" },
  "X / Twitter": { icon: "x", urlPrefix: "https://x.com/" },
  Instagram: { icon: "instagram", urlPrefix: "https://instagram.com/" },
  YouTube: { icon: "youtube", urlPrefix: "https://youtube.com/@" },
  Discord: { icon: "discord", urlPrefix: "" },
  TikTok: { icon: "tiktok", urlPrefix: "https://tiktok.com/@" },
  Snapchat: { icon: "snapchat", urlPrefix: "https://snapchat.com/add/" },
  Facebook: { icon: "facebook", urlPrefix: "https://facebook.com/" },
  Reddit: { icon: "reddit", urlPrefix: "https://reddit.com/u/" },
  Threads: { icon: "threads", urlPrefix: "https://threads.net/@" },
  Bluesky: { icon: "bluesky", urlPrefix: "https://bsky.app/profile/" },
  Medium: { icon: "medium", urlPrefix: "https://medium.com/@" },
  "Stack Overflow": { icon: "stackoverflow", urlPrefix: "https://stackoverflow.com/users/" },
  ResearchGate: { icon: "researchgate", urlPrefix: "https://researchgate.net/profile/" },
  "Google Scholar": { icon: "googlescholar", urlPrefix: "https://scholar.google.com/citations?user=" },
  ORCID: { icon: "orcid", urlPrefix: "https://orcid.org/" },
};

function getSocialUrl(platform: string, value: string): string {
  const cfg = platformConfig[platform];
  if (!cfg) return value;
  if (value.startsWith("http://") || value.startsWith("https://")) return value;
  return cfg.urlPrefix + value;
}

// Legacy achievements as fallback
const legacyAchievements: string[] = profile.achievements
  ? profile.achievements.split("\n").filter(Boolean)
  : [];

// Orbit count
const { count: orbitingCount } = await supabase
  .from("orbits")
  .select("*", { count: "exact", head: true })
  .eq("orbiter_id", profile.id);

// Check if session user is orbiting this profile
let isOrbiting = false;
if (sessionUser && !isOwner) {
  const { data: orbitRow } = await supabase
    .from("orbits")
    .select("id")
    .eq("orbiter_id", sessionUser.id)
    .eq("orbiting_id", profile.id)
    .maybeSingle();
  isOrbiting = !!orbitRow;
}

// Fetch posts by this user
const { data: userPosts } = await supabase
  .from("posts")
  .select("id, content, created_at, image_url, file_url, file_name")
  .eq("user_id", profile.id)
  .order("created_at", { ascending: false })
  .limit(20);

// Batch-load like counts and liked status for these posts
const userPostIds = (userPosts || []).map((p) => p.id);
const { data: upLikes } = userPostIds.length
  ? await supabase.from("post_likes").select("post_id").in("post_id", userPostIds)
  : { data: [] };
const portfolioLikeMap = new Map<string, number>();
(upLikes || []).forEach((l) => {
  portfolioLikeMap.set(l.post_id, (portfolioLikeMap.get(l.post_id) || 0) + 1);
});
let portfolioLikedPosts = new Set<string>();
if (sessionUser && userPostIds.length) {
  const { data: myUpLikes } = await supabase
    .from("post_likes")
    .select("post_id")
    .in("post_id", userPostIds)
    .eq("user_id", sessionUser.id);
  portfolioLikedPosts = new Set((myUpLikes || []).map((l) => l.post_id));
}

function getTimeAgo(dateStr: string): string {
  const now = new Date();
  const d = new Date(dateStr);
  const diff = Math.floor((now.getTime() - d.getTime()) / 1000);
  if (diff < 60) return "just now";
  if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
  if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
  if (diff < 2592000) return `${Math.floor(diff / 86400)}d ago`;
  return d.toLocaleDateString("en-US", { month: "short", day: "numeric" });
}
---

<BaseLayout title={profile.display_name || profile.username}>
  <DashboardSidebar current="portfolio" />
  <div class="pp-root">
    <main class="pp-main">
      <div class="pp-container">
        <!-- Left Column -->
        <div class="pp-left">

          <!-- Profile Hero Card -->
          <div class="pp-card pp-hero-card">
            <div class="pp-hero-inner">
              {avatarUrl ? (
                <img src={avatarUrl} alt={profile.display_name} class="pp-avatar" />
              ) : (
                <div class="pp-avatar pp-avatar-placeholder">
                  <span class="material-symbols-outlined">person</span>
                </div>
              )}
              <div class="pp-hero-body">
                <h1 class="pp-name">{profile.display_name || profile.username}</h1>
                <p class="pp-role">{profile.mentor_name || "Scholar"}</p>
                <div class="pp-meta">
                  <span class="pp-meta-item">
                    <span class="material-symbols-outlined pp-meta-icon">location_on</span>
                    {campusName || "Not affiliated"}
                  </span>
                  {mentorName && (
                    <span class="pp-meta-item">
                      <span class="material-symbols-outlined pp-meta-icon">school</span>
                      Assigned Mentor: {mentorName}
                    </span>
                  )}
                </div>
                <div class="pp-orbit-stats">
                  <div class="pp-orbit-stat">
                    <span class="pp-orbit-num" id="orbiting-count">{orbitingCount ?? 0}</span>
                    <span class="pp-orbit-label">Orbiting</span>
                  </div>
                </div>
                {!isOwner && (
                  <button class="pp-follow-btn" id="orbit-btn" data-user-id={profile.id} data-orbiting={isOrbiting}>
                    {isOrbiting ? "Following" : "Follow"}
                  </button>
                )}
                {profile.subjects && profile.subjects.length > 0 && (
                  <div class="pp-chips-wrap">
                    {profile.subjects.map((s: string) => (
                      <span class="pp-chip">{s}</span>
                    ))}
                  </div>
                )}
                {techStack.length > 0 && (
                  <div class="pp-chips-wrap pp-tech-wrap">
                    {techStack.map((t: string) => (
                      <span class="pp-chip pp-tech-chip">{t}</span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </div>

          <!-- Mobile Sub Nav -->
          <nav class="pp-mobile-tabs" id="mobile-tabs">
            <button class="pp-mtab active" data-tab="posts">Posts</button>
            <button class="pp-mtab" data-tab="achievements">Achievements</button>
            {(socialLinks.length > 0 || isOwner) && <button class="pp-mtab" data-tab="connect">Connect</button>}
            {projectTitle && <button class="pp-mtab" data-tab="project">Project</button>}
          </nav>

          <!-- Tab Panels -->
          <div class="pp-tab-panel pp-tab-panel--active" data-tab="posts">
          <!-- Posts -->
          {userPosts && userPosts.length > 0 && (
            <div class="pp-card pp-posts-card">
              <h2 class="pp-section-title">
                <span class="material-symbols-outlined pp-section-icon">dynamic_feed</span>
                Posts
              </h2>
              <div class="pp-posts-list">
                {userPosts.map((p) => (
                    <div class="pp-post-item">
                      <div class="pp-post-content">
                        {p.content ? <p class="pp-post-text">{p.content}</p> : null}
                        {p.image_url ? <img src={p.image_url} class="pp-post-image" alt="" loading="lazy" /> : null}
                        {p.file_url ? <a href={p.file_url} target="_blank" class="pp-post-attach"><span class="material-symbols-outlined">description</span> {p.file_name || "Attachment"}</a> : null}
                      </div>
                      <div class="pp-post-meta-row">
                        <span class="pp-post-time">{getTimeAgo(p.created_at)}</span>
                        <button class="pp-like-btn" data-post-id={p.id} data-liked={portfolioLikedPosts.has(p.id) ? "true" : "false"}>
                          <span class="material-symbols-outlined pp-like-icon">{portfolioLikedPosts.has(p.id) ? "favorite" : "favorite_border"}</span>
                          <span class="pp-like-count">{portfolioLikeMap.get(p.id) || 0}</span>
                        </button>
                      </div>
                    </div>
                ))}
              </div>
            </div>
          )}
          {(!userPosts || userPosts.length === 0) && (
            <div class="pp-card">
              <p class="pp-empty">No posts yet.</p>
            </div>
          )}
          </div>

          <div class="pp-tab-panel" data-tab="achievements">
          <!-- Verifiable Achievements -->
          {(milestones.length > 0 || legacyAchievements.length > 0 || isOwner) && (
            <div class="pp-card">
              <h2 class="pp-section-title">
                <span class="material-symbols-outlined pp-section-icon">emoji_events</span>
                Verifiable Achievements
              </h2>
              <div class="pp-milestones-list">
                {milestones.length > 0 ? milestones.map((m) => (
                  <div class="pp-milestone-row">
                    <div class="pp-milestone-left">
                      <span class="material-symbols-outlined pp-milestone-badge">verified</span>
                      <div>
                        <h4 class="pp-milestone-title">{m.title}</h4>
                        {m.issuer && <p class="pp-milestone-issuer">{m.issuer}</p>}
                      </div>
                    </div>
                    {m.url && (
                      <a href={m.url} target="_blank" class="pp-milestone-link" title="Verify">
                        <span class="material-symbols-outlined">open_in_new</span>
                      </a>
                    )}
                  </div>
                )) : legacyAchievements.map((ach) => (
                  <div class="pp-milestone-row">
                    <div class="pp-milestone-left">
                      <span class="material-symbols-outlined pp-milestone-badge">verified</span>
                      <div>
                        <h4 class="pp-milestone-title">{ach}</h4>
                      </div>
                    </div>
                  </div>
                ))}
                {milestones.length === 0 && legacyAchievements.length === 0 && (
                  <p class="pp-empty">No achievements added yet.</p>
                )}
              </div>
            </div>
          )}
          </div>

          <div class="pp-tab-panel" data-tab="connect">
            <div class="pp-card pp-connect-card">
              <h3 class="pp-connect-title">Connect</h3>
              <div class="pp-social-row">
                {socialLinks.map((sl) => {
                  const href = getSocialUrl(sl.platform, sl.value);
                  const label = sl.platform;
                  return (
                    <a href={href} target="_blank" class="pp-social-btn" title={label}>
                      <span class="pp-social-text">{sl.platform === "GitHub" ? "GH" : sl.platform === "LinkedIn" ? "LI" : sl.platform === "X / Twitter" ? "X" : sl.platform.slice(0, 2).toUpperCase()}</span>
                    </a>
                  );
                })}
              </div>
              {isOwner && (
                <>
                  <a href="/dashboard/edit" class="pp-action-btn">Edit Portfolio</a>
                  <button class="pp-action-btn pp-action-secondary" id="copy-portfolio-link" data-url={portfolioUrl}>
                    <span class="material-symbols-outlined" style="font-size:16px">link</span>
                    Copy Portfolio Link
                  </button>
                </>
              )}
            </div>
          </div>

          <div class="pp-tab-panel" data-tab="project">
            {projectTitle ? (
            <div class="pp-card">
              <span class="pp-project-badge">Current Project</span>
              <div class="pp-project-head">
                <h4 class="pp-project-name">{projectTitle}</h4>
                <div class="pp-project-links">
                  {repoUrl && (
                    <a href={repoUrl} target="_blank" class="pp-project-link" title="Repository">
                      <svg class="pp-social-icon" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                      </svg>
                    </a>
                  )}
                  {deployUrl && (
                    <a href={deployUrl} target="_blank" class="pp-project-link" title="Live Site">
                      <span class="material-symbols-outlined" style="font-size:16px">open_in_new</span>
                    </a>
                  )}
                </div>
              </div>
              {projectDescription && <p class="pp-project-desc">{projectDescription}</p>}
              <div class="pp-progress-section">
                <div class="pp-progress-labels">
                  <span>Analysis Phase</span>
                  <span>{projectProgress}%</span>
                </div>
                <div class="pp-progress-track">
                  <div class="pp-progress-fill" style={`width:${projectProgress}%`}></div>
                </div>
              </div>
            </div>
            ) : (
            <div class="pp-card"><p class="pp-empty">No current project.</p></div>
            )}
          </div>

        </div>

        <!-- Right Column (desktop only) -->
        <div class="pp-right pp-desktop-only">
          <div class="pp-card pp-connect-card">
            <h3 class="pp-connect-title">Connect</h3>
            <div class="pp-social-row">
              {socialLinks.map((sl) => {
                const href = getSocialUrl(sl.platform, sl.value);
                const label = sl.platform;
                return (
                  <a href={href} target="_blank" class="pp-social-btn" title={label}>
                    <span class="pp-social-text">{sl.platform === "GitHub" ? "GH" : sl.platform === "LinkedIn" ? "LI" : sl.platform === "X / Twitter" ? "X" : sl.platform.slice(0, 2).toUpperCase()}</span>
                  </a>
                );
              })}
            </div>
            {isOwner && (
              <>
                <a href="/dashboard/edit" class="pp-action-btn">Edit Portfolio</a>
                <button class="pp-action-btn pp-action-secondary" id="copy-portfolio-link" data-url={portfolioUrl}>
                  <span class="material-symbols-outlined" style="font-size:16px">link</span>
                  Copy Portfolio Link
                </button>
              </>
            )}
          </div>
          {projectTitle && (
            <div class="pp-card">
              <span class="pp-project-badge">Current Project</span>
              <div class="pp-project-head">
                <h4 class="pp-project-name">{projectTitle}</h4>
                <div class="pp-project-links">
                  {repoUrl && (
                    <a href={repoUrl} target="_blank" class="pp-project-link" title="Repository">
                      <svg class="pp-social-icon" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                      </svg>
                    </a>
                  )}
                  {deployUrl && (
                    <a href={deployUrl} target="_blank" class="pp-project-link" title="Live Site">
                      <span class="material-symbols-outlined" style="font-size:16px">open_in_new</span>
                    </a>
                  )}
                </div>
              </div>
              {projectDescription && <p class="pp-project-desc">{projectDescription}</p>}
              <div class="pp-progress-section">
                <div class="pp-progress-labels">
                  <span>Analysis Phase</span>
                  <span>{projectProgress}%</span>
                </div>
                <div class="pp-progress-track">
                  <div class="pp-progress-fill" style={`width:${projectProgress}%`}></div>
                </div>
              </div>
            </div>
          )}
        </div>
      </div>
    </main>
  </div>

  <nav class="pp-bottom-nav">
    <a href="/dashboard/feed" class="pp-bnav-item">
      <span class="material-symbols-outlined">dynamic_feed</span>
      <span>Feed</span>
    </a>
    <a href="/dashboard" class="pp-bnav-item active">
      <span class="material-symbols-outlined">account_circle</span>
      <span>Portfolio</span>
    </a>
    <a href="/dashboard/events" class="pp-bnav-item">
      <span class="material-symbols-outlined">event</span>
      <span>Events</span>
    </a>
    <a href="/dashboard/settings" class="pp-bnav-item">
      <span class="material-symbols-outlined">settings</span>
      <span>Settings</span>
    </a>
  </nav>
</BaseLayout>

<script>
  import { createBrowserClient } from "@supabase/ssr";

  // Copy portfolio link
  const copyBtn = document.getElementById("copy-portfolio-link");
  copyBtn?.addEventListener("click", async () => {
    const url = copyBtn.getAttribute("data-url");
    if (!url) return;
    try {
      await navigator.clipboard.writeText(url);
      copyBtn.innerHTML = '<span class="material-symbols-outlined" style="font-size:16px">check</span> Copied!';
      setTimeout(() => {
        copyBtn.innerHTML = '<span class="material-symbols-outlined" style="font-size:16px">link</span> Copy Portfolio Link';
      }, 2000);
    } catch {
      const ta = document.createElement("textarea");
      ta.value = url;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      document.body.removeChild(ta);
    }
  });

  // Follow toggle
  const orbitBtn = document.getElementById("orbit-btn");
  orbitBtn?.addEventListener("click", async () => {
    const userId = orbitBtn.dataset.userId;
    const isOrbiting = orbitBtn.dataset.orbiting === "true";
    const supabase = createBrowserClient(
      import.meta.env.PUBLIC_SUPABASE_URL,
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY
    );
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) return;
    if (isOrbiting) {
      const { error } = await supabase.from("orbits").delete().eq("orbiter_id", user.id).eq("orbiting_id", userId);
      if (error) { console.error(error); return; }
      orbitBtn.dataset.orbiting = "false";
      orbitBtn.textContent = "Follow";
      const countEl = document.getElementById("orbiting-count");
      if (countEl) countEl.textContent = Math.max(0, parseInt(countEl.textContent) - 1);
    } else {
      const { error } = await supabase.from("orbits").insert({ orbiter_id: user.id, orbiting_id: userId });
      if (error) { console.error(error); return; }
      orbitBtn.dataset.orbiting = "true";
      orbitBtn.textContent = "Following";
      const countEl = document.getElementById("orbiting-count");
      if (countEl) countEl.textContent = parseInt(countEl.textContent) + 1;
    }
  });

  // Mobile tab switching
  const tabs = document.querySelectorAll(".pp-mtab");
  const panels = document.querySelectorAll(".pp-tab-panel");
  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const target = tab.dataset.tab;
      tabs.forEach((t) => t.classList.remove("active"));
      tab.classList.add("active");
      panels.forEach((p) => {
        p.classList.toggle("pp-tab-panel--active", p.dataset.tab === target);
      });
    });
  });

  // Like / unlike on portfolio
  document.querySelectorAll(".pp-like-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const postId = btn.dataset.postId;
      const liked = btn.dataset.liked === "true";
      const icon = btn.querySelector(".pp-like-icon");
      const countEl = btn.querySelector(".pp-like-count");
      const supabase = createBrowserClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY
      );
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) return;
      if (liked) {
        const { error } = await supabase.from("post_likes").delete().eq("post_id", postId).eq("user_id", user.id);
        if (error) { console.error(error); return; }
        btn.dataset.liked = "false";
        if (icon) icon.textContent = "favorite_border";
        if (countEl) countEl.textContent = Math.max(0, parseInt(countEl.textContent) - 1);
      } else {
        const { error } = await supabase.from("post_likes").insert({ post_id: postId, user_id: user.id });
        if (error) { console.error(error); return; }
        btn.dataset.liked = "true";
        if (icon) icon.textContent = "favorite";
        if (countEl) countEl.textContent = parseInt(countEl.textContent) + 1;
      }
    });
  });
</script>

<style is:global>
  .pp-root {
    display: flex;
    min-height: 100vh;
    background: #f7f9fc;
    font-family: Inter, sans-serif;
  }

  .pp-main {
    flex: 1;
    overflow-y: auto;
    padding: 2rem;
    margin-left: 64px;
    transition: margin-left 0.2s ease;
  }

  body:has(.ds-sidebar:hover) .pp-main {
    margin-left: 240px;
  }

  .pp-container {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 1024px) {
    .pp-container {
