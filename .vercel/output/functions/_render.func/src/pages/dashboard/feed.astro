---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DashboardSidebar from "../../components/DashboardSidebar.astro";
import { createClient } from "../../lib/supabase";
import { getProfile, getSessionUser } from "../../lib/auth";

const supabase = createClient({ request: Astro.request, cookies: Astro.cookies });
const sessionUser = await getSessionUser(supabase);
const profile = await getProfile(supabase);

if (!profile) {
  return Astro.redirect("/login");
}

const avatarUrl = profile.avatar_url
  ? supabase.storage.from("avatars").getPublicUrl(profile.avatar_url).data.publicUrl
  : null;

const { data: newUsers } = await supabase
  .from("profiles")
  .select("id, username, display_name, avatar_url, legal_name")
  .order("created_at", { ascending: false })
  .limit(5);

const { data: posts } = await supabase
  .from("posts")
  .select("id, user_id, content, created_at, image_url, file_url, file_name")
  .order("created_at", { ascending: false })
  .limit(50);

// Batch load author profiles for posts
const authorIds = [...new Set((posts || []).map((p) => p.user_id))];
const { data: authors } = authorIds.length
  ? await supabase.from("profiles").select("id, username, display_name, avatar_url").in("id", authorIds)
  : { data: [] };
const authorMap = new Map((authors || []).map((a) => [a.id, a]));
const postsWithAuthors = (posts || []).map((p) => ({ ...p, author: authorMap.get(p.user_id) || null }));

// Batch-load like counts and liked status for posts
const postIds = (posts || []).map((p) => p.id);
const { data: likeCounts } = postIds.length
  ? await supabase.from("post_likes").select("post_id").in("post_id", postIds)
  : { data: [] };
const likeCountMap = new Map<string, number>();
(likeCounts || []).forEach((l) => {
  likeCountMap.set(l.post_id, (likeCountMap.get(l.post_id) || 0) + 1);
});
let likedPosts = new Set<string>();
if (sessionUser && postIds.length) {
  const { data: myLikes } = await supabase
    .from("post_likes")
    .select("post_id")
    .in("post_id", postIds)
    .eq("user_id", sessionUser.id);
  likedPosts = new Set((myLikes || []).map((l) => l.post_id));
}

function getTimeAgo(dateStr: string | null): string {
  if (!dateStr) return "";
  const now = new Date();
  const d = new Date(dateStr);
  const diff = Math.floor((now.getTime() - d.getTime()) / 1000);
  if (diff < 60) return "just now";
  if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
  if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
  if (diff < 2592000) return `${Math.floor(diff / 86400)}d ago`;
  return d.toLocaleDateString("en-US", { month: "short", day: "numeric" });
}
---

<BaseLayout title="Academic Feed">
  <DashboardSidebar current="feed" />
  <div class="feed-root">
    <main class="feed-main">
      <div class="feed-content">
        <div class="top-search-wrap">
          <span class="material-symbols-outlined top-search-icon">search</span>
          <input class="top-search-input" type="text" id="top-search" placeholder="Search scholars and posts..." autocomplete="off" />
          <button class="top-search-clear" id="top-search-clear" aria-label="Clear">
            <span class="material-symbols-outlined">close</span>
          </button>
          <div class="top-search-dropdown" id="top-search-dropdown"></div>
        </div>

        <div class="feed-newusers">
          <div class="feed-newusers-label">New Members</div>
          <div class="feed-newusers-list">
            {(newUsers || []).map((u) => {
              const uAvatar = u.avatar_url
                ? supabase.storage.from("avatars").getPublicUrl(u.avatar_url).data.publicUrl
                : null;
              return (
                <a href={`/dashboard?user=${u.id}`} class="feed-newuser-item" title={u.display_name || u.username}>
                  {uAvatar ? (
                    <img src={uAvatar} alt="" class="feed-newuser-avatar" />
                  ) : (
                    <div class="feed-newuser-avatar feed-newuser-placeholder">
                      <span class="material-symbols-outlined">person</span>
                    </div>
                  )}
                  <span class="feed-newuser-name">{u.display_name || u.username}</span>
                </a>
              );
            })}
          </div>
        </div>

        <div class="feed-composer-overlay" id="composer-overlay">
          <div class="feed-composer-modal">
            <div class="composer-modal-header">
              <h3>Create Post</h3>
              <button class="composer-close-btn" id="composer-close" aria-label="Close">
                <span class="material-symbols-outlined">close</span>
              </button>
            </div>
            <div class="post-composer">
              <div class="composer-avatar">
                {avatarUrl ? (
                  <img src={avatarUrl} alt="" class="composer-avatar-img" />
                ) : (
                  <div class="composer-avatar-placeholder">
                    <span class="material-symbols-outlined">person</span>
                  </div>
                )}
              </div>
              <div class="composer-input-area">
                <textarea class="composer-input composer-textarea" placeholder="Share your latest findings..." rows="4"></textarea>
                <div class="composer-preview" id="composer-preview" style="display:none"></div>
              </div>
              <div class="composer-actions">
                <button class="composer-action-btn" id="composer-image-btn" aria-label="Add image">
                  <span class="material-symbols-outlined">image</span>
                </button>
                <input type="file" id="composer-image-input" accept="image/*" style="display:none" />
                <button class="composer-action-btn" id="composer-attach-btn" aria-label="Attach file">
                  <span class="material-symbols-outlined">attach_file</span>
                </button>
                <input type="file" id="composer-file-input" style="display:none" />
                <button class="composer-post-btn">Post</button>
              </div>
            </div>
          </div>
        </div>

        <div class="profile-overlay" id="profile-overlay">
          <div class="profile-modal">
            <div class="profile-modal-header">
              <h3>Scholar Profile</h3>
              <button class="profile-close-btn" id="profile-close" aria-label="Close">
                <span class="material-symbols-outlined">close</span>
              </button>
            </div>
            <div class="profile-modal-body" id="profile-modal-body"></div>
          </div>
        </div>

        <button class="feed-fab" id="fab-add" aria-label="Create post">
          <span class="material-symbols-outlined">add</span>
        </button>

        <div class="feed-posts" id="feed-posts">
          {postsWithAuthors.length === 0 && (
            <p class="feed-empty">No posts yet. Be the first to share your findings!</p>
          )}
          {postsWithAuthors.map((post) => {
            const author = post.author;
            const authorAvatar = author?.avatar_url
              ? supabase.storage.from("avatars").getPublicUrl(author.avatar_url).data.publicUrl
              : null;
            const timeAgo = getTimeAgo(post.created_at);
            return (
            <article class="feed-post" data-post-id={post.id}>
              <div class="post-header">
                <div class="post-author">
                  <div class="post-avatar">
                    {authorAvatar ? (
                      <img src={authorAvatar} alt="" class="post-avatar-img" />
                    ) : (
                      <span class="material-symbols-outlined">account_circle</span>
                    )}
                  </div>
                  <div class="post-author-info">
                    <strong class="post-author-name">{author?.display_name || author?.username || "Unknown"}</strong>
                    <span class="post-author-meta">{timeAgo}</span>
                  </div>
                </div>
                {post.user_id === profile.id && (
                  <button class="post-menu-btn post-delete-btn" data-post-id={post.id} aria-label="Delete post">
                    <span class="material-symbols-outlined">delete</span>
                  </button>
                )}
              </div>
              <div class="post-body">
                {post.content ? <p class="post-text">{post.content}</p> : null}
                {post.image_url ? <img src={post.image_url} class="post-image" alt="" loading="lazy" /> : null}
                {post.file_url ? <a href={post.file_url} target="_blank" class="post-attach-link"><span class="material-symbols-outlined">description</span> {post.file_name || "Attachment"}</a> : null}
              </div>
              <div class="post-actions">
                <button class="post-action-btn post-like-btn" data-post-id={post.id} data-liked={likedPosts.has(post.id) ? "true" : "false"}>
                  <span class="material-symbols-outlined post-like-icon">{likedPosts.has(post.id) ? "favorite" : "favorite_border"}</span>
                  <span class="post-like-count">{likeCountMap.get(post.id) || 0}</span>
                </button>
              </div>
            </article>
            );
          })}
        </div>
      </div>

      <aside class="feed-right">
        <div class="right-card trending-card">
          <h3 class="right-card-title">Trending Topics</h3>
          <div class="trending-list">
            <div class="trending-item">
              <span class="trending-hashtag">#QuantumComputing</span>
              <span class="trending-count">1.2k papers this week</span>
            </div>
            <div class="trending-item">
              <span class="trending-hashtag">#CRISPR</span>
              <span class="trending-count">845 papers this week</span>
            </div>
            <div class="trending-item">
              <span class="trending-hashtag">#RenewableEnergy</span>
              <span class="trending-count">620 papers this week</span>
            </div>
          </div>
        </div>

        <div class="right-card events-card">
          <h3 class="right-card-title">Upcoming Events</h3>
          <div class="events-list">
            <div class="event-card">
              <div class="event-date">
                <span class="event-date-day">12</span>
                <span class="event-date-month">Oct</span>
              </div>
              <div class="event-info">
                <strong class="event-title">Annual Science Symposium</strong>
                <span class="event-meta">Main Auditorium &bull; 09:00 AM</span>
              </div>
            </div>
            <div class="event-card">
              <div class="event-date">
                <span class="event-date-day">15</span>
                <span class="event-date-month">Oct</span>
              </div>
              <div class="event-info">
                <strong class="event-title">Guest Lecture: Astrophysics</strong>
                <span class="event-meta">Room 4B &bull; 14:00 PM</span>
              </div>
            </div>
          </div>
        </div>
      </aside>
    </main>
  </div>

  <nav class="feed-bottom-nav">
    <a href="/dashboard/feed" class="bottom-nav-item active">
      <span class="material-symbols-outlined">dynamic_feed</span>
      <span>Feed</span>
    </a>
    <a href="/dashboard" class="bottom-nav-item">
      <span class="material-symbols-outlined">account_circle</span>
      <span>Portfolio</span>
    </a>
    <a href="/dashboard/events" class="bottom-nav-item">
      <span class="material-symbols-outlined">event</span>
      <span>Events</span>
    </a>
    <a href="/dashboard/settings" class="bottom-nav-item">
      <span class="material-symbols-outlined">settings</span>
      <span>Settings</span>
    </a>
  </nav>
</BaseLayout>

<script>
  import { createBrowserClient } from "@supabase/ssr";

  const supabase = createBrowserClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  // Composer modal
  const fab = document.getElementById("fab-add");
  const overlay = document.getElementById("composer-overlay");
  const closeBtn = document.getElementById("composer-close");

  fab?.addEventListener("click", () => overlay?.classList.add("open"));
  closeBtn?.addEventListener("click", () => overlay?.classList.remove("open"));
  overlay?.addEventListener("click", (e) => {
    if (e.target === overlay) overlay.classList.remove("open");
  });

  // Profile viewer modal
  const profileOverlay = document.getElementById("profile-overlay");
  const profileClose = document.getElementById("profile-close");
  const profileBody = document.getElementById("profile-modal-body");

  profileClose?.addEventListener("click", () => profileOverlay?.classList.remove("open"));
  profileOverlay?.addEventListener("click", (e) => {
    if (e.target === profileOverlay) profileOverlay.classList.remove("open");
  });

  function avatarUrl(path) {
    if (!path) return null;
    if (path.startsWith("http")) return path;
    return supabase.storage.from("avatars").getPublicUrl(path).data.publicUrl;
  }

  function showProfile(profile) {
    const subs = Array.isArray(profile.subjects) ? profile.subjects : [];
    const achievements = profile.achievements
      ? profile.achievements.split("\n").filter(Boolean)
      : [];
    const campusName = profile.campuses?.name || "";
    const displayName = profile.display_name || profile.username;
    const avUrl = avatarUrl(profile.avatar_url);
    const avatarHtml = avUrl
      ? `<img src="${avUrl}" alt="" class="pv-avatar-img" />`
      : `<div class="pv-avatar-placeholder"><span class="material-symbols-outlined">person</span></div>`;

    profileBody.innerHTML = `
      <div class="pv-hero">
        <div class="pv-avatar">${avatarHtml}</div>
        <h2 class="pv-name">${displayName}</h2>
        <span class="pv-username">@${profile.username}</span>
        ${campusName ? `<div class="pv-campus"><span class="material-symbols-outlined">location_on</span> ${campusName}</div>` : ""}
      </div>
      ${subs.length ? `<div class="pv-section"><h4 class="pv-section-title">Subjects</h4><div class="pv-chips">${subs.map(s => `<span class="pv-chip">${s}</span>`).join("")}</div></div>` : ""}
      ${achievements.length ? `<div class="pv-section"><h4 class="pv-section-title">Achievements</h4><ul class="pv-achievements">${achievements.map(a => `<li class="pv-achievement"><span class="material-symbols-outlined pv-achievement-icon">emoji_events</span>${a}</li>`).join("")}</ul></div>` : ""}
      <div class="pv-actions">
        <a href="/dashboard?user=${profile.id}" class="pv-view-btn">View Full Portfolio</a>
      </div>
    `;
    profileOverlay?.classList.add("open");
  }

  // Search
  const searchInput = document.getElementById("top-search");
  const searchClear = document.getElementById("top-search-clear");
  const searchDropdown = document.getElementById("top-search-dropdown");
  let searchTimer;
  let searchFocused = false;

  function closeDropdown() { searchDropdown.classList.remove("open"); searchFocused = false; }

  searchClear?.addEventListener("click", () => {
    searchInput.value = "";
    closeDropdown();
    searchInput.focus();
  });

  searchInput?.addEventListener("input", () => {
    clearTimeout(searchTimer);
    searchClear.style.display = searchInput.value ? "flex" : "none";
    const query = searchInput.value.trim();
    if (!query) { searchDropdown.classList.remove("open"); searchDropdown.innerHTML = ""; return; }
    searchTimer = setTimeout(() => doSearch(query), 250);
  });

  searchInput?.addEventListener("focus", () => { searchFocused = true; });
  searchInput?.addEventListener("blur", () => setTimeout(() => { if (!searchFocused) closeDropdown(); }, 200));

  document.addEventListener("click", (e) => {
    if (!e.target.closest(".top-search-wrap")) closeDropdown();
  });

  async function doSearch(query) {
    searchDropdown.innerHTML = `<div class="tsd-status">Searching...</div>`;
    searchDropdown.classList.add("open");

    const [profilesRes] = await Promise.all([
      supabase
        .from("profiles")
        .select("id, username, display_name, avatar_url, subjects, achievements, campuses(name)")
        .eq("is_approved", true)
        .or(`username.ilike.%${query}%,display_name.ilike.%${query}%,legal_name.ilike.%${query}%`)
        .limit(6)
    ]);

    let html = "";

    if (profilesRes.error) {
      html = `<div class="tsd-status tsd-error">Search failed</div>`;
    } else {
      if (profilesRes.data.length) {
        html += `<div class="tsd-group-title">Scholars</div>`;
        html += profilesRes.data.map(p => {
          const dn = p.display_name || p.username;
          const initial = (dn || "?")[0].toUpperCase();
          const avUrl = avatarUrl(p.avatar_url);
          const img = avUrl
            ? `<img src="${avUrl}" alt="" class="tsd-avatar-img" />`
            : `<div class="tsd-avatar-placeholder">${initial}</div>`;
          const subs = Array.isArray(p.subjects) ? p.subjects.slice(0, 2) : [];
          return `<div class="tsd-item tsd-user" data-user='${JSON.stringify(p).replace(/'/g, "&#39;")}'>
            ${img}
            <div class="tsd-info">
              <span class="tsd-name">${dn}</span>
              <span class="tsd-meta">@${p.username}</span>
              ${subs.length ? `<div class="tsd-chips">${subs.map(s => `<span class="tsd-chip">${s}</span>`).join("")}</div>` : ""}
            </div>
          </div>`;
        }).join("");
      }
    }

    if (!html) html = `<div class="tsd-status">No results found</div>`;

    searchDropdown.innerHTML = html;

    searchDropdown.querySelectorAll(".tsd-user").forEach(el => {
      el.addEventListener("click", () => {
        showProfile(JSON.parse(el.dataset.user));
        closeDropdown();
      });
    });
  }
  // Post creation
  const composerTextarea = document.querySelector(".composer-textarea");
  const postBtn = document.querySelector(".composer-post-btn");
  const feedPosts = document.getElementById("feed-posts");
  const composerPreview = document.getElementById("composer-preview");
  let pendingImageUrl = "";
  let pendingFileUrl = "";
  let pendingFileName = "";

  // Image upload
  const imageInput = document.getElementById("composer-image-input");
  document.getElementById("composer-image-btn")?.addEventListener("click", () => imageInput?.click());
  imageInput?.addEventListener("change", async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) return;
    const ext = file.name.split(".").pop();
    const path = `posts/${user.id}/${Date.now()}.${ext}`;
    const { error } = await supabase.storage.from("post_images").upload(path, file);
    if (error) { console.error(error); return; }
    const { data: { publicUrl } } = supabase.storage.from("post_images").getPublicUrl(path);
    pendingImageUrl = publicUrl;
    composerPreview.style.display = "flex";
    composerPreview.innerHTML = `<img src="${publicUrl}" class="composer-preview-img" /><button class="composer-preview-remove" id="preview-remove-img"><span class="material-symbols-outlined">close</span></button>`;
    document.getElementById("preview-remove-img")?.addEventListener("click", () => { pendingImageUrl = ""; composerPreview.style.display = "none"; composerPreview.innerHTML = ""; imageInput.value = ""; });
  });

  // File upload
  const fileInput = document.getElementById("composer-file-input");
  document.getElementById("composer-attach-btn")?.addEventListener("click", () => fileInput?.click());
  fileInput?.addEventListener("change", async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) return;
    const ext = file.name.split(".").pop();
    const path = `posts/${user.id}/${Date.now()}.${ext}`;
    const { error } = await supabase.storage.from("post_images").upload(path, file);
    if (error) { console.error(error); return; }
    const { data: { publicUrl } } = supabase.storage.from("post_images").getPublicUrl(path);
    pendingFileUrl = publicUrl;
    pendingFileName = file.name;
    composerPreview.style.display = "flex";
    composerPreview.innerHTML = `<span class="material-symbols-outlined">description</span><span class="composer-preview-filename">${file.name}</span><button class="composer-preview-remove" id="preview-remove-file"><span class="material-symbols-outlined">close</span></button>`;
    document.getElementById("preview-remove-file")?.addEventListener("click", () => { pendingFileUrl = ""; pendingFileName = ""; composerPreview.style.display = "none"; composerPreview.innerHTML = ""; fileInput.value = ""; });
  });

  postBtn?.addEventListener("click", async () => {
    const content = composerTextarea?.value?.trim();
    if (!content && !pendingImageUrl && !pendingFileUrl) return;
    postBtn.disabled = true;
    postBtn.textContent = "Posting...";
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) { postBtn.disabled = false; postBtn.textContent = "Post"; return; }
    const { data, error } = await supabase
      .from("posts")
      .insert({
        content: content || "",
        user_id: user.id,
        image_url: pendingImageUrl,
        file_url: pendingFileUrl,
        file_name: pendingFileName,
      })
      .select("id, user_id, content, created_at, image_url, file_url, file_name")
      .single();
    if (error) { console.error(error); postBtn.disabled = false; postBtn.textContent = "Post"; return; }
    // Prepend to feed
    const { data: author } = await supabase
      .from("profiles")
      .select("id, username, display_name, avatar_url")
      .eq("id", data.user_id)
      .single();
    const av = author?.avatar_url ? supabase.storage.from("avatars").getPublicUrl(author.avatar_url).data.publicUrl : null;
    const mediaHtml = data.image_url ? `<img src="${data.image_url}" class="post-image" alt="" loading="lazy" />` : "";
    const fileHtml = data.file_url ? `<a href="${data.file_url}" target="_blank" class="post-attach-link"><span class="material-symbols-outlined">description</span> ${data.file_name || "Attachment"}</a>` : "";
    const article = document.createElement("article");
    article.className = "feed-post";
    article.innerHTML = `
      <div class="post-header">
        <div class="post-author">
          <div class="post-avatar">${av ? `<img src="${av}" alt="" class="post-avatar-img" />` : '<span class="material-symbols-outlined">account_circle</span>'}</div>
          <div class="post-author-info">
            <strong class="post-author-name">${author?.display_name || author?.username || "You"}</strong>
            <span class="post-author-meta">just now</span>
          </div>
        </div>
        <button class="post-menu-btn post-delete-btn" data-post-id="${data.id}" aria-label="Delete post"><span class="material-symbols-outlined">delete</span></button>
      </div>
      <div class="post-body">
        ${data.content ? `<p class="post-text">${data.content.replace(/</g, "&lt;")}</p>` : ""}
        ${mediaHtml}
        ${fileHtml}
      </div>
      <div class="post-actions">
        <button class="post-action-btn post-like-btn" data-post-id="${data.id}" data-liked="false">
          <span class="material-symbols-outlined post-like-icon">favorite_border</span>
          <span class="post-like-count">0</span>
        </button>
      </div>
    `;
    article.querySelector(".post-delete-btn")?.addEventListener("click", deletePost);
    feedPosts?.prepend(article);
    // Remove empty state if present
    const empty = feedPosts?.querySelector(".feed-empty");
    if (empty) empty.remove();
    composerTextarea.value = "";
    pendingImageUrl = "";
    pendingFileUrl = "";
    pendingFileName = "";
    composerPreview.style.display = "none";
    composerPreview.innerHTML = "";
    imageInput.value = "";
    fileInput.value = "";
    overlay?.classList.remove("open");
    postBtn.disabled = false;
    postBtn.textContent = "Post";
  });

  // Delete post
  async function deletePost(e) {
    const btn = e.currentTarget;
    const postId = btn.dataset.postId;
    if (!confirm("Delete this post?")) return;
    const { error } = await supabase.from("posts").delete().eq("id", postId);
    if (error) { console.error(error); return; }
    const article = btn.closest(".feed-post");
    article?.remove();
    // Show empty state if no posts left
    if (feedPosts && !feedPosts.querySelector(".feed-post")) {
      feedPosts.innerHTML = '<p class="feed-empty">No posts yet. Be the first to share your findings!</p>';
    }
  }

  document.querySelectorAll(".post-delete-btn").forEach((btn) => {
    btn.addEventListener("click", deletePost);
  });

  // Like / unlike (event delegation)
  document.getElementById("feed-posts")?.addEventListener("click", async (e) => {
    const btn = e.target.closest(".post-like-btn");
    if (!btn) return;
    const postId = btn.dataset.postId;
    const liked = btn.dataset.liked === "true";
    const icon = btn.querySelector(".post-like-icon");
    const countEl = btn.querySelector(".post-like-count");
    const supabase = createBrowserClient(
      import.meta.env.PUBLIC_SUPABASE_URL,
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY
    );
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) return;
    if (liked) {
      const { error } = await supabase.from("post_likes").delete().eq("post_id", postId).eq("user_id", user.id);
      if (error) { console.error(error); return; }
      btn.dataset.liked = "false";
      if (icon) icon.textContent = "favorite_border";
      if (countEl) countEl.textContent = Math.max(0, parseInt(countEl.textContent) - 1);
    } else {
      const { error } = await supabase.from("post_likes").insert({ post_id: postId, user_id: user.id });
      if (error) { console.error(error); return; }
      btn.dataset.liked = "true";
      if (icon) icon.textContent = "favorite";
      if (countEl) countEl.textContent = parseInt(countEl.textContent) + 1;
    }
  });
</script>

