---
import BaseLayout from "../layouts/BaseLayout.astro";
import { createClient } from "../lib/supabase";

const loginPrefill = Astro.url.searchParams.get("login") ?? Astro.url.searchParams.get("email");

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const login = formData.get("login")?.toString() ?? "";
  const password = formData.get("password")?.toString() ?? "";

  const supabase = createClient({ request: Astro.request, cookies: Astro.cookies });

  let email = login;
  if (!login.includes("@")) {
    const { data: emailResult } = await supabase.rpc("lookup_username_email", { p_username: login });

    if (!emailResult) {
      return Astro.redirect(`/login?error=${encodeURIComponent("Invalid username or password")}&login=${encodeURIComponent(login)}`);
    }
    email = emailResult;
  }

  const { error } = await supabase.auth.signInWithPassword({ email, password });

  if (error) {
    return Astro.redirect(`/login?error=${encodeURIComponent(error.message)}&login=${encodeURIComponent(login)}`);
  }

  const { data: { user } } = await supabase.auth.getUser();
  if (user) {
    const { data: profile } = await supabase
      .from("profiles")
      .select("is_admin")
      .eq("id", user.id)
      .single();
    if (profile?.is_admin) {
      return Astro.redirect("/admin");
    }
  }

  return Astro.redirect("/dashboard/feed");
}

const errorParam = Astro.url.searchParams.get("error");
---

<BaseLayout title="Login">
  <div class="auth-page">
    <div class="auth-card">
      <div class="auth-card-inner">
        <h1>Welcome Back</h1>
        <p class="auth-subtitle">Sign in to Science Orbit</p>
        <form method="POST" class="auth-form">
          <div class="form-group">
            <label for="login">Email or Username</label>
            <input type="text" id="login" name="login" required placeholder="you@example.com or username" value={loginPrefill ?? ""} />
          </div>
          <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" required placeholder="Your password" />
          </div>
          {errorParam && <p class="error-msg">{errorParam}</p>}
          <button type="submit" class="btn-primary">Sign In</button>
        </form>
        <p class="auth-footer">
          Don't have an account? <a href="/register">Register here</a>
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .auth-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 2rem;
    background: var(--color-neu-base);
  }

  .auth-card {
    width: 100%;
    max-width: 420px;
    padding: 2px;
  }

  .auth-card-inner {
    background: var(--color-surface-container-low);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    box-shadow: var(--shadow-extruded);
  }

  .auth-card h1 {
    font-family: var(--font-headline);
    font-size: 1.75rem;
    margin-bottom: 0.25rem;
    color: var(--color-on-surface);
  }

  .auth-subtitle {
    color: var(--color-on-surface-variant);
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-group label {
    font-family: var(--font-label);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-on-surface-variant);
  }

  .form-group input {
    padding: 0.75rem 1rem;
    border: none;
    border-radius: var(--radius-default);
    font-size: 0.95rem;
    outline: none;
    background: var(--color-neu-base);
    box-shadow: var(--shadow-recessed);
    transition: box-shadow 0.15s;
  }

  .form-group input:focus {
    box-shadow: var(--shadow-recessed), 0 0 0 2px var(--color-primary-container);
  }

  .form-group input::placeholder {
    color: var(--color-outline);
  }

  .error-msg {
    color: var(--color-error);
    font-size: 0.85rem;
    min-height: 1.25rem;
  }

  .btn-primary {
    background: var(--color-neu-base);
    color: var(--color-primary);
    padding: 0.75rem;
    border: none;
    border-radius: var(--radius-default);
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 1rem;
    box-shadow: var(--shadow-extruded);
    transition: all 0.15s;
    letter-spacing: 0.02em;
  }

  .btn-primary:hover:not(:disabled) {
    box-shadow: var(--shadow-extruded-hover);
    color: var(--color-primary);
  }

  .btn-primary:active:not(:disabled) {
    box-shadow: var(--shadow-recessed);
  }

  .btn-primary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .auth-footer {
    margin-top: 1.5rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--color-on-surface-variant);
  }
</style>
