{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/admin/campuses/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/admin/dashboard/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/admin/events-dispatcher/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/admin/feed-governance/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/admin/identity-manager/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/admin/students/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/admin/subjects/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/admin/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/dashboard/edit/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/dashboard/events/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/dashboard/feed/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/dashboard/settings/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/dashboard/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/login/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/p/([^/]+?)/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/register/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}