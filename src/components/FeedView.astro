---
import type { Database } from "../types/database";

export interface Props {
  profile: any;
  sessionUser: any;
  avatarUrl: string | null;
  newUsers: any[];
  postsWithAuthors: any[];
  likeCountMap: Map<string, number>;
  likedPosts: Set<string>;
}

const { profile, sessionUser, avatarUrl, newUsers, postsWithAuthors, likeCountMap, likedPosts } = Astro.props;

function getTimeAgo(dateStr: string | null): string {
  if (!dateStr) return "";
  const now = new Date();
  const d = new Date(dateStr);
  const diff = Math.floor((now.getTime() - d.getTime()) / 1000);
  if (diff < 60) return "just now";
  if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
  if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
  if (diff < 2592000) return `${Math.floor(diff / 86400)}d ago`;
  return d.toLocaleDateString("en-US", { month: "short", day: "numeric" });
}
---

<div id="feed-panel" class="sv-panel sv-panel--active">
  <div class="sv-feed-root">
    <main class="sv-feed-main">
      <div class="sv-feed-content">
        {!profile ? (
          <div class="sv-guest-banner">
            <span class="material-symbols-outlined sv-guest-icon">visibility</span>
            <span>You're browsing as a guest. <a href="/login" class="sv-guest-link">Sign in</a> or <a href="/register" class="sv-guest-link">Register</a> to join.</span>
          </div>
        ) : null}

        <div class="sv-top-search-wrap">
          <span class="material-symbols-outlined sv-top-search-icon">search</span>
          <input class="sv-top-search-input" type="text" id="sv-top-search" placeholder="Search scholars and posts..." autocomplete="off" />
          <button class="sv-top-search-clear" id="sv-top-search-clear" aria-label="Clear">
            <span class="material-symbols-outlined">close</span>
          </button>
          <button class="sv-feed-refresh-btn" id="sv-feed-refresh" aria-label="Refresh feed">
            <span class="material-symbols-outlined">refresh</span>
          </button>
          <div class="sv-top-search-dropdown" id="sv-top-search-dropdown"></div>
        </div>

        <div class="sv-feed-newusers">
          <div class="sv-feed-newusers-label">New Members</div>
          <div class="sv-feed-newusers-list">
            {newUsers.map((u: any) => {
              const uAvatar = u.avatar_url ? `https://${import.meta.env.PUBLIC_SUPABASE_URL!.replace("https://", "")}/storage/v1/object/public/avatars/${u.avatar_url}` : null;
              return (
                <a href={`/dashboard?user=${u.id}`} class="sv-feed-newuser-item" title={u.display_name || u.username}>
                  {uAvatar ? (
                    <img src={uAvatar} alt="" class="sv-feed-newuser-avatar" />
                  ) : (
                    <div class="sv-feed-newuser-avatar sv-feed-newuser-placeholder">
                      <span class="material-symbols-outlined">person</span>
                    </div>
                  )}
                  <span class="sv-feed-newuser-name">{u.display_name || u.username}</span>
                </a>
              );
            })}
          </div>
        </div>

        {profile ? (
        <div class="sv-composer-overlay" id="sv-composer-overlay">
          <div class="sv-composer-modal">
            <div class="sv-composer-header">
              <h3>Create Post</h3>
              <button class="sv-composer-close" id="sv-composer-close" aria-label="Close">
                <span class="material-symbols-outlined">close</span>
              </button>
            </div>
            <div class="sv-post-composer">
              <div class="sv-composer-avatar">
                {avatarUrl ? (
                  <img src={avatarUrl} alt="" class="sv-composer-avatar-img" />
                ) : (
                  <div class="sv-composer-avatar-placeholder">
                    <span class="material-symbols-outlined">person</span>
                  </div>
                )}
              </div>
              <div class="sv-composer-input-area">
                <input class="sv-composer-input sv-composer-title-input" type="text" id="sv-composer-title" placeholder="Post title..." />
                <textarea class="sv-composer-input sv-composer-textarea" placeholder="Share your latest findings..." rows="4"></textarea>
                <div class="sv-composer-preview" id="sv-composer-preview" style="display:none"></div>
              </div>
              <div class="sv-composer-actions">
                <button class="sv-composer-action-btn" id="sv-composer-image-btn" aria-label="Add image">
                  <span class="material-symbols-outlined">image</span>
                </button>
                <input type="file" id="sv-composer-image-input" accept="image/*" style="display:none" />
                <button class="sv-composer-action-btn" id="sv-composer-attach-btn" aria-label="Attach file">
                  <span class="material-symbols-outlined">attach_file</span>
                </button>
                <input type="file" id="sv-composer-file-input" style="display:none" />
                <button class="sv-composer-post-btn" id="sv-composer-post-btn">Post</button>
              </div>
            </div>
          </div>
        </div>
        ) : null}

        <div class="sv-profile-overlay" id="sv-profile-overlay">
          <div class="sv-profile-modal">
            <div class="sv-profile-modal-header">
              <h3>Scholar Profile</h3>
              <button class="sv-profile-close" id="sv-profile-close" aria-label="Close">
                <span class="material-symbols-outlined">close</span>
              </button>
            </div>
            <div class="sv-profile-modal-body" id="sv-profile-modal-body"></div>
          </div>
        </div>

        {profile ? (
        <button class="sv-fab" id="sv-fab-add" aria-label="Create post">
          <span class="material-symbols-outlined">add</span>
        </button>
        ) : null}

        <div class="sv-feed-posts" id="sv-feed-posts">
          {postsWithAuthors.length === 0 && (
            <p class="sv-feed-empty">No posts yet. Be the first to share your findings!</p>
          )}
          {postsWithAuthors.map((post: any) => {
            const author = post.author;
            const authorAvatar = author?.avatar_url
              ? `https://${import.meta.env.PUBLIC_SUPABASE_URL!.replace("https://", "")}/storage/v1/object/public/avatars/${author.avatar_url}`
              : null;
            const timeAgo = getTimeAgo(post.created_at);
            return (
            <article class="sv-feed-post" data-post-id={post.id}>
              <div class="sv-post-header">
                <a href={`/dashboard?user=${post.user_id}`} class="sv-post-author">
                  <div class="sv-post-avatar">
                    {authorAvatar ? (
                      <img src={authorAvatar} alt="" class="sv-post-avatar-img" />
                    ) : (
                      <span class="material-symbols-outlined">account_circle</span>
                    )}
                  </div>
                  <div class="sv-post-author-info">
                    <strong class="sv-post-author-name">{author?.display_name || author?.username || "Unknown"}</strong>
                    <span class="sv-post-author-meta">{timeAgo}</span>
                  </div>
                </a>
                {profile && post.user_id === profile.id && (
                  <button class="sv-post-menu-btn sv-post-delete-btn" data-post-id={post.id} aria-label="Delete post">
                    <span class="material-symbols-outlined">delete</span>
                  </button>
                )}
              </div>
              <div class="sv-post-body">
                {post.title ? <h4 class="sv-post-title">{post.title}</h4> : null}
                {post.content ? <p class="sv-post-text">{post.content}</p> : null}
                {post.content ? <button class="sv-post-seemore" style="display:none">See more</button> : null}
                {post.image_url ? <img src={post.image_url} class="sv-post-image" alt="" loading="lazy" /> : null}
                {post.file_url ? <a href={post.file_url} target="_blank" class="sv-post-attach-link"><span class="material-symbols-outlined">description</span> {post.file_name || "Attachment"}</a> : null}
              </div>
              <div class="sv-post-actions">
                <button class="sv-post-action-btn sv-post-like-btn" data-post-id={post.id} data-liked={likedPosts.has(post.id) ? "true" : "false"}>
                  <span class="material-symbols-outlined sv-post-like-icon">{likedPosts.has(post.id) ? "favorite" : "favorite_border"}</span>
                  <span class="sv-post-like-count">{likeCountMap.get(post.id) || 0}</span>
                </button>
                <button class="sv-post-action-btn sv-post-share-btn" data-post-url={`${Astro.url.origin}/dashboard?user=${post.user_id}`} aria-label="Share post">
                  <span class="material-symbols-outlined">share</span>
                </button>
              </div>
            </article>
            );
          })}
        </div>
      </div>
    </main>
  </div>
</div>
