---
export interface Props {
  profile: any;
  events: any[];
  registeredIds: Set<string>;
  featuredEvent: any;
  upNextEvents: any[];
  gridEvents: any[];
  myCalendarEvents: any[];
  pastEvents: any[];
  liveEvent: any;
}
const { profile, events, registeredIds, featuredEvent, upNextEvents, gridEvents, myCalendarEvents, pastEvents, liveEvent } = Astro.props;
---

<div id="events-panel" class="sv-panel">
  <div class="sv-ev-root">
    <main class="sv-ev-main">
      <div class="sv-ev-content">
        <div class="sv-ev-header">
          <h1 class="sv-ev-title">Events & Webinars</h1>
          <p class="sv-ev-subtitle">Discover academic conferences, symposiums, and digital lectures.</p>
        </div>

        <div class="sv-ev-tabs">
          <button class="sv-ev-tab active" data-tab="all">All Events</button>
          {profile && <button class="sv-ev-tab" data-tab="calendar">My Calendar</button>}
          <button class="sv-ev-tab" data-tab="past">Past Webinars</button>
        </div>

        <div id="sv-ev-view-all">
          {featuredEvent && (
          <div class="sv-ev-featured-section">
            <div class="sv-ev-featured-card">
              {featuredEvent.is_live && <div class="sv-ev-featured-badge">Live Now</div>}
              <div class="sv-ev-featured-top">
                <button class="sv-ev-bookmark-btn" data-event-id={featuredEvent.id} aria-label="Bookmark">
                  <span class="material-symbols-outlined">{registeredIds.has(featuredEvent.id) ? "bookmark" : "bookmark_border"}</span>
                </button>
              </div>
              <div class="sv-ev-featured-date">
                <span class="material-symbols-outlined sv-ev-date-icon">event</span>
                {new Date(featuredEvent.event_date).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
                <span class="material-symbols-outlined sv-ev-date-icon">schedule</span>
                {new Date(featuredEvent.event_date).toLocaleTimeString("en-US", { hour: "2-digit", minute: "2-digit" })} UTC
              </div>
              <h2 class="sv-ev-featured-title">{featuredEvent.title}</h2>
              <p class="sv-ev-featured-desc">{featuredEvent.description}</p>
              <button class="sv-ev-join-btn sv-ev-reg-btn" data-event-id={featuredEvent.id}>
                {registeredIds.has(featuredEvent.id) ? "Registered" : "Register"}
                <span class="material-symbols-outlined">arrow_forward</span>
              </button>
            </div>

            {upNextEvents.length > 0 && (
            <aside class="sv-ev-upnext">
              <div class="sv-ev-upnext-header">
                <span>Up Next</span>
              </div>
              <div class="sv-ev-upnext-list">
                {upNextEvents.map((e: any) => (
                <div class="sv-ev-upnext-item">
                  <div class="sv-ev-upnext-time">
                    {new Date(e.event_date).toLocaleDateString("en-US", { month: "short", day: "numeric" })}, {new Date(e.event_date).toLocaleTimeString("en-US", { hour: "2-digit", minute: "2-digit" })}
                  </div>
                  <div class="sv-ev-upnext-row">
                    <span class="material-symbols-outlined sv-ev-upnext-icon">{e.icon || "event"}</span>
                    <div>
                      <div class="sv-ev-upnext-name">{e.title}</div>
                      <div class="sv-ev-upnext-desc">{e.category}</div>
                    </div>
                  </div>
                </div>
                ))}
              </div>
            </aside>
            )}
          </div>
          )}

          <div class="sv-ev-grid" id="sv-ev-grid">
            {gridEvents.length === 0 && !featuredEvent && (
              <p class="sv-ev-empty">No upcoming events at this time.</p>
            )}
            {gridEvents.map((e: any) => (
            <article class="sv-ev-card" data-event-id={e.id}>
              <div class={`sv-ev-card-icon sv-ev-card-icon-${e.category?.toLowerCase().slice(0, 5) || "general"}`}>
                <span class="material-symbols-outlined">{e.icon || "event"}</span>
              </div>
              <div class="sv-ev-card-category">{e.category}</div>
              <div class="sv-ev-card-date">{new Date(e.event_date).toLocaleDateString("en-US", { month: "short", day: "numeric" })}</div>
              <h3 class="sv-ev-card-title">{e.title}</h3>
              <p class="sv-ev-card-desc">{e.description}</p>
              <button class="sv-ev-register-btn sv-ev-reg-btn" data-event-id={e.id}>
                {registeredIds.has(e.id) ? "Unregister" : "Register"}
              </button>
            </article>
            ))}
          </div>
        </div>

        <div id="sv-ev-view-calendar" style="display:none">
          {myCalendarEvents.length === 0 ? (
            <p class="sv-ev-empty">You haven't registered for any upcoming events yet.</p>
          ) : (
            <div class="sv-ev-grid">
              {myCalendarEvents.map((e: any) => (
              <article class="sv-ev-card" data-event-id={e.id}>
                <div class={`sv-ev-card-icon sv-ev-card-icon-${e.category?.toLowerCase().slice(0, 5) || "general"}`}>
                  <span class="material-symbols-outlined">{e.icon || "event"}</span>
                </div>
                <div class="sv-ev-card-category">{e.category}</div>
                <div class="sv-ev-card-date">{new Date(e.event_date).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</div>
                <h3 class="sv-ev-card-title">{e.title}</h3>
                <p class="sv-ev-card-desc">{e.description}</p>
                <button class="sv-ev-register-btn sv-ev-reg-btn" data-event-id={e.id}>Unregister</button>
              </article>
              ))}
            </div>
          )}
        </div>

        <div id="sv-ev-view-past" style="display:none">
          {pastEvents.length === 0 ? (
            <p class="sv-ev-empty">No past events yet.</p>
          ) : (
            <div class="sv-ev-grid">
              {pastEvents.map((e: any) => (
              <article class="sv-ev-card sv-ev-card-past" data-event-id={e.id}>
                <div class={`sv-ev-card-icon sv-ev-card-icon-${e.category?.toLowerCase().slice(0, 5) || "general"}`}>
                  <span class="material-symbols-outlined">{e.icon || "event"}</span>
                </div>
                <div class="sv-ev-card-category">{e.category}</div>
                <div class="sv-ev-card-date">{new Date(e.event_date).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</div>
                <h3 class="sv-ev-card-title">{e.title}</h3>
                <p class="sv-ev-card-desc">{e.description}</p>
                <div class="sv-ev-past-badge">Completed</div>
              </article>
              ))}
            </div>
          )}
        </div>
      </div>
    </main>
  </div>
</div>
