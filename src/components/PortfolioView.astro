---
export interface Props {
  profile: any;
  isOwner: boolean;
  isApproved: boolean;
  avatarUrl: string | null;
  dastharUrl: string | null;
  campusName: string;
  mentorName: string;
  portfolioUrl: string;
  projectTitle: string;
  projectDescription: string;
  projectProgress: number;
  githubHandle: string;
  linkedinUrl: string;
  academicTier: string;
  courseName: string;
  jobTitle: string;
  organisation: string;
  isAlumni: boolean;
  techStack: string[];
  repoUrl: string;
  deployUrl: string;
  milestones: { title: string; issuer: string; url: string }[];
  socialLinks: { platform: string; value: string }[];
  legacyAchievements: string[];
  userPosts: any[];
  portfolioLikeMap: Map<string, number>;
  portfolioLikedPosts: Set<string>;
}

const {
  profile, isOwner, isApproved, avatarUrl, dastharUrl, campusName, mentorName, portfolioUrl,
  projectTitle, projectDescription, projectProgress, githubHandle, linkedinUrl,
  academicTier, courseName, jobTitle, organisation, isAlumni, techStack,
  repoUrl, deployUrl, milestones, socialLinks, legacyAchievements,
  userPosts, portfolioLikeMap, portfolioLikedPosts,
} = Astro.props;

function getTimeAgo(dateStr: string): string {
  const now = new Date();
  const d = new Date(dateStr);
  const diff = Math.floor((now.getTime() - d.getTime()) / 1000);
  if (diff < 60) return "just now";
  if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
  if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
  if (diff < 2592000) return `${Math.floor(diff / 86400)}d ago`;
  return d.toLocaleDateString("en-US", { month: "short", day: "numeric" });
}

const platformConfig: Record<string, { icon: string; urlPrefix: string }> = {
  GitHub: { icon: "github", urlPrefix: "https://github.com/" },
  LinkedIn: { icon: "linkedin", urlPrefix: "" },
  "X / Twitter": { icon: "x", urlPrefix: "https://x.com/" },
  Instagram: { icon: "instagram", urlPrefix: "https://instagram.com/" },
  YouTube: { icon: "youtube", urlPrefix: "https://youtube.com/@" },
  Discord: { icon: "discord", urlPrefix: "" },
  TikTok: { icon: "tiktok", urlPrefix: "https://tiktok.com/@" },
  Snapchat: { icon: "snapchat", urlPrefix: "https://snapchat.com/add/" },
  Facebook: { icon: "facebook", urlPrefix: "https://facebook.com/" },
  Reddit: { icon: "reddit", urlPrefix: "https://reddit.com/u/" },
  Threads: { icon: "threads", urlPrefix: "https://threads.net/@" },
  Bluesky: { icon: "bluesky", urlPrefix: "https://bsky.app/profile/" },
  Medium: { icon: "medium", urlPrefix: "https://medium.com/@" },
  "Stack Overflow": { icon: "stackoverflow", urlPrefix: "https://stackoverflow.com/users/" },
  ResearchGate: { icon: "researchgate", urlPrefix: "https://researchgate.net/profile/" },
  "Google Scholar": { icon: "googlescholar", urlPrefix: "https://scholar.google.com/citations?user=" },
  ORCID: { icon: "orcid", urlPrefix: "https://orcid.org/" },
};

function getSocialUrl(platform: string, value: string): string {
  const cfg = platformConfig[platform];
  if (!cfg) return value;
  if (value.startsWith("http://") || value.startsWith("https://")) return value;
  return cfg.urlPrefix + value;
}

function platformLogo(platform: string): string {
  const svgAttrs = 'class="sv-social-icon" viewBox="0 0 24 24" fill="currentColor"';
  const svgs: Record<string, string> = {
    GitHub: `<svg ${svgAttrs}><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>`,
    LinkedIn: `<svg ${svgAttrs}><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
    "X / Twitter": `<svg ${svgAttrs}><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
    Instagram: `<svg ${svgAttrs}><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>`,
    YouTube: `<svg ${svgAttrs}><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`,
  };
  return svgs[platform] || "";
}
---

<div id="portfolio-panel" class="sv-panel">
  <div class="sv-pp-root">
    <main class="sv-pp-main">
      <div class="sv-pp-container">
        <div class="sv-pp-left">
          <div class="sv-pp-card sv-pp-hero-card">
            <div class="sv-pp-hero-inner">
              <div class="sv-pp-hero-avatars">
                {dastharUrl ? (
                  <img src={dastharUrl} alt={profile?.display_name} class="sv-pp-dasthar" />
                ) : avatarUrl ? (
                  <img src={avatarUrl} alt={profile?.display_name} class="sv-pp-avatar" />
                ) : (
                  <div class="sv-pp-avatar sv-pp-avatar-placeholder">
                    <span class="material-symbols-outlined">person</span>
                  </div>
                )}
              </div>
              <div class="sv-pp-hero-body">
                <h1 class="sv-pp-name">{profile?.legal_name || profile?.display_name || profile?.username}</h1>
                {profile?.so_id && <code class="sv-pp-so-id">{profile.so_id}</code>}
                <div class="sv-pp-meta">
                  {profile?.father_name && (
                    <span class="sv-pp-meta-item">
                      <span class="material-symbols-outlined sv-pp-meta-icon">family_history</span>
                      {profile.father_name}
                    </span>
                  )}
                  <span class="sv-pp-meta-item">
                    <span class="material-symbols-outlined sv-pp-meta-icon">location_on</span>
                    {campusName || "Not affiliated"}
                  </span>
                  {mentorName && (
                    <span class="sv-pp-meta-item">
                      <span class="material-symbols-outlined sv-pp-meta-icon">school</span>
                      Assigned Mentor: {mentorName}
                    </span>
                  )}
                </div>
                {academicTier && <span class="sv-pp-tier-badge">{academicTier}</span>}
                {isAlumni && (
                  <div class="sv-pp-alumni-block">
                    <span class="sv-pp-alumni-badge">Alumni</span>
                    <span class="sv-pp-alumni-detail">{jobTitle} &middot; {organisation}</span>
                  </div>
                )}
                {courseName && academicTier && ["UG","PG","PHD"].includes(academicTier) && (
                  <p class="sv-pp-course-name">{courseName}</p>
                )}
                {profile?.subjects && profile.subjects.length > 0 && (
                  <div class="sv-pp-chips-wrap">
                    {profile.subjects.map((s: string) => (
                      <span class="sv-pp-chip">{s}</span>
                    ))}
                  </div>
                )}
                {techStack.length > 0 && (
                  <div class="sv-pp-chips-wrap sv-pp-tech-wrap">
                    {techStack.map((t: string) => (
                      <span class="sv-pp-chip sv-pp-tech-chip">{t}</span>
                    ))}
                  </div>
                )}
                {profile?.biography && profile.biography.trim() && (
                  <div class="sv-pp-bio-summary">
                    <p class="sv-pp-bio-summary-text">{profile.biography}</p>
                  </div>
                )}
              </div>
            </div>
          </div>

          {isOwner && !isApproved && (
            <div class="sv-pp-card sv-pp-pending-banner">
              <span class="material-symbols-outlined">verified_user</span>
              <div>
                <strong>Verifying your account</strong>
                <p>Your profile is being verified. An admin will approve your account shortly.</p>
              </div>
            </div>
          )}

          <nav class="sv-pp-mobile-tabs" id="sv-mobile-tabs">
            <button class="sv-pp-mtab active" data-tab="posts">Posts</button>
            <button class="sv-pp-mtab" data-tab="achievements">Achievements</button>
            {(socialLinks.length > 0 || isOwner) && <button class="sv-pp-mtab" data-tab="connect">Connect</button>}
            {projectTitle && <button class="sv-pp-mtab" data-tab="project">Project</button>}
          </nav>

          <div class="sv-pp-tab-panel sv-pp-tab-panel--active" data-tab="posts">
            {userPosts && userPosts.length > 0 ? (
              <div class="sv-pp-card sv-pp-posts-card">
                <h2 class="sv-pp-section-title">
                  <span class="material-symbols-outlined sv-pp-section-icon">dynamic_feed</span>
                  Posts
                </h2>
                <div class="sv-pp-posts-list">
                  {userPosts.map((p: any) => (
                    <div class="sv-pp-post-item">
                      <div class="sv-pp-post-content">
                        {p.title ? <h4 class="sv-pp-post-title">{p.title}</h4> : null}
                        {p.content ? <p class="sv-pp-post-text">{p.content}</p> : null}
                        {p.content ? <button class="sv-pp-post-seemore" style="display:none">See more</button> : null}
                        {p.image_url ? <img src={p.image_url} class="sv-pp-post-image" alt="" loading="lazy" /> : null}
                        {p.file_url ? <a href={p.file_url} target="_blank" class="sv-pp-post-attach"><span class="material-symbols-outlined">description</span> {p.file_name || "Attachment"}</a> : null}
                      </div>
                      <div class="sv-pp-post-meta-row">
                        <span class="sv-pp-post-time">{getTimeAgo(p.created_at)}</span>
                        <button class="sv-pp-like-btn" data-post-id={p.id} data-liked={portfolioLikedPosts.has(p.id) ? "true" : "false"}>
                          <span class="material-symbols-outlined sv-pp-like-icon">{portfolioLikedPosts.has(p.id) ? "favorite" : "favorite_border"}</span>
                          <span class="sv-pp-like-count">{portfolioLikeMap.get(p.id) || 0}</span>
                        </button>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ) : (
              <div class="sv-pp-card">
                <p class="sv-pp-empty">No posts yet.</p>
              </div>
            )}
          </div>

          <div class="sv-pp-tab-panel" data-tab="achievements">
            {(milestones.length > 0 || legacyAchievements.length > 0 || isOwner) && (
              <div class="sv-pp-card">
                <h2 class="sv-pp-section-title">
                  <span class="material-symbols-outlined sv-pp-section-icon">emoji_events</span>
                  Verifiable Achievements
                </h2>
                <div class="sv-pp-milestones-list">
                  {milestones.length > 0 ? milestones.map((m) => (
                    <div class="sv-pp-milestone-row">
                      <div class="sv-pp-milestone-left">
                        <span class="material-symbols-outlined sv-pp-milestone-badge">verified</span>
                        <div>
                          <h4 class="sv-pp-milestone-title">{m.title}</h4>
                          {m.issuer && <p class="sv-pp-milestone-issuer">{m.issuer}</p>}
                        </div>
                      </div>
                      {m.url && (
                        <a href={m.url} target="_blank" class="sv-pp-milestone-link" title="Verify">
                          <span class="material-symbols-outlined">open_in_new</span>
                        </a>
                      )}
                    </div>
                  )) : legacyAchievements.map((ach) => (
                    <div class="sv-pp-milestone-row">
                      <div class="sv-pp-milestone-left">
                        <span class="material-symbols-outlined sv-pp-milestone-badge">verified</span>
                        <div>
                          <h4 class="sv-pp-milestone-title">{ach}</h4>
                        </div>
                      </div>
                    </div>
                  ))}
                  {milestones.length === 0 && legacyAchievements.length === 0 && (
                    <p class="sv-pp-empty">No achievements added yet.</p>
                  )}
                </div>
              </div>
            )}
          </div>

          <div class="sv-pp-tab-panel" data-tab="connect">
            <div class="sv-pp-card sv-pp-connect-card">
              <div class="sv-pp-connect-header">
                <h3 class="sv-pp-connect-title">Connect</h3>
                {profile?.phone && <a href={`tel:${profile.phone}`} class="sv-pp-phone-link"><span class="material-symbols-outlined">call</span> {profile.phone}</a>}
              </div>
              <div class="sv-pp-social-row" set:html={socialLinks.map((sl) => {
                const href = getSocialUrl(sl.platform, sl.value);
                return `<a href="${href}" target="_blank" class="sv-pp-social-btn" title="${sl.platform}">${platformLogo(sl.platform)}</a>`;
              }).join("")} />
              {isOwner && (
                <>
                  <a href="/dashboard/edit" class="sv-pp-action-btn">Edit Portfolio</a>
                  <button class="sv-pp-action-btn sv-pp-action-secondary" id="sv-copy-portfolio-link" data-url={portfolioUrl}>
                    <span class="material-symbols-outlined" style="font-size:16px">link</span>
                    Copy Portfolio Link
                  </button>
                </>
              )}
            </div>
          </div>

          <div class="sv-pp-tab-panel" data-tab="project">
            {projectTitle ? (
              <div class="sv-pp-card">
                <span class="sv-pp-project-badge">Current Project</span>
                <div class="sv-pp-project-head">
                  <h4 class="sv-pp-project-name">{projectTitle}</h4>
                  <div class="sv-pp-project-links">
                    {repoUrl && (
                      <a href={repoUrl} target="_blank" class="sv-pp-project-link" title="Repository">
                        <svg class="sv-social-icon" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                        </svg>
                      </a>
                    )}
                    {deployUrl && (
                      <a href={deployUrl} target="_blank" class="sv-pp-project-link" title="Live Site">
                        <span class="material-symbols-outlined" style="font-size:16px">open_in_new</span>
                      </a>
                    )}
                  </div>
                </div>
                {projectDescription && <p class="sv-pp-project-desc">{projectDescription}</p>}
                <div class="sv-pp-progress-section">
                  <div class="sv-pp-progress-labels">
                    <span>Analysis Phase</span>
                    <span>{projectProgress}%</span>
                  </div>
                  <div class="sv-pp-progress-track">
                    <div class="sv-pp-progress-fill" style={`width:${projectProgress}%`}></div>
                  </div>
                </div>
              </div>
            ) : (
              <div class="sv-pp-card"><p class="sv-pp-empty">No current project.</p></div>
            )}
          </div>
        </div>
      </div>
    </main>
  </div>
</div>
