    Discord: `<svg ${svgAttrs}><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z"/></svg>`,
    TikTok: `<svg ${svgAttrs}><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>`,
    Snapchat: `<svg ${svgAttrs}><path d="M12.206.793c.99 0 4.792.327 6.413 4.86.482 1.349.32 2.965.163 4.21-.074.591-.148 1.181-.148 1.526 0 .424.245.603.564.774.327.175.689.36.995.58 1.072.766 1.516 1.764 1.329 2.58-.175.758-1.045 1.515-3.04 1.655-.3.022-.481.148-.573.364-.26.595-.79 1.167-1.856 1.416-1.393.326-2.371-.133-2.85-.406-.296-.169-.631-.338-.981-.338-.368 0-.694.176-.99.342-1.092.637-2.163.54-2.86.05-.446-.313-.835-.706-1.367-.626-.649.1-2.144.502-2.142 1.332 0 .75 2.09 1.193 2.647 1.352.86.245.78.54.582 1.15-.183.56-.48 1.15.399 1.421.436.136 1.48.025 2.07.273.315.131.536.532.648.874.177.54.246 1.18.787 1.617 1.074.867 2.225.467 3.107-.076.18-.11.414-.332.633-.332.22 0 .454.222.634.332.882.543 2.033.943 3.107.076.541-.437.61-1.078.787-1.617.112-.342.333-.743.648-.874.59-.248 1.634-.137 2.07-.273.879-.271.582-.861.399-1.42-.198-.611-.278-.906.582-1.151.557-.16 2.647-.601 2.647-1.352 0-.424-.245-.603-.564-.774a5.8 5.8 0 01-.995-.58c-.319-.171-.564-.35-.564-.774 0-.345.074-.935.148-1.526.163-1.245.319-2.861-.163-4.21-1.621-4.533-5.423-4.86-6.413-4.86z"/></svg>`,
    Facebook: `<svg ${svgAttrs}><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`,
  };
  return svgs[platform] || `<span class="pp-social-text">${platform.slice(0, 2).toUpperCase()}</span>`;
}

// Legacy achievements as fallback
const legacyAchievements: string[] = profile.achievements
  ? profile.achievements.split("\n").filter(Boolean)
  : [];

function getTimeAgo(dateStr: string): string {
  const now = new Date();
  const d = new Date(dateStr);
  const diff = Math.floor((now.getTime() - d.getTime()) / 1000);
  if (diff < 60) return "just now";
  if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
  if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
  if (diff < 2592000) return `${Math.floor(diff / 86400)}d ago`;
  return d.toLocaleDateString("en-US", { month: "short", day: "numeric" });
}
---

<div class="pp-root">
    <main class="pp-main">
      <div class="pp-container">
        <!-- Left Column -->
        <div class="pp-left">

          <!-- Profile Hero Card -->
          <div class="pp-card pp-hero-card">
            <button class="pp-share-btn" aria-label="Share profile" onclick="navigator.share?navigator.share({url:location.href}):navigator.clipboard.writeText(location.href).then(()=>this.querySelector('span').textContent='check').then(()=>setTimeout(()=>this.querySelector('span').textContent='share',2000))">
              <span class="material-symbols-outlined">share</span>
            </button>
            <div class="pp-hero-inner">
              <div class="pp-hero-avatars">
                {avatarUrl ? (
                  <img src={avatarUrl} alt={profile.display_name} class="pp-avatar" />
                ) : (
                  <div class="pp-avatar pp-avatar-placeholder">
                    <span class="material-symbols-outlined">person</span>
                  </div>
                )}
              </div>
              <div class="pp-hero-body">
                <h1 class="pp-name">{profile.legal_name || profile.display_name || profile.username}</h1>
                <div class="pp-badges">
                  {profile.so_id && <code class="pp-so-id">{profile.so_id}</code>}
                  {academicTier && <span class="pp-tier-badge">{academicTier}</span>}
                </div>
                <div class="pp-meta">
                  {profile.father_name && (
                    <span class="pp-meta-item">
                      <span class="material-symbols-outlined pp-meta-icon">family_history</span>
                      {profile.father_name}
                    </span>
                  )}
                  <span class="pp-meta-item">
                    <span class="material-symbols-outlined pp-meta-icon">location_on</span>
                    {campusName || "Not affiliated"}
                  </span>
                  {mentorName && (
                    <span class="pp-meta-item">
                      <span class="material-symbols-outlined pp-meta-icon">school</span>
                      Assigned Mentor: {mentorName}
                    </span>
                  )}
                </div>
                {isAlumni && (
                  <div class="pp-alumni-block">
                    <span class="pp-alumni-badge">Alumni</span>
                    <span class="pp-alumni-detail">{jobTitle} &middot; {organisation}</span>
                  </div>
                )}
                {courseName && academicTier && ["UG","PG","PHD"].includes(academicTier) && (
                  <p class="pp-course-name">{courseName}</p>
                )}
                {profile.biography && profile.biography.trim() && (
                  <div class="pp-bio-summary">
                    <p class="pp-bio-summary-text">{profile.biography}</p>
                  </div>
                )}
              </div>
            </div>
          </div>

          {isOwner && !isApproved && (
            <div class="pp-card pp-pending-banner">
              <span class="material-symbols-outlined">verified_user</span>
              <div>
                <strong>Verifying your account</strong>
                <p>Your profile is being verified. An admin will approve your account shortly.</p>
              </div>
            </div>
          )}

          <!-- Mobile Sub Nav -->
          <nav class="pp-mobile-tabs" id="mobile-tabs">
            <button class="pp-mtab active" data-tab="posts">Posts</button>
            <button class="pp-mtab" data-tab="achievements">Achievements</button>
            {(socialLinks.length > 0 || isOwner) && <button class="pp-mtab" data-tab="connect">Connect</button>}
          </nav>

          <!-- Tab Panels -->
          <div class="pp-tab-panel pp-tab-panel--active" data-tab="posts">
          <!-- Posts -->
          {userPosts && userPosts.length > 0 && (
            <div class="pp-card pp-posts-card">
              <h2 class="pp-section-title">
                <span class="material-symbols-outlined pp-section-icon">dynamic_feed</span>
                Posts
              </h2>
              <div class="pp-posts-list">
                {userPosts.map((p) => (
                    <div class="pp-post-item">
                      <div class="pp-post-content">
                        {p.title ? <h4 class="pp-post-title">{p.title}</h4> : null}
                        {p.content ? <p class="pp-post-text">{p.content}</p> : null}
                        {p.content ? <button class="pp-post-seemore" style="display:none">See more</button> : null}
                        {p.image_url ? <img src={p.image_url} class="pp-post-image" alt="" loading="lazy" /> : null}
                        {p.file_url ? <a href={p.file_url} target="_blank" class="pp-post-attach"><span class="material-symbols-outlined">description</span> {p.file_name || "Attachment"}</a> : null}
                      </div>
                      <div class="pp-post-meta-row">
                        <span class="pp-post-time">{getTimeAgo(p.created_at)}</span>
                        <button class="pp-like-btn" data-post-id={p.id} data-liked={portfolioLikedPosts.has(p.id) ? "true" : "false"}>
                          <span class="material-symbols-outlined pp-like-icon">{portfolioLikedPosts.has(p.id) ? "favorite" : "favorite_border"}</span>
                          <span class="pp-like-count">{portfolioLikeMap.get(p.id) || 0}</span>
                        </button>
                      </div>
                    </div>
                ))}
              </div>
            </div>
          )}
          {(!userPosts || userPosts.length === 0) && (
            <div class="pp-card">
              <p class="pp-empty">No posts yet.</p>
            </div>
          )}
          </div>

          <div class="pp-tab-panel" data-tab="achievements">
          <!-- Verifiable Achievements -->
          {(milestones.length > 0 || legacyAchievements.length > 0 || isOwner) && (
            <div class="pp-card">
              <h2 class="pp-section-title">
                <span class="material-symbols-outlined pp-section-icon">emoji_events</span>
                Verifiable Achievements
              </h2>
              <div class="pp-milestones-list">
                {milestones.length > 0 ? milestones.map((m) => (
                  <div class="pp-milestone-row">
                    <div class="pp-milestone-left">
                      <span class="material-symbols-outlined pp-milestone-badge">verified</span>
                      <h4 class="pp-milestone-title">{m.title}</h4>
                    </div>
                    {m.issuer && <span class="pp-milestone-campus-badge">{m.issuer}</span>}
                  </div>
                )) : legacyAchievements.map((ach) => (
                  <div class="pp-milestone-row">
                    <div class="pp-milestone-left">
                      <span class="material-symbols-outlined pp-milestone-badge">verified</span>
                      <div>
                        <h4 class="pp-milestone-title">{ach}</h4>
                      </div>
                    </div>
                  </div>
                ))}
                {milestones.length === 0 && legacyAchievements.length === 0 && (
                  <p class="pp-empty">No achievements added yet.</p>
                )}
              </div>
            </div>
          )}
          </div>
          <div class="pp-tab-panel" data-tab="connect">
            <div class="pp-card pp-connect-card">
              <div class="pp-connect-header">
                <h3 class="pp-connect-title">Connect</h3>
                {profile.phone && <a href={`tel:${profile.phone}`} class="pp-phone-link"><span class="material-symbols-outlined">call</span> {profile.phone}</a>}
              </div>
              <div class="pp-social-row" set:html={socialLinks.map((sl) => {
                const href = getSocialUrl(sl.platform, sl.value);
                const label = sl.platform;
                return `<a href="${href}" target="_blank" class="pp-social-btn" title="${label}">${platformLogo(sl.platform)}</a>`;
              }).join("")} />
              {isOwner && (
                <>
                  <a href="/dashboard/edit" class="pp-action-btn">Edit Portfolio</a>
                  <button class="pp-action-btn pp-action-secondary" id="copy-portfolio-link" data-url={portfolioUrl}>
                    <span class="material-symbols-outlined" style="font-size:16px">link</span>
                    Copy Portfolio Link
                  </button>
                </>
              )}
            </div>
          </div>

        </div>

        <!-- Right Column (desktop only) -->
        <div class="pp-right pp-desktop-only">
          <div class="pp-card pp-connect-card">
            <div class="pp-connect-header">
              <h3 class="pp-connect-title">Connect</h3>
              {profile.phone && <a href={`tel:${profile.phone}`} class="pp-phone-link"><span class="material-symbols-outlined">call</span> {profile.phone}</a>}
            </div>
            <div class="pp-social-row" set:html={socialLinks.map((sl) => {
              const href = getSocialUrl(sl.platform, sl.value);
              const label = sl.platform;
              return `<a href="${href}" target="_blank" class="pp-social-btn" title="${label}">${platformLogo(sl.platform)}</a>`;
            }).join("")} />
            {isOwner && (
              <>
                <a href="/dashboard/edit" class="pp-action-btn">Edit Portfolio</a>
                <button class="pp-action-btn pp-action-secondary" id="copy-portfolio-link" data-url={portfolioUrl}>
                  <span class="material-symbols-outlined" style="font-size:16px">link</span>
                  Copy Portfolio Link
                </button>
              </>
            )}
          </div>
        </div>
      </div>
    </main>
  </div>
<script>
  import { createBrowserClient } from "@supabase/ssr";

  // "See more" toggle for post content
  document.addEventListener("click", (e) => {
    const btn = e.target.closest(".pp-post-seemore");
    if (!btn) return;
    const text = btn.parentElement.querySelector(".pp-post-text");
    if (!text) return;
    text.classList.toggle("expanded");
    btn.textContent = text.classList.contains("expanded") ? "Show less" : "See more";
  });
  document.querySelectorAll(".pp-post-text").forEach((el) => {
    if (el.scrollHeight > el.clientHeight) {
      const btn = el.parentElement.querySelector(".pp-post-seemore");
      if (btn) btn.style.display = "";
    }
  });

  // Copy portfolio link
  const copyBtn = document.getElementById("copy-portfolio-link");
  copyBtn?.addEventListener("click", async () => {
    const url = copyBtn.getAttribute("data-url");
    if (!url) return;
    try {
      await navigator.clipboard.writeText(url);
      copyBtn.innerHTML = '<span class="material-symbols-outlined" style="font-size:16px">check</span> Copied!';
      setTimeout(() => {
        copyBtn.innerHTML = '<span class="material-symbols-outlined" style="font-size:16px">link</span> Copy Portfolio Link';
      }, 2000);
    } catch {
      const ta = document.createElement("textarea");
      ta.value = url;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      document.body.removeChild(ta);
    }
  });

  // Mobile tab switching
  const tabs = document.querySelectorAll(".pp-mtab");
  const panels = document.querySelectorAll(".pp-tab-panel");
  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const target = tab.dataset.tab;
      tabs.forEach((t) => t.classList.remove("active"));
      tab.classList.add("active");
      panels.forEach((p) => {
        p.classList.toggle("pp-tab-panel--active", p.dataset.tab === target);
      });
    });
  });

  // Like / unlike on portfolio
  document.querySelectorAll(".pp-like-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const postId = btn.dataset.postId;
      const liked = btn.dataset.liked === "true";
      const icon = btn.querySelector(".pp-like-icon");
      const countEl = btn.querySelector(".pp-like-count");
      const supabase = createBrowserClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY
      );
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) return;
      if (liked) {
        const { error } = await supabase.from("post_likes").delete().eq("post_id", postId).eq("user_id", user.id);
        if (error) { console.error(error); return; }
        btn.dataset.liked = "false";
        if (icon) icon.textContent = "favorite_border";
        if (countEl) countEl.textContent = Math.max(0, parseInt(countEl.textContent) - 1);
      } else {
        const { error } = await supabase.from("post_likes").insert({ post_id: postId, user_id: user.id });
        if (error) { console.error(error); return; }
        btn.dataset.liked = "true";
        if (icon) icon.textContent = "favorite";
        if (countEl) countEl.textContent = parseInt(countEl.textContent) + 1;
      }
    });
  });
</script>


