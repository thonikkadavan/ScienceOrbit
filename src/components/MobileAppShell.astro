---
import FeedView from "./FeedView.astro";
import PortfolioView from "./PortfolioView.astro";
import EventsView from "./EventsView.astro";
import type { Database } from "../types/database";

export interface Props {
  sessionUser: any;
  profile: any;
  avatarUrl: string | null;
  newUsers: any[];
  postsWithAuthors: any[];
  likeCountMap: Map<string, number>;
  likedPosts: Set<string>;
  isOwner: boolean;
  isApproved: boolean;
  dastharUrl: string | null;
  campusName: string;
  mentorName: string;
  portfolioUrl: string;
  projectTitle: string;
  projectDescription: string;
  projectProgress: number;
  githubHandle: string;
  linkedinUrl: string;
  academicTier: string;
  courseName: string;
  jobTitle: string;
  organisation: string;
  isAlumni: boolean;
  techStack: string[];
  repoUrl: string;
  deployUrl: string;
  milestones: { title: string; issuer: string; url: string }[];
  socialLinks: { platform: string; value: string }[];
  legacyAchievements: string[];
  userPosts: any[];
  portfolioLikeMap: Map<string, number>;
  portfolioLikedPosts: Set<string>;
  events: any[];
  registeredIds: Set<string>;
  featuredEvent: any;
  upNextEvents: any[];
  gridEvents: any[];
  myCalendarEvents: any[];
  pastEvents: any[];
  liveEvent: any;
}
---

<div class="sv-shell">
  <FeedView
    profile={Astro.props.profile}
    sessionUser={Astro.props.sessionUser}
    avatarUrl={Astro.props.avatarUrl}
    newUsers={Astro.props.newUsers}
    postsWithAuthors={Astro.props.postsWithAuthors}
    likeCountMap={Astro.props.likeCountMap}
    likedPosts={Astro.props.likedPosts}
  />
  <PortfolioView
    profile={Astro.props.profile}
    isOwner={Astro.props.isOwner}
    isApproved={Astro.props.isApproved}
    avatarUrl={Astro.props.avatarUrl}
    dastharUrl={Astro.props.dastharUrl}
    campusName={Astro.props.campusName}
    mentorName={Astro.props.mentorName}
    portfolioUrl={Astro.props.portfolioUrl}
    projectTitle={Astro.props.projectTitle}
    projectDescription={Astro.props.projectDescription}
    projectProgress={Astro.props.projectProgress}
    githubHandle={Astro.props.githubHandle}
    linkedinUrl={Astro.props.linkedinUrl}
    academicTier={Astro.props.academicTier}
    courseName={Astro.props.courseName}
    jobTitle={Astro.props.jobTitle}
    organisation={Astro.props.organisation}
    isAlumni={Astro.props.isAlumni}
    techStack={Astro.props.techStack}
    repoUrl={Astro.props.repoUrl}
    deployUrl={Astro.props.deployUrl}
    milestones={Astro.props.milestones}
    socialLinks={Astro.props.socialLinks}
    legacyAchievements={Astro.props.legacyAchievements}
    userPosts={Astro.props.userPosts}
    portfolioLikeMap={Astro.props.portfolioLikeMap}
    portfolioLikedPosts={Astro.props.portfolioLikedPosts}
  />
  <EventsView
    profile={Astro.props.profile}
    events={Astro.props.events}
    registeredIds={Astro.props.registeredIds}
    featuredEvent={Astro.props.featuredEvent}
    upNextEvents={Astro.props.upNextEvents}
    gridEvents={Astro.props.gridEvents}
    myCalendarEvents={Astro.props.myCalendarEvents}
    pastEvents={Astro.props.pastEvents}
    liveEvent={Astro.props.liveEvent}
  />

  <nav class="sv-bottom-nav">
    <button class="sv-bnav-item active" data-tab="feed">
      <span class="material-symbols-outlined">dynamic_feed</span>
      <span>Feed</span>
    </button>
    <button class="sv-bnav-item" data-tab="portfolio">
      <span class="material-symbols-outlined">account_circle</span>
      <span>Portfolio</span>
    </button>
    <button class="sv-bnav-item" data-tab="events">
      <span class="material-symbols-outlined">event</span>
      <span>Events</span>
    </button>
    <a href="/dashboard/settings" class="sv-bnav-item">
      <span class="material-symbols-outlined">settings</span>
      <span>Settings</span>
    </a>
  </nav>
</div>

<script>
import { createBrowserClient } from "@supabase/ssr";

const supabase = createBrowserClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

// ── Tab Router ──
window.switchTab = function (tabId) {
  document.querySelectorAll(".sv-panel").forEach((p) => {
    p.classList.toggle("sv-panel--active", p.id === tabId + "-panel");
  });
  document.querySelectorAll(".sv-bnav-item").forEach((b) => {
    b.classList.toggle("active", b.dataset.tab === tabId);
  });
};

document.addEventListener("click", (e) => {
  const navBtn = e.target.closest(".sv-bnav-item[data-tab]");
  if (navBtn) {
    e.preventDefault();
    window.switchTab(navBtn.dataset.tab);
  }
});

// ── Search ──
const searchInput = document.getElementById("sv-top-search");
const searchDropdown = document.getElementById("sv-top-search-dropdown");
const searchClear = document.getElementById("sv-top-search-clear");

if (searchInput) {
  let searchTimer;
  searchInput.addEventListener("input", () => {
    clearTimeout(searchTimer);
    const q = searchInput.value.trim();
    if (!q) { searchDropdown.innerHTML = ""; searchDropdown.classList.remove("active"); return; }
    searchTimer = setTimeout(async () => {
      const { data } = await supabase
        .from("profiles")
        .select("id, username, display_name, avatar_url, subjects, achievements, campuses(name)")
        .eq("is_approved", true)
        .or(`username.ilike.%${q}%,display_name.ilike.%${q}%,legal_name.ilike.%${q}%`)
        .limit(6);
      if (!data || data.length === 0) {
        searchDropdown.innerHTML = '<div class="sv-search-noresult">No results found</div>';
      } else {
        searchDropdown.innerHTML = data.map((u) => {
          const subj = Array.isArray(u.subjects) ? u.subjects.slice(0, 2).join(", ") : "";
          const campus = u.campuses?.name || "";
          return `<a href="/dashboard?user=${u.id}" class="sv-search-result-item">
            <div class="sv-search-result-avatar">${u.avatar_url ? `<img src="${supabase.storage.from("avatars").getPublicUrl(u.avatar_url).data.publicUrl}" />` : '<span class="material-symbols-outlined">person</span>'}</div>
            <div class="sv-search-result-info"><strong>${u.display_name || u.username}</strong>${campus ? `<span>${campus}</span>` : ""}${subj ? `<span>${subj}</span>` : ""}</div>
          </a>`;
        }).join("");
      }
      searchDropdown.classList.add("active");
    }, 300);
  });

  searchClear?.addEventListener("click", () => {
    if (searchInput) { searchInput.value = ""; searchInput.focus(); }
    if (searchDropdown) { searchDropdown.innerHTML = ""; searchDropdown.classList.remove("active"); }
  });
}

// ── Post Composer ──
const fabAdd = document.getElementById("sv-fab-add");
const composerOverlay = document.getElementById("sv-composer-overlay");
const composerClose = document.getElementById("sv-composer-close");
const composerImageBtn = document.getElementById("sv-composer-image-btn");
const composerImageInput = document.getElementById("sv-composer-image-input");
const composerAttachBtn = document.getElementById("sv-composer-attach-btn");
const composerFileInput = document.getElementById("sv-composer-file-input");
const composerPostBtn = document.getElementById("sv-composer-post-btn");
const composerTitle = document.getElementById("sv-composer-title");
const composerTextarea = document.querySelector(".sv-composer-textarea");
const composerPreview = document.getElementById("sv-composer-preview");

fabAdd?.addEventListener("click", () => { composerOverlay.style.display = "flex"; });
composerClose?.addEventListener("click", () => {
  composerOverlay.style.display = "none";
  const ta = composerTextarea; if (ta) ta.value = "";
  const ti = composerTitle; if (ti) ti.value = "";
  if (composerPreview) composerPreview.style.display = "none";
});
composerOverlay?.addEventListener("click", (e) => { if (e.target === composerOverlay) composerClose.click(); });

let composerImageDataUrl = null;
let composerFileInfo = null;

composerImageBtn?.addEventListener("click", () => composerImageInput?.click());
composerImageInput?.addEventListener("change", async (e) => {
  const file = e.target.files?.[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = (ev) => {
    composerImageDataUrl = ev.target.result;
    if (composerPreview) {
      composerPreview.innerHTML = `<img src="${composerImageDataUrl}" class="sv-composer-preview-img" />`;
      composerPreview.style.display = "block";
    }
  };
  reader.readAsDataURL(file);
});

composerAttachBtn?.addEventListener("click", () => composerFileInput?.click());
composerFileInput?.addEventListener("change", (e) => {
  composerFileInfo = e.target.files?.[0] || null;
  if (composerPreview && composerFileInfo) {
    composerPreview.innerHTML = `<span class="material-symbols-outlined">description</span> ${composerFileInfo.name}`;
    composerPreview.style.display = "block";
  }
});

composerPostBtn?.addEventListener("click", async () => {
  const title = composerTitle?.value.trim() || "";
  const content = composerTextarea?.value.trim() || "";
  if (!title && !content) return;
  const { data: { user } } = await supabase.auth.getUser();
  if (!user) return;
  let imageUrl = null;
  let fileUrl = null;
  let fileName = null;
  try {
    if (composerImageDataUrl) {
      const imgFile = await fetch(composerImageDataUrl).then((r) => r.blob());
      const ext = imgFile.type.split("/")[1] || "png";
      const imgPath = `${user.id}/${Date.now()}.${ext}`;
      const { data: imgData } = await supabase.storage.from("post_images").upload(imgPath, imgFile);
      if (imgData) imageUrl = supabase.storage.from("post_images").getPublicUrl(imgData.path).data.publicUrl;
    }
    if (composerFileInfo) {
      const fileExt = composerFileInfo.name.split(".").pop();
      const filePath = `${user.id}/${Date.now()}.${fileExt}`;
      const { data: fileData } = await supabase.storage.from("post_images").upload(filePath, composerFileInfo);
      if (fileData) {
        fileUrl = supabase.storage.from("post_images").getPublicUrl(fileData.path).data.publicUrl;
        fileName = composerFileInfo.name;
      }
    }
  } catch (err) { console.error(err); }
  const { error } = await supabase.from("posts").insert({
    title: title || null, content: content || null, user_id: user.id, image_url: imageUrl, file_url: fileUrl, file_name: fileName,
  });
  if (!error) { location.reload(); }
});

// ── Post actions (like / delete / share) ──
document.addEventListener("click", async (e) => {
  const likeBtn = e.target.closest(".sv-post-like-btn");
  if (likeBtn) {
    const postId = likeBtn.dataset.postId;
    const liked = likeBtn.dataset.liked === "true";
    const icon = likeBtn.querySelector(".sv-post-like-icon");
    const countEl = likeBtn.querySelector(".sv-post-like-count");
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) return;
    if (liked) {
      await supabase.from("post_likes").delete().eq("post_id", postId).eq("user_id", user.id);
      likeBtn.dataset.liked = "false";
      if (icon) icon.textContent = "favorite_border";
      if (countEl) countEl.textContent = Math.max(0, parseInt(countEl.textContent) - 1);
    } else {
      await supabase.from("post_likes").insert({ post_id: postId, user_id: user.id });
      likeBtn.dataset.liked = "true";
      if (icon) icon.textContent = "favorite";
      if (countEl) countEl.textContent = parseInt(countEl.textContent) + 1;
    }
  }

  const shareBtn = e.target.closest(".sv-post-share-btn");
  if (shareBtn) {
    const url = shareBtn.dataset.postUrl;
    if (url) { try { await navigator.clipboard.writeText(url); } catch { } }
  }

  const deleteBtn = e.target.closest(".sv-post-delete-btn");
  if (deleteBtn) {
    if (!confirm("Delete this post?")) return;
    const postId = deleteBtn.dataset.postId;
    const { error } = await supabase.from("posts").delete().eq("id", postId);
    if (!error) deleteBtn.closest(".sv-feed-post")?.remove();
  }
});

// ── Portfolio "See more" toggle ──
document.addEventListener("click", (e) => {
  const btn = e.target.closest(".sv-pp-post-seemore");
  if (!btn) return;
  const text = btn.parentElement.querySelector(".sv-pp-post-text");
  if (!text) return;
  text.classList.toggle("expanded");
  btn.textContent = text.classList.contains("expanded") ? "Show less" : "See more";
});
document.querySelectorAll(".sv-pp-post-text").forEach((el) => {
  if (el.scrollHeight > el.clientHeight) {
    const btn = el.parentElement.querySelector(".sv-pp-post-seemore");
    if (btn) btn.style.display = "";
  }
});

// ── Copy portfolio link ──
const copyBtn = document.getElementById("sv-copy-portfolio-link");
copyBtn?.addEventListener("click", async () => {
  const url = copyBtn.getAttribute("data-url");
  if (!url) return;
  try {
    await navigator.clipboard.writeText(url);
    copyBtn.innerHTML = '<span class="material-symbols-outlined" style="font-size:16px">check</span> Copied!';
    setTimeout(() => { copyBtn.innerHTML = '<span class="material-symbols-outlined" style="font-size:16px">link</span> Copy Portfolio Link'; }, 2000);
  } catch {
    const ta = document.createElement("textarea");
    ta.value = url; document.body.appendChild(ta); ta.select(); document.execCommand("copy"); document.body.removeChild(ta);
  }
});

// ── Portfolio mobile tab switching ──
const portTabs = document.querySelectorAll(".sv-pp-mtab");
const portPanels = document.querySelectorAll(".sv-pp-tab-panel");
portTabs.forEach((tab) => {
  tab.addEventListener("click", () => {
    const target = tab.dataset.tab;
    portTabs.forEach((t) => t.classList.remove("active"));
    tab.classList.add("active");
    portPanels.forEach((p) => p.classList.toggle("sv-pp-tab-panel--active", p.dataset.tab === target));
  });
});

// ── Portfolio like/unlike ──
document.querySelectorAll(".sv-pp-like-btn").forEach((btn) => {
  btn.addEventListener("click", async () => {
    const postId = btn.dataset.postId;
    const liked = btn.dataset.liked === "true";
    const icon = btn.querySelector(".sv-pp-like-icon");
    const countEl = btn.querySelector(".sv-pp-like-count");
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) return;
    if (liked) {
      await supabase.from("post_likes").delete().eq("post_id", postId).eq("user_id", user.id);
      btn.dataset.liked = "false";
      if (icon) icon.textContent = "favorite_border";
      if (countEl) countEl.textContent = Math.max(0, parseInt(countEl.textContent) - 1);
    } else {
      await supabase.from("post_likes").insert({ post_id: postId, user_id: user.id });
      btn.dataset.liked = "true";
      if (icon) icon.textContent = "favorite";
      if (countEl) countEl.textContent = parseInt(countEl.textContent) + 1;
    }
  });
});

// ── Event registration ──
async function toggleRegistration(eventId, btn) {
  const isRegistered = btn.textContent.trim() === "Unregister";
  if (isRegistered) {
    const { error } = await supabase.from("event_registrations").delete().eq("event_id", eventId);
    if (error) { console.error(error); return; }
    btn.textContent = "Register";
    const icon = btn.closest(".sv-ev-featured-card")?.querySelector(".sv-ev-bookmark-btn span");
    if (icon) icon.textContent = "bookmark_border";
  } else {
    const { error } = await supabase.from("event_registrations").insert({ event_id: eventId });
    if (error) { console.error(error); return; }
    btn.textContent = "Unregister";
    const icon = btn.closest(".sv-ev-featured-card")?.querySelector(".sv-ev-bookmark-btn span");
    if (icon) icon.textContent = "bookmark";
  }
}

document.addEventListener("click", (e) => {
  const regBtn = e.target.closest(".sv-ev-reg-btn");
  if (regBtn) { e.preventDefault(); toggleRegistration(regBtn.dataset.eventId, regBtn); }
});
document.addEventListener("click", (e) => {
  const bookmarkBtn = e.target.closest(".sv-ev-bookmark-btn");
  if (bookmarkBtn) {
    e.preventDefault();
    const eventId = bookmarkBtn.dataset.eventId;
    const rBtn = document.querySelector(`.sv-ev-reg-btn[data-event-id="${eventId}"]`);
    if (rBtn) toggleRegistration(eventId, rBtn);
  }
});

// ── Events tab switching ──
const evTabs = document.querySelectorAll(".sv-ev-tab");
const evViewAll = document.getElementById("sv-ev-view-all");
const evViewCalendar = document.getElementById("sv-ev-view-calendar");
const evViewPast = document.getElementById("sv-ev-view-past");
evTabs.forEach((tab) => {
  tab.addEventListener("click", () => {
    if (tab.classList.contains("active")) return;
    evTabs.forEach((t) => t.classList.remove("active"));
    tab.classList.add("active");
    if (evViewAll) evViewAll.style.display = "none";
    if (evViewCalendar) evViewCalendar.style.display = "none";
    if (evViewPast) evViewPast.style.display = "none";
    const name = tab.dataset.tab;
    if (name === "all" && evViewAll) evViewAll.style.display = "";
    else if (name === "calendar" && evViewCalendar) evViewCalendar.style.display = "";
    else if (name === "past" && evViewPast) evViewPast.style.display = "";
  });
});
</script>

<style is:global>
  /* ── Shell Layout ── */
  .sv-shell {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background: #f7f9fc;
    font-family: Inter, sans-serif;
  }
  .sv-panel { display: none; flex: 1; }
  .sv-panel--active { display: flex; flex-direction: column; }

  /* ── Bottom Nav ── */
  .sv-bottom-nav {
    position: fixed; bottom: 0; left: 0; right: 0;
    display: flex; align-items: center; justify-content: space-around;
    height: 64px; background: #f7f9fc;
    box-shadow: 0 -2px 12px rgba(0,0,0,0.06);
    z-index: 100; padding-bottom: env(safe-area-inset-bottom, 0);
  }
  .sv-bnav-item {
    display: flex; flex-direction: column; align-items: center; gap: 2px;
    background: none; border: none; cursor: pointer; padding: 6px 12px;
    font-family: Inter, sans-serif; font-size: 0.65rem; color: var(--color-outline);
    text-decoration: none; transition: color 0.15s;
    -webkit-tap-highlight-color: transparent;
  }
  .sv-bnav-item .material-symbols-outlined { font-size: 22px; }
  .sv-bnav-item.active { color: var(--color-primary); }
  .sv-bnav-item.active .material-symbols-outlined { font-variation-settings: "FILL" 1; }

  /* ── Feed Styles ── */
  .sv-feed-root { display: flex; min-height: 100vh; background: #f7f9fc; }
  .sv-feed-main { flex: 1; overflow-y: auto; padding: 0 0 80px; }
  .sv-feed-content { max-width: 680px; margin: 0 auto; padding: 1rem; }

  .sv-guest-banner {
    display: flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1rem;
    margin-bottom: 1rem; border-radius: 12px;
    background: var(--color-surface-container-low); color: var(--color-on-surface-variant);
    font-size: 0.82rem;
  }
  .sv-guest-icon { font-size: 18px; }
  .sv-guest-link { color: var(--color-primary); font-weight: 600; }

  .sv-top-search-wrap {
    position: relative; display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;
  }
  .sv-top-search-icon { position: absolute; left: 12px; color: var(--color-outline); font-size: 18px; pointer-events: none; }
  .sv-top-search-input {
    flex: 1; padding: 0.75rem 2.5rem; border: none; border-radius: 12px;
    background: var(--color-surface-container-low); font-size: 0.8rem; outline: none;
    font-family: Inter, sans-serif; color: var(--color-on-surface);
  }
  .sv-top-search-input::placeholder { color: var(--color-outline); }
  .sv-top-search-clear {
    position: absolute; right: 48px; background: none; border: none; color: var(--color-outline); cursor: pointer;
    display: none; padding: 4px;
  }
  .sv-top-search-input:not(:placeholder-shown) ~ .sv-top-search-clear { display: flex; }
  .sv-feed-refresh-btn {
    background: var(--color-surface-container-low); border: none; border-radius: 12px;
    width: 38px; height: 38px; display: flex; align-items: center; justify-content: center;
    color: var(--color-primary); cursor: pointer;
  }
  .sv-top-search-dropdown {
    position: absolute; top: 100%; left: 0; right: 48px; z-index: 50;
    background: #f7f9fc; border-radius: 12px; box-shadow: 8px 8px 16px #d1d9e6, -8px -8px 16px #ffffff;
    margin-top: 4px; padding: 0.5rem; display: none;
  }
  .sv-top-search-dropdown.active { display: block; }
  .sv-search-result-item {
    display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem; border-radius: 8px;
    text-decoration: none; color: var(--color-on-surface); transition: background 0.15s;
  }
  .sv-search-result-item:hover { background: var(--color-surface-container-high); }
  .sv-search-result-avatar img, .sv-search-result-avatar { width: 36px; height: 36px; border-radius: 50%; overflow: hidden; background: var(--color-surface-variant); display: flex; align-items: center; justify-content: center; }
  .sv-search-result-avatar .material-symbols-outlined { font-size: 20px; color: var(--color-outline); }
  .sv-search-result-item img { width: 100%; height: 100%; object-fit: cover; }
  .sv-search-result-info { display: flex; flex-direction: column; gap: 1px; }
  .sv-search-result-info strong { font-size: 0.8rem; }
  .sv-search-result-info span { font-size: 0.7rem; color: var(--color-outline); }
  .sv-search-noresult { padding: 1rem; text-align: center; color: var(--color-outline); font-size: 0.8rem; }

  .sv-feed-newusers { margin-bottom: 1rem; }
  .sv-feed-newusers-label { font-size: 0.75rem; font-weight: 600; color: var(--color-outline); margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .sv-feed-newusers-list { display: flex; gap: 0.75rem; overflow-x: auto; padding-bottom: 4px; }
  .sv-feed-newuser-item {
    display: flex; flex-direction: column; align-items: center; gap: 4px; text-decoration: none; min-width: 60px;
  }
  .sv-feed-newuser-avatar { width: 44px; height: 44px; border-radius: 50%; overflow: hidden; }
  .sv-feed-newuser-placeholder { background: var(--color-surface-container-high); display: flex; align-items: center; justify-content: center; color: var(--color-outline); }
  .sv-feed-newuser-placeholder .material-symbols-outlined { font-size: 22px; }
  .sv-feed-newuser-item img { width: 100%; height: 100%; object-fit: cover; }
  .sv-feed-newuser-name { font-size: 0.65rem; color: var(--color-on-surface-variant); text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 60px; }

  /* ── Feed Posts ── */
  .sv-feed-posts { display: flex; flex-direction: column; gap: 1rem; }
  .sv-feed-empty { text-align: center; color: var(--color-outline); padding: 3rem 1rem; font-size: 0.9rem; }
  .sv-feed-post {
    background: #f7f9fc; border-radius: 16px; padding: 1rem;
    box-shadow: 8px 8px 16px #d1d9e6, -8px -8px 16px #ffffff;
  }
  .sv-post-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem; }
