---
return Astro.redirect("/dashboard/feed");
---
  <div class="lp-wrap">
    <!-- TopAppBar -->
    <header class="lp-header">
      <div class="lp-header-inner">
        <div class="lp-header-left">
          <button class="lp-menu-btn" aria-label="Menu">
            <span class="material-symbols-outlined">menu</span>
          </button>
          <h1 class="lp-brand">Science Orbit</h1>
        </div>
        <a href="/login" class="lp-account-btn" aria-label="Sign In">
          <span class="material-symbols-outlined lp-account-icon">account_circle</span>
        </a>
      </div>
    </header>

    <main class="lp-main">
      <!-- Hero Section -->
      <section class="lp-hero">
        <div class="lp-hero-text">
          <h2 class="lp-hero-title">Science Orbit</h2>
          <p class="lp-hero-sub">Showcase your academic journey through precision data and verified networking.</p>
        </div>
        <div class="lp-hero-actions">
          <a href="/register" class="lp-btn lp-btn-primary neumorphic-convex neumorphic-interaction">Get Started</a>
          <a href="/login" class="lp-btn lp-btn-secondary neumorphic-convex neumorphic-interaction">Sign In</a>
        </div>
      </section>

      <!-- Feature Stack -->
      <section class="lp-features">
        <div class="lp-feature-card neumorphic-convex">
          <div class="lp-feature-icon-wrap neumorphic-concave">
            <span class="material-symbols-outlined lp-feature-icon">verified</span>
          </div>
          <div class="lp-feature-body">
            <h3 class="lp-feature-title">Verified Credentials</h3>
            <p class="lp-feature-desc">Immutable academic records powered by distributed ledger protocols.</p>
          </div>
        </div>

        <div class="lp-feature-card neumorphic-convex">
          <div class="lp-feature-icon-wrap neumorphic-concave">
            <span class="material-symbols-outlined lp-feature-icon">hub</span>
          </div>
          <div class="lp-feature-body">
            <h3 class="lp-feature-title">Precision Network</h3>
            <p class="lp-feature-desc">Connect with specialized research peers in a noiseless, high-signal ecosystem.</p>
          </div>
        </div>

        <div class="lp-feature-card neumorphic-convex">
          <div class="lp-feature-icon-wrap neumorphic-concave">
            <span class="material-symbols-outlined lp-feature-icon">bar_chart</span>
          </div>
          <div class="lp-feature-body">
            <h3 class="lp-feature-title">Deep Analytics</h3>
            <p class="lp-feature-desc">Track citation velocity and cross-disciplinary impact with granular precision.</p>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="lp-footer">
      <h2 class="lp-footer-brand">Science Orbit</h2>
      <div class="lp-footer-links">
        <a href="#">Terms of Service</a>
        <span class="lp-footer-divider">|</span>
        <a href="#">Privacy Protocol</a>
        <span class="lp-footer-divider">|</span>
        <a href="#">Institutional Access</a>
      </div>
      <p class="lp-footer-copy">&copy; 2024 Science Orbit. Precision Research Ecosystem.</p>
      <div class="lp-footer-social">
        <div class="lp-social-icon neumorphic-convex"><span class="material-symbols-outlined">science</span></div>
        <div class="lp-social-icon neumorphic-convex"><span class="material-symbols-outlined">database</span></div>
        <div class="lp-social-icon neumorphic-convex"><span class="material-symbols-outlined">share</span></div>
      </div>
    </footer>
  </div>
</BaseLayout>

<script>
  // Neumorphic button shadow toggle
  document.querySelectorAll(".neumorphic-interaction").forEach((btn) => {
    btn.addEventListener("mousedown", () => {
      btn.classList.remove("neumorphic-convex");
      btn.classList.add("neumorphic-concave");
    });
    btn.addEventListener("mouseup", () => {
      btn.classList.add("neumorphic-convex");
      btn.classList.remove("neumorphic-concave");
    });
    btn.addEventListener("mouseleave", () => {
      btn.classList.add("neumorphic-convex");
      btn.classList.remove("neumorphic-concave");
    });
  });

  // Scroll reveal for feature cards
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.style.opacity = "1";
          entry.target.style.transform = "translateY(0)";
        }
      });
    },
    { threshold: 0.1 }
  );

  document.querySelectorAll(".lp-feature-card").forEach((el) => {
    el.style.opacity = "0";
    el.style.transform = "translateY(20px)";
    el.style.transition = "all 0.6s cubic-bezier(0.23, 1, 0.32, 1)";
    observer.observe(el);
  });
</script>

<style is:global>
  /* ── Neumorphic utilities ── */
  .neumorphic-convex {
    box-shadow: -8px -8px 16px #FFFFFF, 8px 8px 16px #D1D9E6;
  }
  .neumorphic-concave {
    box-shadow: inset -4px -4px 8px #FFFFFF, inset 4px 4px 8px #D1D9E6;
  }
  .neumorphic-interaction:active {
    box-shadow: inset 4px 4px 8px #D1D9E6, inset -4px -4px 8px #FFFFFF;
    transform: scale(0.98);
  }

  /* ── Layout ── */
  .lp-wrap {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: #f7f9fc;
    color: #191c1e;
    font-family: Inter, sans-serif;
  }

  /* ── Header ── */
  .lp-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #f7f9fc;
    box-shadow: -8px -8px 16px #FFFFFF, 8px 8px 16px #D1D9E6;
  }
  .lp-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 20px;
    max-width: 1280px;
    margin: 0 auto;
  }
  .lp-header-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .lp-menu-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    border-radius: 12px;
    background: transparent;
    border: none;
    color: #191c1e;
    cursor: pointer;
    transition: opacity 0.15s;
  }
  .lp-menu-btn:hover { opacity: 0.8; }
  .lp-menu-btn:active {
    box-shadow: inset 4px 4px 8px #D1D9E6, inset -4px -4px 8px #FFFFFF;
  }
  .lp-menu-btn .material-symbols-outlined { font-size: 24px; }

  .lp-brand {
    font-family: Sora, sans-serif;
    font-size: 24px;
    font-weight: 700;
    color: #006a67;
    margin: 0;
  }
  .lp-account-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    border-radius: 12px;
    color: #006a67;
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .lp-account-btn:hover { opacity: 0.8; text-decoration: none; }
  .lp-account-btn:active {
    box-shadow: inset 4px 4px 8px #D1D9E6, inset -4px -4px 8px #FFFFFF;
  }
  .lp-account-icon { font-size: 24px !important; font-variation-settings: "FILL" 1; }

  /* ── Main ── */
  .lp-main {
    flex: 1;
    padding: 2rem 20px 4rem;
    max-width: 28rem;
    margin: 0 auto;
    width: 100%;
  }

  /* ── Hero ── */
  .lp-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }
  .lp-hero-text { display: flex; flex-direction: column; gap: 1rem; }
  .lp-hero-title {
    font-family: Sora, sans-serif;
    font-size: 48px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #191c1e;
    margin: 0;
    line-height: 56px;
  }
  .lp-hero-sub {
    font-size: 18px;
    line-height: 28px;
    color: #556064;
    margin: 0;
  }
  .lp-hero-actions {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 1.25rem;
    padding-top: 1rem;
  }

  .lp-btn {
    display: block;
    width: 100%;
    padding: 1rem 2rem;
    border-radius: 16px;
    font-family: Inter, sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s;
    border: none;
  }
  .lp-btn:hover { text-decoration: none; }
  .lp-btn-primary {
    background: #006a67;
    color: #ffffff;
  }
  .lp-btn-primary:hover { opacity: 0.9; }
  .lp-btn-secondary {
    background: #f7f9fc;
    color: #556064;
  }
  .lp-btn-secondary:hover { opacity: 0.85; }

  /* ── Features ── */
  .lp-features {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .lp-feature-card {
    padding: 1.5rem;
    border-radius: 32px;
    background: #f7f9fc;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    transition: transform 0.3s;
  }
  .lp-feature-card:hover { transform: scale(1.02); }

  .lp-feature-icon-wrap {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f2f4f7;
  }
  .lp-feature-icon {
    font-size: 32px !important;
    color: #006a67;
  }
  .lp-feature-body { display: flex; flex-direction: column; gap: 0.5rem; }
  .lp-feature-title {
    font-family: Sora, sans-serif;
    font-size: 24px;
    font-weight: 600;
    color: #191c1e;
    margin: 0;
    line-height: 32px;
  }
  .lp-feature-desc {
    font-size: 16px;
    line-height: 24px;
    color: #3b4948;
    margin: 0;
  }

  /* ── Footer ── */
  .lp-footer {
    width: 100%;
    padding: 3rem 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }
  .lp-footer-brand {
    font-family: Sora, sans-serif;
    font-size: 24px;
    font-weight: 700;
    color: #006a67;
    margin: 0;
  }
  .lp-footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    color: #556064;
    font-size: 16px;
    line-height: 24px;
  }
  .lp-footer-links a {
    color: #556064;
    text-decoration: none;
    transition: color 0.15s;
  }
  .lp-footer-links a:hover { color: #006a67; text-decoration: none; }
  .lp-footer-divider { color: #d8dadd; }
  .lp-footer-copy {
    font-size: 16px;
    line-height: 24px;
    color: #3b4948;
    margin: 0;
  }
  .lp-footer-social {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
  }
  .lp-social-icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: #f7f9fc;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 1;
    transition: opacity 0.15s;
    color: #006a67;
  }
  .lp-social-icon:hover { opacity: 0.8; }
  .lp-social-icon .material-symbols-outlined { font-size: 20px; }

  /* ── Responsive ── */
  @media (min-width: 768px) {
    .lp-header-inner { padding: 1rem 64px; }
    .lp-main {
      max-width: 32rem;
      padding: 4rem 20px 6rem;
    }
    .lp-hero-title { font-size: 56px; line-height: 64px; }
    .lp-hero-actions {
      flex-direction: row;
      justify-content: center;
    }
    .lp-btn { width: auto; min-width: 200px; }
    .lp-footer { padding: 4rem 64px; }
  }

  @media (min-width: 1024px) {
    .lp-features {
      flex-direction: row;
      gap: 1.5rem;
    }
    .lp-feature-card { flex: 1; }
    .lp-main { max-width: 64rem; }
  }
</style>
