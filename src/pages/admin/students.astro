---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { createClient } from "../../lib/supabase";
import { requireAdmin } from "../../lib/admin-auth";
import type { Campus } from "../../types/database";

const supabase = createClient({ request: Astro.request, cookies: Astro.cookies });
const admin = await requireAdmin(supabase);
if (!admin) return Astro.redirect("/login");

const campuses = (
  await supabase.from("campuses").select("*").order("name")
).data as Campus[] | null;
---

<AdminLayout title="Student Directory" activeTab="students">
  <div class="w-full" style="max-width:1200px;margin:0 auto">
    <h1>Student Directory</h1>
    <p class="subtitle">Manage all registered students across planetary campuses.</p>

    <div class="filter-bar">
      <div class="filter-toggle-row">
        <button class="btn-neu btn-neu-sm" id="toggle-filters" title="Toggle filters">
          <span class="material-symbols-outlined" style="font-size:16px">filter_list</span> Filters
        </button>
        <button class="btn-neu btn-neu-sm" id="refresh-students">
          <span class="material-symbols-outlined" style="font-size:16px">refresh</span> Refresh
        </button>
      </div>
      <div class="filter-dropdowns" id="filter-dropdowns">
        <div class="filter-group">
          <select id="filter-campus" class="filter-select"><option value="">All Campuses</option></select>
          <select id="filter-tier" class="filter-select"><option value="">All Tiers</option></select>
          <select id="filter-batch" class="filter-select"><option value="">All Batches</option></select>
          <select id="filter-status" class="filter-select"><option value="">All Status</option><option value="approved">Approved</option><option value="pending">Pending</option></select>
          <button class="btn-neu btn-neu-sm" id="clear-filters">
            <span class="material-symbols-outlined" style="font-size:14px">clear</span> Clear
          </button>
        </div>
      </div>
    </div>
    <div id="students-container">
      <p class="loading">Loading...</p>
    </div>
  </div>
</AdminLayout>

<div id="campuses-data" data-campuses={JSON.stringify(campuses ?? [])} style="display:none"></div>

<script>
  import { createBrowserClient } from "@supabase/ssr";
  function getSupabase() {
    return createBrowserClient(
      import.meta.env.PUBLIC_SUPABASE_URL,
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY
    );
  }

  let studentCache = [];
  let filterStateSD = { campus: "", tier: "", batch: "", status: "" };

  function getFilterVal(id) { const el = document.getElementById(id); return el ? el.value : ""; }
  function setFilterVal(id, v) { const el = document.getElementById(id); if (el) el.value = v; }
  function saveFilterState() { filterStateSD = { campus: getFilterVal("filter-campus"), tier: getFilterVal("filter-tier"), batch: getFilterVal("filter-batch"), status: getFilterVal("filter-status") }; }
  function restoreFilterState() { setFilterVal("filter-campus", filterStateSD.campus); setFilterVal("filter-tier", filterStateSD.tier); setFilterVal("filter-batch", filterStateSD.batch); setFilterVal("filter-status", filterStateSD.status); }

  function initFiltersFromData() {
    const campusesData = JSON.parse(document.getElementById('campuses-data')?.getAttribute('data-campuses') || '[]');
    const campusSel = document.getElementById("filter-campus");
    if (campusSel) campusSel.innerHTML = '<option value="">All Campuses</option>' + campusesData.map(c => `<option value="${c.id}">${escapeHtml(c.name)}</option>`).join("");

    const tierSet = new Set(), batchSet = new Set();
    for (const p of studentCache) { if (p.academic_tier) tierSet.add(p.academic_tier); if (p.batch) batchSet.add(p.batch); }
    const tierSel = document.getElementById("filter-tier");
    if (tierSel) tierSel.innerHTML = '<option value="">All Tiers</option>' + Array.from(tierSet).sort().map(t => `<option value="${t}">${escapeHtml(t)}</option>`).join("");
    const batchSel = document.getElementById("filter-batch");
    if (batchSel) batchSel.innerHTML = '<option value="">All Batches</option>' + Array.from(batchSet).sort((a, b) => Number(a) - Number(b)).map(b => `<option value="${b}">Batch ${escapeHtml(b)}</option>`).join("");
    restoreFilterState();
  }

  function renderStudentsTable() {
    const container = document.getElementById("students-container");
    if (!container) return;
    let list = studentCache;
    const cf = getFilterVal("filter-campus"), tf = getFilterVal("filter-tier"), bf = getFilterVal("filter-batch"), sf = getFilterVal("filter-status");
    list = list.filter(p => {
      if (cf && p.campus_id !== cf) return false;
      if (tf && p.academic_tier !== tf) return false;
      if (bf && p.batch !== bf) return false;
      if (sf === "approved" && !p.is_approved) return false;
      if (sf === "pending" && p.is_approved) return false;
      return true;
    });
    if (list.length === 0) {
      container.innerHTML = '<div class="empty-state">No students match the current filters.</div>';
      return;
    }
    container.innerHTML = `
      <div style="margin-bottom:0.5rem;font-size:12px;color:var(--color-on-surface-variant)">${list.length} student${list.length === 1 ? "" : "s"}</div>
      <div class="data-table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Student</th>
              <th>Legal Name</th>
              <th>Campus</th>
              <th>Status</th>
              <th style="text-align:right">Actions</th>
            </tr>
          </thead>
          <tbody>
            ${list.map((p) => `
              <tr data-id="${p.id}">
                <td>
                  <div style="display:flex;align-items:center;gap:10px">
                    ${getAvatarSrc(p.id, p.dasthar_url)
                      ? `<img src="${getAvatarSrc(p.id, p.dasthar_url)}" alt="" style="width:40px;height:40px;border-radius:50%;object-fit:cover;background:var(--color-surface-variant)" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />`
                      : ""
                    }
                    <div style="display:flex;flex-direction:column">
                      <strong style="color:var(--color-primary-fixed)">${escapeHtml(p.display_name || p.legal_name || "—")}</strong>
                      <span style="font-size:12px;color:var(--color-on-surface-variant)">@${escapeHtml(p.username)}</span>
                    </div>
                  </div>
                </td>
                <td class="editable-name">
                  <span class="name-display">${escapeHtml(p.legal_name || "\u2014")}</span>
                  <input class="name-input" style="display:none" value="${escapeHtml(p.legal_name || "")}" />
                </td>
                <td>
                  <span class="campus-display campus-tag">${escapeHtml(p.campuses?.name || "No Campus Assigned")}</span>
                  <select class="campus-select" style="display:none">
                    ${JSON.parse(document.getElementById('campuses-data').getAttribute('data-campuses'))
                      .map((c) => `<option value="${c.id}" ${c.id === p.campus_id ? "selected" : ""}>${escapeHtml(c.name)}</option>`)
                      .join("")}
                  </select>
                </td>
                <td>
                  <div class="status-badge">
                    <span class="status-dot ${p.is_approved ? "approved" : "pending"}"></span>
                    <span class="status-label ${p.is_approved ? "approved" : "pending"}">${p.is_approved ? "Approved" : "Pending"}</span>
                  </div>
                </td>
                <td>
                  <div class="action-btns">
                    <button class="btn-icon-neu btn-edit-name" title="Edit Name"><span class="material-symbols-outlined" style="font-size:18px">edit</span></button>
                    <button class="btn-icon-neu btn-edit-campus" title="Edit Campus"><span class="material-symbols-outlined" style="font-size:18px">domain</span></button>
                    <button class="btn-icon-neu btn-save" style="display:none"><span class="material-symbols-outlined" style="font-size:18px">check</span></button>
                    <button class="btn-icon-neu btn-cancel" style="display:none"><span class="material-symbols-outlined" style="font-size:18px">close</span></button>
                    <button class="btn-icon-neu danger btn-delete" title="Delete User"><span class="material-symbols-outlined" style="font-size:18px">delete</span></button>
                  </div>
                </td>
              </tr>
            `).join("")}
          </tbody>
        </table>
      </div>
    `;
    attachHandlers();
  }

  async function loadStudents() {
    const container = document.getElementById("students-container");
    if (!container) return;
    try {
      const supabase = await getSupabase();
      const { data, error } = await supabase
        .from("profiles")
        .select("id, username, legal_name, campus_id, batch, academic_tier, is_approved, dasthar_url, created_at, campuses(name)")
        .eq("is_admin", false)
        .order("created_at", { ascending: false });
      if (error) throw error;
      if (!data || data.length === 0) {
        container.innerHTML = '<div class="empty-state">No students registered yet.</div>';
        return;
      }
      studentCache = data || [];
      initFiltersFromData();
      renderStudentsTable();
    } catch (err) {
      container.innerHTML = `<div class="error-state">Failed to load: ${err instanceof Error ? err.message : "Unknown error"}</div>`;
    }
  }

  function attachHandlers() {
    const supabasePromise = getSupabase();

    document.querySelectorAll(".btn-delete").forEach((btn) => {
      btn.addEventListener("click", async () => {
        if (!confirm("Delete this user permanently? This cannot be undone."))
          return;

        const row = btn.closest("tr");
        const id = row?.getAttribute("data-id");
        if (!id) return;

        btn.disabled = true;
        btn.style.opacity = "0.5";

        try {
          const supabase = await supabasePromise;

          const { data: profile } = await supabase
            .from("profiles")
            .select("dasthar_url")
            .eq("id", id)
            .single();

          if (profile?.dasthar_url) {
            await supabase.storage
              .from("dasthar")
              .remove([profile.dasthar_url]);
          }

          const { error: deleteError } = await supabase
            .from("profiles")
            .delete()
            .eq("id", id);

          if (deleteError) throw deleteError;

          row?.remove();
          const tbody = document.querySelector("tbody");
          if (tbody && tbody.children.length === 0) {
            document.getElementById("students-container").innerHTML =
              '<div class="empty-state">No students registered yet.</div>';
          }
        } catch (err) {
          btn.disabled = false;
          btn.style.opacity = "1";
          alert("Failed to delete: " + (err instanceof Error ? err.message : "Unknown error"));
        }
      });
    });

    document.querySelectorAll(".btn-edit-name").forEach((btn) => {
      btn.addEventListener("click", () => {
        const row = btn.closest("tr");
        const cell = row?.querySelector(".editable-name");
        if (!cell) return;

        cell.querySelector(".name-display").style.display = "none";
        cell.querySelector(".name-input").style.display = "block";
        btn.style.display = "none";
        row.querySelector(".btn-edit-campus").style.display = "none";
        row.querySelector(".btn-delete").style.display = "none";
        row.querySelector(".btn-save").style.display = "";
        row.querySelector(".btn-cancel").style.display = "";
      });
    });

    document.querySelectorAll(".btn-edit-campus").forEach((btn) => {
      btn.addEventListener("click", () => {
        const row = btn.closest("tr");
        const cell = row?.querySelector("td:nth-child(3)");
        if (!cell) return;

        cell.querySelector(".campus-display").style.display = "none";
        cell.querySelector(".campus-select").style.display = "block";
        btn.style.display = "none";
        row.querySelector(".btn-edit-name").style.display = "none";
        row.querySelector(".btn-delete").style.display = "none";
        row.querySelector(".btn-save").style.display = "";
        row.querySelector(".btn-cancel").style.display = "";
      });
    });

    document.querySelectorAll(".btn-cancel").forEach((btn) => {
      btn.addEventListener("click", () => {
        const row = btn.closest("tr");
        resetRow(row);
      });
    });

    document.querySelectorAll(".btn-save").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const row = btn.closest("tr");
        const id = row?.getAttribute("data-id");
        if (!id) return;

        btn.disabled = true;
        btn.style.opacity = "0.5";

        try {
          const supabase = await supabasePromise;
          const updates = {};

          const nameInput = row?.querySelector(".name-input") as HTMLInputElement;
          if (nameInput && nameInput.style.display !== "none") {
            updates.legal_name = nameInput.value.trim();
          }

          const campusSelect = row?.querySelector(
            ".campus-select"
          ) as HTMLSelectElement;
          if (campusSelect && campusSelect.style.display !== "none") {
            updates.campus_id = campusSelect.value;
          }

          const { error } = await supabase
            .from("profiles")
            .update(updates)
            .eq("id", id);

          if (error) throw error;

          resetRow(row);
          loadStudents();
        } catch (err) {
          btn.disabled = false;
          btn.style.opacity = "1";
          alert("Failed to save: " + (err instanceof Error ? err.message : "Unknown error"));
        }
      });
    });
  }

  function resetRow(row) {
    if (!row) return;
    row.querySelector(".name-display").style.display = "";
    row.querySelector(".name-input").style.display = "none";
    row.querySelector(".campus-display").style.display = "";
    row.querySelector(".campus-select").style.display = "none";
    row.querySelector(".btn-edit-name").style.display = "";
    row.querySelector(".btn-edit-campus").style.display = "";
    row.querySelector(".btn-delete").style.display = "";
    row.querySelector(".btn-save").style.display = "none";
    row.querySelector(".btn-cancel").style.display = "none";
  }

  function getAvatarSrc(id, path) {
    if (!path) return "";
    if (path.startsWith("http")) return path;
    const sb = createBrowserClient(
      import.meta.env.PUBLIC_SUPABASE_URL,
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY
    );
    return sb.storage.from("dasthar").getPublicUrl(path).data.publicUrl;
  }

  function escapeHtml(str) {
    if (!str) return "";
    const div = document.createElement("div");
    div.textContent = str;
    return div.innerHTML;
  }

  loadStudents();

  document.getElementById("toggle-filters")?.addEventListener("click", () => {
    const dd = document.getElementById("filter-dropdowns");
    if (dd) dd.classList.toggle("open");
  });
  document.getElementById("clear-filters")?.addEventListener("click", () => {
    const ids = ["filter-campus", "filter-tier", "filter-batch", "filter-status"];
    ids.forEach(id => { const el = document.getElementById(id); if (el) el.value = ""; });
    filterStateSD = { campus: "", tier: "", batch: "", status: "" };
    renderStudentsTable();
  });
  document.getElementById("refresh-students")?.addEventListener("click", () => { saveFilterState(); loadStudents(); });
  ["filter-campus", "filter-tier", "filter-batch", "filter-status"].forEach(id => {
    document.getElementById(id)?.addEventListener("change", renderStudentsTable);
  });
</script>

<style>
  .filter-bar { margin-bottom: 1.5rem; }
  .filter-toggle-row { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.75rem; }
  .filter-toggle-row button { display: inline-flex; align-items: center; gap: 0.35rem; }
  .filter-dropdowns { display: none; }
  .filter-dropdowns.open { display: block; }
  .filter-group { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; }
  .filter-select {
    background: var(--color-surface);
    border: none;
    border-radius: 8px;
    padding: 0.45rem 0.75rem;
    font-size: 13px;
    color: var(--color-on-surface);
    box-shadow: inset 2px 2px 5px var(--shadow-dark), inset -2px -2px 5px var(--shadow-light);
    appearance: auto;
  }
  .filter-select:focus { outline: 2px solid var(--color-primary); }
  .name-input, .campus-select {
    background: var(--color-surface);
    border: none;
    border-radius: 6px;
    padding: 0.3rem 0.5rem;
    font-size: 13px;
    color: var(--color-on-surface);
    box-shadow: inset 2px 2px 4px var(--shadow-dark), inset -2px -2px 4px var(--shadow-light);
  }
  .campus-tag {
    display: inline-block;
    background: var(--color-surface);
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
  }
</style>
