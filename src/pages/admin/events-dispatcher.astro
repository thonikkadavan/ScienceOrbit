---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { createClient } from "../../lib/supabase";
import { requireAdmin } from "../../lib/admin-auth";

const supabase = createClient({ request: Astro.request, cookies: Astro.cookies });
const admin = await requireAdmin(supabase);
if (!admin) return Astro.redirect("/login");
---

<AdminLayout title="Events Dispatcher" activeTab="events-dispatcher">
  <h1>Events &amp; Calendar Dispatcher</h1>
  <p class="subtitle">Schedule events, toggle live banners, and manage the event timeline</p>

  <div class="gov-tabs">
    <button class="gov-tab active" data-tab="scheduler">Chronological Scheduler</button>
    <button class="gov-tab" data-tab="live">Live Banner Toggle</button>
    <button class="gov-tab" data-tab="timeline">Up Next Timeline</button>
  </div>

  <!-- Chronological Scheduler -->
  <div class="gov-panel active" id="panel-scheduler">
    <div class="neu-card" style="margin-bottom:1rem">
      <form id="add-event-form" style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem">
        <div class="neu-input-wrap" style="grid-column:1/-1">
          <input type="text" id="event-title" required placeholder="Event title..." />
        </div>
        <div class="neu-input-wrap">
          <input type="text" id="event-desc" placeholder="Short description..." />
        </div>
        <div class="neu-input-wrap">
          <input type="datetime-local" id="event-date" required />
        </div>
        <div class="neu-input-wrap">
          <select id="event-type">
            <option value="webinar">Webinar</option>
            <option value="workshop">Workshop</option>
            <option value="conference">Conference</option>
            <option value="hackathon">Hackathon</option>
            <option value="meetup">Meetup</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="neu-input-wrap">
          <select id="event-category">
            <option value="">Select category…</option>
            <option value="BIOLOGY">Biology</option>
            <option value="ASTROPHYSICS">Astrophysics</option>
            <option value="COGNITIVE_SCI">Cognitive Science</option>
            <option value="CHEMISTRY">Chemistry</option>
            <option value="COMPUTER_SCI">Computer Science</option>
            <option value="MATHEMATICS">Mathematics</option>
            <option value="PHYSICS">Physics</option>
            <option value="ENGINEERING">Engineering</option>
            <option value="ENVIRONMENTAL">Environmental Science</option>
            <option value="MEDICINE">Medicine</option>
            <option value="NEUROSCIENCE">Neuroscience</option>
            <option value="DATA_SCI">Data Science</option>
            <option value="OTHER">Other</option>
          </select>
        </div>
        <div class="neu-input-wrap">
          <input type="text" id="event-icon" placeholder="Icon name (e.g. science)" />
        </div>
        <div class="neu-input-wrap">
          <input type="text" id="event-location" placeholder="Location URL (Google Maps, Zoom, etc.)" />
        </div>
        <div class="neu-input-wrap">
          <input type="text" id="event-location-label" placeholder="Location label (e.g. Main Auditorium, Online)" />
        </div>
        <div class="neu-input-wrap">
          <input type="url" id="event-reg-url" placeholder="Registration URL" />
        </div>
        <div style="display:flex;align-items:center;gap:0.75rem;grid-column:1/-1;flex-wrap:wrap">
          <div style="display:flex;align-items:center;gap:0.5rem">
            <span style="font-size:13px;font-weight:600;color:var(--color-on-surface-variant);letter-spacing:0.02em">LIVE PRIORITY</span>
            <label class="st-toggle">
              <input type="checkbox" id="event-live" />
              <span class="st-toggle-slider"></span>
            </label>
          </div>
          <div style="display:flex;align-items:center;gap:0.5rem">
            <span style="font-size:13px;font-weight:600;color:var(--color-on-surface-variant);letter-spacing:0.02em">PIN TO FEED</span>
            <label class="st-toggle">
              <input type="checkbox" id="event-pin" />
              <span class="st-toggle-slider"></span>
            </label>
          </div>
          <div style="display:flex;gap:0.5rem;margin-left:auto">
            <button type="button" class="btn-neu" id="cancel-edit" style="display:none"><span class="material-symbols-outlined" style="font-size:16px">close</span> Cancel</button>
            <button type="submit" class="btn-neu" id="event-submit-btn"><span class="material-symbols-outlined" style="font-size:16px">add</span> Create Event</button>
          </div>
        </div>
      </form>
      <p id="event-error" class="error-msg"></p>
    </div>
    <div id="event-feedback" class="feedback-msg"></div>
    <div id="events-container"><p class="loading">Loading events...</p></div>
  </div>

  <!-- Live Banner Toggle -->
  <div class="gov-panel" id="panel-live">
    <p class="subtitle">Toggle live status for events. Live events appear as banners on the events page.</p>
    <div id="live-container"><p class="loading">Loading...</p></div>
  </div>

  <!-- Up Next Timeline -->
  <div class="gov-panel" id="panel-timeline">
    <p class="subtitle">Upcoming events in chronological order</p>
    <div id="timeline-container"><p class="loading">Loading timeline...</p></div>
  </div>
</AdminLayout>

<style is:global>
  .gov-tabs { display:flex; gap:0; margin-bottom:1.5rem; box-shadow:var(--shadow-recessed); border-radius:var(--radius-xl); overflow:hidden; }
  .gov-tab { flex:1; padding:0.75rem 1rem; border:none; background:transparent; color:var(--color-on-surface-variant); font-family:var(--font-label); font-size:13px; font-weight:600; cursor:pointer; letter-spacing:0.03em; transition:all 0.15s; text-align:center; }
  .gov-tab.active { box-shadow:var(--shadow-extruded-sm); color:var(--color-primary); }
  .gov-tab:hover:not(.active) { color:var(--color-on-surface); }
  .gov-panel { display:none; }
  .gov-panel.active { display:block; }
  .event-scheduler-row { display:flex; align-items:center; gap:0.75rem; padding:0.75rem 1rem; box-shadow:var(--shadow-extruded-sm); border-radius:var(--radius-md); margin-bottom:0.5rem; }
  .event-scheduler-row.live { border-left:3px solid var(--color-error); }
  .es-title { flex:1; font-weight:600; font-size:14px; color:var(--color-on-surface); }
  .es-date { font-size:12px; color:var(--color-on-surface-variant); min-width:100px; }
  .es-type { font-size:11px; text-transform:uppercase; letter-spacing:0.05em; color:var(--color-primary-container); min-width:80px; }
  .live-banner-card { display:flex; align-items:center; gap:1rem; padding:1rem; box-shadow:var(--shadow-extruded-sm); border-radius:var(--radius-md); margin-bottom:0.5rem; }
  .live-banner-card.live { border-left:3px solid var(--color-error); }
  .lb-info { flex:1; }
  .lb-title { font-weight:600; font-size:15px; color:var(--color-on-surface); }
  .lb-meta { font-size:12px; color:var(--color-on-surface-variant); }
  .timeline-item { display:flex; gap:1rem; padding:0.75rem 1rem; box-shadow:var(--shadow-extruded-sm); border-radius:var(--radius-md); margin-bottom:0.5rem; align-items:center; }
  .timeline-date { min-width:80px; font-size:12px; font-weight:600; color:var(--color-primary); }
  .timeline-title { flex:1; font-weight:500; color:var(--color-on-surface); }
  .timeline-type { font-size:11px; text-transform:uppercase; color:var(--color-on-surface-variant); }
  .st-toggle { position:relative; display:inline-block; width:44px; height:24px; flex-shrink:0; }
  .st-toggle input { opacity:0; width:0; height:0; }
  .st-toggle-slider { position:absolute; cursor:pointer; inset:0; background:var(--color-surface-container-high); border-radius:12px; box-shadow:var(--shadow-recessed-sm); transition:background 0.2s; }
  .st-toggle-slider::before { content:""; position:absolute; width:20px; height:20px; left:2px; bottom:2px; background:var(--color-surface); border-radius:50%; box-shadow:var(--shadow-extruded-sm); transition:transform 0.2s; }
  .st-toggle input:checked + .st-toggle-slider { background:var(--color-error); }
  .st-toggle input:checked + .st-toggle-slider::before { transform:translateX(20px); }
  .feedback-msg { padding:0.65rem 1rem; border-radius:var(--radius-default); font-size:13px; font-weight:600; margin-bottom:0.75rem; transition:all 0.3s; }
  .feedback-msg.success { box-shadow:var(--shadow-extruded-sm); color:var(--color-primary); background:rgba(0,106,103,0.06); }
  .feedback-msg:empty { padding:0; margin:0; }
</style>

<script>
  import { createBrowserClient } from "@supabase/ssr";
  function getSupabase() {
    return createBrowserClient(
      import.meta.env.PUBLIC_SUPABASE_URL,
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY
    );
  }
  function escapeHtml(str) {
    if (!str) return "";
    const d = document.createElement("div");
    d.textContent = str;
    return d.innerHTML;
  }
  function errMsg(err) {
    return err instanceof Error ? err.message : typeof err === "string" ? err : "Request failed. Check console for details.";
  }
  const supabase = getSupabase();
  let editingEventId = null;

  document.querySelectorAll(".gov-tab").forEach((tab) => {
    tab.addEventListener("click", () => {
      document.querySelectorAll(".gov-tab").forEach((t) => t.classList.remove("active"));
      document.querySelectorAll(".gov-panel").forEach((p) => p.classList.remove("active"));
      tab.classList.add("active");
      document.getElementById("panel-" + tab.getAttribute("data-tab"))?.classList.add("active");
    });
  });

  /* ── Scheduler ── */
  async function loadEvents() {
    const container = document.getElementById("events-container");
    if (!container) return;
    try {
      const { data, error } = await supabase
        .from("events")
        .select("*")
        .order("event_date", { ascending: false })
        .limit(100);
      if (error) throw error;
      if (!data || data.length === 0) {
        container.innerHTML = '<div class="empty-state">No events scheduled.</div>';
        return;
      }
      container.innerHTML = `
        <div class="data-table-wrap">
          <table class="data-table">
            <thead><tr><th>Title</th><th>Date</th><th>Type</th><th>Pin</th><th>Live</th><th>Action</th></tr></thead>
            <tbody>
              ${data
                .map(
                  (e) => `
                <tr class="${e.is_live ? "live" : ""}">
                  <td><strong>${escapeHtml(e.title)}</strong></td>
                  <td style="font-size:13px;color:var(--color-on-surface-variant)">${new Date(e.event_date).toLocaleDateString()} ${new Date(e.event_date).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })}</td>
                  <td><span class="campus-tag">${escapeHtml(e.event_type || "—")}</span></td>
                  <td>${e.is_pinned ? '<span class="material-symbols-outlined" style="font-size:18px;color:var(--color-primary)">keep</span>' : ""}</td>
                  <td><span class="status-badge"><span class="status-dot ${e.is_live ? "approved" : "pending"}"></span><span class="status-label ${e.is_live ? "approved" : "pending"}">${e.is_live ? "Live" : "Offline"}</span></span></td>
                  <td>
                    <div style="display:flex;gap:0.35rem">
                      <button class="btn-neu btn-neu-sm" data-action="edit-event" data-id="${e.id}">Edit</button>
                      <button class="btn-neu btn-neu-sm" data-action="toggle-live" data-id="${e.id}" data-live="${e.is_live}">${e.is_live ? "Take Offline" : "Go Live"}</button>
                      <button class="btn-neu btn-neu-sm danger" data-action="delete-event" data-id="${e.id}" data-title="${escapeHtml(e.title)}">Delete</button>
                    </div>
                  </td>
                </tr>
              `
                )
                .join("")}
            </tbody>
          </table>
        </div>
      `;
      container.querySelectorAll("[data-action]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const action = btn.getAttribute("data-action");
          const id = btn.getAttribute("data-id");
          btn.disabled = true;
          try {
            if (action === "edit-event" || action === "edit-timeline") {
              btn.disabled = false;
              document.querySelector('[data-tab="scheduler"]')?.classList.add("active");
              document.getElementById("panel-scheduler")?.classList.add("active");
              await loadEventIntoForm(id);
              return;
            }
            if (action === "toggle-live") {
              const live = btn.getAttribute("data-live") === "true";
              await supabase.from("events").update({ is_live: !live }).eq("id", id);
            } else if (action === "delete-event") {
              const title = btn.getAttribute("data-title");
              if (!confirm(`Delete event "${title}"?`)) { btn.disabled = false; return; }
              await supabase.from("events").delete().eq("id", id);
            }
            refreshAll();
          } catch (err) {
            console.error("EventsDisp scheduler action:", err);
            btn.disabled = false;
            alert("Failed: " + errMsg(err));
          }
        });
      });
    } catch (err) {
      console.error("EventsDisp loadEvents:", err);
      container.innerHTML = `<div class="error-state">Failed to load: ${errMsg(err)}</div>`;
    }
  }

  function refreshAll() {
    loadEvents();
    loadLiveEvents();
    loadTimeline();
  }

  async function loadEventIntoForm(id) {
    try {
      const { data: ev, error } = await supabase.from("events").select("*").eq("id", id).single();
      if (error) throw error;
      if (!ev) { alert("Event not found."); return; }
      fillEditForm(ev);
    } catch (err) {
      console.error("loadEventIntoForm:", err);
      alert("Failed to load event: " + errMsg(err));
    }
  }

  function showFeedback(msg, type) {
    const el = document.getElementById("event-feedback");
    if (!el) return;
    el.textContent = msg;
    el.className = "feedback-msg " + (type || "success");
    setTimeout(() => { el.className = "feedback-msg"; }, 3000);
  }

  function fillEditForm(ev) {
    editingEventId = ev.id;
    document.getElementById("event-title").value = ev.title || "";
    document.getElementById("event-desc").value = ev.description || "";
    if (ev.event_date) {
      const d = new Date(ev.event_date);
      const local = new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
      document.getElementById("event-date").value = local;
    }
    document.getElementById("event-type").value = ev.event_type || "webinar";
    document.getElementById("event-category").value = ev.category || "";
    document.getElementById("event-icon").value = ev.icon || "event";
    document.getElementById("event-location").value = ev.location || "";
    document.getElementById("event-location-label").value = ev.location_label || "";
    document.getElementById("event-reg-url").value = ev.registration_url || "";
    document.getElementById("event-live").checked = ev.is_live || false;
    document.getElementById("event-pin").checked = ev.is_pinned || false;
    document.getElementById("cancel-edit").style.display = "";
    const submitBtn = document.getElementById("event-submit-btn");
    submitBtn.innerHTML = '<span class="material-symbols-outlined" style="font-size:16px">save</span> Update Event';
    document.getElementById("event-title").focus();
    document.getElementById("event-error").textContent = "";
  }

  function resetEditForm() {
    editingEventId = null;
    document.getElementById("add-event-form").reset();
    document.getElementById("cancel-edit").style.display = "none";
    const submitBtn = document.getElementById("event-submit-btn");
    submitBtn.innerHTML = '<span class="material-symbols-outlined" style="font-size:16px">add</span> Create Event';
    document.getElementById("event-error").textContent = "";
  }

  document.getElementById("cancel-edit")?.addEventListener("click", resetEditForm);

  document.getElementById("add-event-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const titleInput = document.getElementById("event-title");
    const descInput = document.getElementById("event-desc");
    const dateInput = document.getElementById("event-date");
    const typeInput = document.getElementById("event-type");
    const catInput = document.getElementById("event-category");
    const iconInput = document.getElementById("event-icon");
    const locInput = document.getElementById("event-location");
    const locLabelInput = document.getElementById("event-location-label");
    const regUrlInput = document.getElementById("event-reg-url");
    const liveCheck = document.getElementById("event-live");
    const pinCheck = document.getElementById("event-pin");
    const errorEl = document.getElementById("event-error");
    if (!titleInput || !dateInput || !errorEl) return;
    errorEl.textContent = "";
    if (!titleInput.value.trim() || !dateInput.value) {
      errorEl.textContent = "Title and date are required.";
      return;
    }
    titleInput.disabled = true;
    dateInput.disabled = true;
    const payload = {
      title: titleInput.value.trim(),
      description: descInput?.value?.trim() || "",
      event_date: new Date(dateInput.value).toISOString(),
      event_type: typeInput?.value || "webinar",
      category: catInput?.value?.trim() || "",
      icon: iconInput?.value?.trim() || "event",
      location: locInput?.value?.trim() || "",
      location_label: locLabelInput?.value?.trim() || "",
      registration_url: regUrlInput?.value?.trim() || "",
      is_live: liveCheck?.checked || false,
      is_pinned: pinCheck?.checked || false,
    };
    try {
      let error;
      if (editingEventId) {
        ({ error } = await supabase.from("events").update(payload).eq("id", editingEventId));
      } else {
        ({ error } = await supabase.from("events").insert(payload));
      }
      if (error) throw error;
      showFeedback(editingEventId ? "Event updated successfully." : "Event created successfully.", "success");
      resetEditForm();
      refreshAll();
    } catch (err) {
      console.error("EventsDisp submit:", err);
      errorEl.textContent = errMsg(err);
    } finally {
      titleInput.disabled = false;
      dateInput.disabled = false;
    }
  });

  /* ── Live Banner Toggle ── */
  async function loadLiveEvents() {
    const container = document.getElementById("live-container");
    if (!container) return;
    try {
      const { data, error } = await supabase
        .from("events")
        .select("*")
        .order("is_live", { ascending: false })
        .order("event_date", { ascending: true })
        .limit(50);
      if (error) throw error;
      if (!data || data.length === 0) {
        container.innerHTML = '<div class="empty-state">No events found.</div>';
        return;
      }
      container.innerHTML = data
        .map(
          (e) => `
        <div class="live-banner-card${e.is_live ? " live" : ""}">
          <span class="material-symbols-outlined" style="font-size:24px;color:${e.is_live ? "var(--color-error)" : "var(--color-on-surface-variant)"}">${e.is_live ? "podcasts" : "radio_button_unchecked"}</span>
          ${e.is_pinned ? '<span class="material-symbols-outlined" style="font-size:18px;color:var(--color-primary)">keep</span>' : ""}
          <div class="lb-info">
            <div class="lb-title">${escapeHtml(e.title)} <span class="campus-tag">${escapeHtml(e.event_type || "—")}</span></div>
            <div class="lb-meta">${new Date(e.event_date).toLocaleDateString()} ${e.location ? "· " + escapeHtml(e.location) : ""}</div>
          </div>
          <div style="display:flex;gap:0.35rem">
            <button class="btn-neu btn-neu-sm" data-action="edit-live" data-id="${e.id}">Edit</button>
            <button class="btn-neu btn-neu-sm ${e.is_live ? "danger" : ""}" data-action="toggle-live-banner" data-id="${e.id}" data-live="${e.is_live}">${e.is_live ? "Take Offline" : "Go Live"}</button>
          </div>
        </div>
      `
        )
        .join("");
      container.querySelectorAll("[data-action]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const action = btn.getAttribute("data-action");
          const id = btn.getAttribute("data-id");
          if (action === "edit-live") {
            btn.disabled = false;
            // Switch to scheduler tab and trigger edit
            document.querySelectorAll(".gov-tab").forEach((t) => t.classList.remove("active"));
            document.querySelectorAll(".gov-panel").forEach((p) => p.classList.remove("active"));
            document.querySelector('[data-tab="scheduler"]')?.classList.add("active");
            document.getElementById("panel-scheduler")?.classList.add("active");
            await loadEventIntoForm(id);
            return;
          }
          btn.disabled = true;
          try {
            const live = btn.getAttribute("data-live") === "true";
            await supabase.from("events").update({ is_live: !live }).eq("id", id);
            refreshAll();
          } catch (err) {
            console.error("EventsDisp liveToggle:", err);
            btn.disabled = false;
            alert("Failed: " + errMsg(err));
          }
        });
      });
    } catch (err) {
      console.error("EventsDisp loadLiveEvents:", err);
      container.innerHTML = `<div class="error-state">Failed: ${errMsg(err)}</div>`;
    }
  }

  /* ── Up Next Timeline ── */
  async function loadTimeline() {
    const container = document.getElementById("timeline-container");
    if (!container) return;
    try {
      const now = new Date().toISOString();
      const { data, error } = await supabase
        .from("events")
        .select("*")
        .gte("event_date", now)
        .order("event_date", { ascending: true })
        .limit(20);
      if (error) throw error;
      if (!data || data.length === 0) {
        container.innerHTML = '<div class="empty-state">No upcoming events.</div>';
        return;
      }
      container.innerHTML = data
        .map(
          (e, i) => `
        <div class="timeline-item" style="${i === 0 ? "border-left:3px solid var(--color-primary)" : ""}">
          <div class="timeline-date">${new Date(e.event_date).toLocaleDateString([], { month: "short", day: "numeric" })}</div>
          <div class="timeline-title">${escapeHtml(e.title)} ${e.is_pinned ? '<span class="material-symbols-outlined" style="font-size:16px;color:var(--color-primary);vertical-align:middle">keep</span>' : ""}</div>
          <div class="timeline-type">${escapeHtml(e.event_type || "")}</div>
          ${e.is_live ? '<span class="status-badge"><span class="status-dot approved"></span><span class="status-label approved">LIVE</span></span>' : ""}
          <button class="btn-neu btn-neu-sm" data-action="edit-timeline" data-id="${e.id}">Edit</button>
        </div>
      `
        )
        .join("");
      container.querySelectorAll("[data-action='edit-timeline']").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const id = btn.getAttribute("data-id");
          btn.disabled = false;
          document.querySelector('[data-tab="scheduler"]')?.classList.add("active");
          document.querySelector(".gov-tab.active")?.classList.remove("active");
          document.querySelector('[data-tab="scheduler"]')?.classList.add("active");
          document.querySelectorAll(".gov-panel").forEach((p) => p.classList.remove("active"));
          document.getElementById("panel-scheduler")?.classList.add("active");
          await loadEventIntoForm(id);
        });
      });
    } catch (err) {
      console.error("EventsDisp loadTimeline:", err);
      container.innerHTML = `<div class="error-state">Failed: ${errMsg(err)}</div>`;
    }
  }

  loadEvents();
  loadLiveEvents();
  loadTimeline();
</script>
