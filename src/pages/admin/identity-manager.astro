---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { createClient } from "../../lib/supabase";
import { requireAdmin } from "../../lib/admin-auth";

const supabase = createClient({ request: Astro.request, cookies: Astro.cookies });
const admin = await requireAdmin(supabase);
if (!admin) return Astro.redirect("/login");
---

<AdminLayout title="Identity Manager" activeTab="identity-manager">
  <h1>Global Identity &amp; Account Manager</h1>
  <p class="subtitle">Manage student identities, mentors, and validate achievements</p>

  <div class="gov-tabs">
    <button class="gov-tab active" data-tab="students">Student Directory</button>
    <button class="gov-tab" data-tab="mentors">Mentor Directory</button>
    <button class="gov-tab" data-tab="achievements">Achievement Validator</button>
  </div>

  <!-- Student Directory -->
  <div class="gov-panel active" id="panel-students">
    <div class="gov-toolbar">
      <div class="neu-input-wrap" style="flex:1;max-width:320px">
        <input type="text" id="student-search" placeholder="Search by name, SO ID, phone..." />
      </div>
      <button class="btn-neu btn-neu-sm" id="refresh-students"><span class="material-symbols-outlined" style="font-size:16px">refresh</span> Refresh</button>
    </div>
    <div id="students-container"><p class="loading">Loading student records...</p></div>
  </div>

  <!-- Mentor Directory -->
  <div class="gov-panel" id="panel-mentors">
    <div class="neu-card" style="margin-bottom:1rem">
      <form id="add-mentor-form" style="display:flex;gap:0.5rem;align-items:center">
        <div class="neu-input-wrap" style="flex:1">
          <input type="text" id="mentor-name" required placeholder="Mentor full name..." />
        </div>
        <button type="submit" class="btn-neu"><span class="material-symbols-outlined" style="font-size:16px">add</span> Add Mentor</button>
      </form>
      <p id="mentor-error" class="error-msg"></p>
    </div>
    <div id="mentors-container"><p class="loading">Loading mentors...</p></div>
  </div>

  <!-- Achievement Validator -->
  <div class="gov-panel" id="panel-achievements">
    <div class="gov-toolbar">
      <div class="neu-input-wrap" style="flex:1;max-width:320px">
        <input type="text" id="achievement-search" placeholder="Search by name or username..." />
      </div>
      <button class="btn-neu btn-neu-sm" id="refresh-achievements"><span class="material-symbols-outlined" style="font-size:16px">refresh</span> Refresh</button>
    </div>
    <div style="display:flex;gap:0.5rem;margin-bottom:1rem">
      <button class="gov-tab-slim active" data-ach-view="pending">Pending Submissions</button>
      <button class="gov-tab-slim" data-ach-view="all">All Milestones</button>
    </div>
    <div id="achievements-container"><p class="loading">Loading profiles...</p></div>
  </div>
</AdminLayout>

<!-- Verification Drawer (side panel) -->
<div id="verify-drawer" class="verify-drawer">
  <div class="verify-drawer-backdrop"></div>
  <div class="verify-drawer-panel">
    <button class="verify-drawer-close" id="verify-drawer-close"><span class="material-symbols-outlined">close</span></button>
    <h2 class="verify-drawer-title">Student Verification</h2>
    <div id="verify-drawer-body">
      <p class="loading">Loading...</p>
    </div>
  </div>
</div>

<style is:global>
  .gov-tabs { display:flex; gap:0; margin-bottom:1.5rem; box-shadow:var(--shadow-recessed); border-radius:var(--radius-xl); overflow:hidden; }
  .gov-tab { flex:1; padding:0.75rem 1rem; border:none; background:transparent; color:var(--color-on-surface-variant); font-family:var(--font-label); font-size:13px; font-weight:600; cursor:pointer; letter-spacing:0.03em; transition:all 0.15s; text-align:center; }
  .gov-tab.active { box-shadow:var(--shadow-extruded-sm); color:var(--color-primary); }
  .gov-tab:hover:not(.active) { color:var(--color-on-surface); }
  .gov-panel { display:none; }
  .gov-panel.active { display:block; }
  .gov-toolbar { display:flex; gap:0.5rem; align-items:center; margin-bottom:1rem; flex-wrap:wrap; }
  .gov-tab-slim { padding:0.4rem 1rem; border:none; background:transparent; color:var(--color-on-surface-variant); font-family:var(--font-label); font-size:12px; font-weight:600; cursor:pointer; letter-spacing:0.03em; transition:all 0.15s; border-radius:var(--radius-default); }
  .gov-tab-slim.active { box-shadow:var(--shadow-extruded-sm); color:var(--color-primary); }
  .gov-tab-slim:hover:not(.active) { color:var(--color-on-surface); }
  .ach-card { padding:1rem; margin-bottom:0.75rem; border-radius:var(--radius-md); box-shadow:var(--shadow-extruded-sm); }
  .ach-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem; }
  .ach-name { font-weight:600; font-size:15px; color:var(--color-on-surface); }
  .ach-meta { font-size:12px; color:var(--color-on-surface-variant); }
  .ach-milestones { display:flex; flex-direction:column; gap:0.35rem; }
  .milestone-row { display:flex; align-items:center; gap:0.5rem; padding:0.35rem 0.5rem; border-radius:var(--radius-sm); background:rgba(255,255,255,0.02); }
  .milestone-row.verified { opacity:0.7; }
  .milestone-idx { font-size:11px; font-weight:700; color:var(--color-on-surface-variant); min-width:24px; }
  .milestone-title { flex:1; font-size:13px; color:var(--color-on-surface); }
  /* Student directory */
  .sd-thumb { width:40px; height:48px; border-radius:var(--radius-sm); object-fit:cover; cursor:pointer; box-shadow:var(--shadow-extruded-sm); transition:transform 0.15s; display:block; }
  .sd-thumb:hover { transform:scale(1.1); }
  .sd-row { cursor:pointer; transition:background 0.1s; }
  .sd-row:hover { background:rgba(255,255,255,0.04); }
  /* Verification drawer */
  .verify-drawer { position:fixed; inset:0; z-index:1000; display:none; }
  .verify-drawer.open { display:block; }
  .verify-drawer-backdrop { position:absolute; inset:0; background:rgba(0,0,0,0.3); }
  .verify-drawer-panel { position:absolute; top:0; right:0; bottom:0; width:420px; max-width:100vw; background:var(--color-surface-container-low); box-shadow:var(--shadow-extruded); padding:1.5rem; overflow-y:auto; display:flex; flex-direction:column; }
  .verify-drawer-close { position:absolute; top:0.75rem; right:0.75rem; background:none; border:none; cursor:pointer; color:var(--color-on-surface-variant); padding:4px; border-radius:50%; }
  .verify-drawer-close:hover { background:rgba(0,0,0,0.05); }
  .verify-drawer-title { font-family:var(--font-headline); font-size:1.1rem; font-weight:700; margin-bottom:1.5rem; color:var(--color-on-surface); }
  .verify-field { margin-bottom:1rem; }
  .verify-field-label { font-size:0.75rem; font-weight:600; text-transform:uppercase; letter-spacing:0.05em; color:var(--color-on-surface-variant); margin-bottom:0.15rem; }
  .verify-field-value { font-size:0.95rem; color:var(--color-on-surface); font-weight:500; }
  .verify-photo { width:140px; height:168px; object-fit:cover; border-radius:var(--radius-default); box-shadow:var(--shadow-extruded-sm); margin-bottom:1rem; }
  .verify-drawer-actions { display:flex; gap:0.75rem; margin-top:auto; padding-top:1.5rem; border-top:1px solid rgba(0,0,0,0.06); }
  .verify-drawer-actions .btn-neu { flex:1; justify-content:center; }
  .verify-thumb-overlay { position:relative; display:inline-block; cursor:pointer; }
  .verify-thumb-overlay::after { content:'zoom_in'; font-family:'Material Symbols Outlined'; position:absolute; inset:0; display:flex; align-items:center; justify-content:center; background:rgba(0,0,0,0.3); color:#fff; font-size:24px; border-radius:var(--radius-sm); opacity:0; transition:opacity 0.15s; }
  .verify-thumb-overlay:hover::after { opacity:1; }
  /* Photo inspection modal */
  .photo-inspect { position:fixed; inset:0; z-index:1100; display:none; align-items:center; justify-content:center; background:rgba(0,0,0,0.7); }
  .photo-inspect.open { display:flex; }
  .photo-inspect img { max-width:90vw; max-height:90vh; border-radius:var(--radius-md); box-shadow:0 8px 32px rgba(0,0,0,0.3); }
  .photo-inspect-close { position:absolute; top:1rem; right:1rem; background:rgba(255,255,255,0.15); border:none; color:#fff; cursor:pointer; padding:8px; border-radius:50%; font-size:24px; }
</style>

<script>
  import { createBrowserClient } from "@supabase/ssr";
  function getSupabase() {
    return createBrowserClient(
      import.meta.env.PUBLIC_SUPABASE_URL,
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY
    );
  }
  function escapeHtml(str) {
    if (!str) return "";
    const d = document.createElement("div");
    d.textContent = str;
    return d.innerHTML;
  }
  function errMsg(err) {
    return err instanceof Error ? err.message : typeof err === "string" ? err : "Request failed. Check console for details.";
  }
  function dastharUrl(path) {
    if (!path) return "";
    if (path.startsWith("http")) return path;
    return getSupabase().storage.from("dasthar").getPublicUrl(path).data.publicUrl;
  }
  const supabase = getSupabase();
  let studentCache = [];

  document.querySelectorAll(".gov-tab").forEach((tab) => {
    tab.addEventListener("click", () => {
      document.querySelectorAll(".gov-tab").forEach((t) => t.classList.remove("active"));
      document.querySelectorAll(".gov-panel").forEach((p) => p.classList.remove("active"));
      tab.classList.add("active");
      document.getElementById("panel-" + tab.getAttribute("data-tab"))?.classList.add("active");
    });
  });

  /* ── Student Directory ── */
  async function loadStudents(filter) {
    const container = document.getElementById("students-container");
    if (!container) return;
    try {
      const { data, error } = await supabase
        .from("profiles")
        .select("id, so_id, username, display_name, legal_name, father_name, phone, dasthar_url, is_approved, created_at, campuses(name)")
        .order("created_at", { ascending: false });
      if (error) throw error;
      studentCache = data || [];
      renderStudents(filter || "");
    } catch (err) {
      console.error("StudentDirectory load:", err);
      container.innerHTML = `<div class="error-state">Failed to load: ${errMsg(err)}</div>`;
    }
  }

  function renderStudents(filter) {
    const container = document.getElementById("students-container");
    if (!container) return;
    let list = studentCache;
    if (filter) {
      const f = filter.toLowerCase();
      list = list.filter((p) =>
        (p.so_id || "").toLowerCase().includes(f) ||
        (p.legal_name || "").toLowerCase().includes(f) ||
        (p.display_name || "").toLowerCase().includes(f) ||
        (p.father_name || "").toLowerCase().includes(f) ||
        (p.phone || "").toLowerCase().includes(f) ||
        (p.username || "").toLowerCase().includes(f)
      );
    }
    if (list.length === 0) {
      container.innerHTML = '<div class="empty-state">No student records found.</div>';
      return;
    }
    container.innerHTML = `
      <div style="margin-bottom:0.5rem;font-size:12px;color:var(--color-on-surface-variant)">${list.length} student${list.length === 1 ? "" : "s"}</div>
      <div class="data-table-wrap">
        <table class="data-table">
          <thead><tr>
            <th>SO ID</th>
            <th>Legal Name</th>
            <th>Father's Name</th>
            <th>Phone</th>
            <th>Photo</th>
            <th>Campus</th>
            <th>Status</th>
          </tr></thead>
          <tbody>
            ${list.map((p) => `
              <tr class="sd-row" data-id="${p.id}">
                <td><code style="color:var(--color-primary);font-weight:600">${escapeHtml(p.so_id || "—")}</code></td>
                <td><strong>${escapeHtml(p.legal_name || p.display_name || p.username || "—")}</strong></td>
                <td>${escapeHtml(p.father_name || "—")}</td>
                <td>${escapeHtml(p.phone || "—")}</td>
                <td>${p.dasthar_url
                  ? `<div class="verify-thumb-overlay" data-dasthar="${escapeHtml(p.dasthar_url)}"><img src="${escapeHtml(dastharUrl(p.dasthar_url))}" class="sd-thumb" alt="Dasthar" /></div>`
                  : '<span style="color:var(--color-on-surface-variant);font-size:12px">—</span>'
                }</td>
                <td>${escapeHtml(p.campuses?.name || "—")}</td>
                <td>${p.is_approved
                  ? '<span style="color:#16a34a;font-size:12px;font-weight:600">Approved</span>'
                  : '<span style="color:#d97706;font-size:12px;font-weight:600">Pending</span>'
                }</td>
              </tr>
            `).join("")}
          </tbody>
        </table>
      </div>
    `;
    // Click row → open verification drawer
    container.querySelectorAll(".sd-row").forEach((row) => {
      row.addEventListener("click", () => {
        const id = row.getAttribute("data-id");
        const student = studentCache.find((s) => s.id === id);
        if (student) openVerifyDrawer(student);
      });
    });
    // Photo overlay click → open inspection modal
    container.querySelectorAll(".verify-thumb-overlay").forEach((el) => {
      el.addEventListener("click", (e) => {
        e.stopPropagation();
        const path = el.getAttribute("data-dasthar");
        openPhotoInspect(dastharUrl(path));
      });
    });
  }

  document.getElementById("student-search")?.addEventListener("input", (e) => {
    renderStudents(e.target.value);
  });
  document.getElementById("refresh-students")?.addEventListener("click", () => loadStudents(""));

  /* ── Verification Drawer ── */
  function openVerifyDrawer(student) {
    const drawer = document.getElementById("verify-drawer");
    const body = document.getElementById("verify-drawer-body");
    if (!drawer || !body) return;
    const photoUrl = student.dasthar_url ? dastharUrl(student.dasthar_url) : "";
    const fullName = escapeHtml(student.legal_name || student.display_name || student.username || "—");
    const fatherName = escapeHtml(student.father_name || "—");
    const email = "—";
    const phone = escapeHtml(student.phone || "—");
    const soId = escapeHtml(student.so_id || "—");
    body.innerHTML = `
      ${photoUrl ? `<img src="${photoUrl}" class="verify-photo" alt="Dasthar" />` : '<div style="width:140px;height:168px;border-radius:var(--radius-default);box-shadow:var(--shadow-extruded-sm);margin-bottom:1rem;display:flex;align-items:center;justify-content:center;background:var(--color-neu-base);color:var(--color-on-surface-variant)"><span class="material-symbols-outlined" style="font-size:40px">person</span></div>'}
      <div class="verify-field">
        <div class="verify-field-label">Science Orbit ID</div>
        <div class="verify-field-value"><code style="color:var(--color-primary)">${soId}</code></div>
      </div>
      <div class="verify-field">
        <div class="verify-field-label">Full Name</div>
        <div class="verify-field-value">${fullName}</div>
      </div>
      <div class="verify-field">
        <div class="verify-field-label">Father's Name</div>
        <div class="verify-field-value">${fatherName}</div>
      </div>
      <div class="verify-field">
        <div class="verify-field-label">Email ID</div>
        <div class="verify-field-value">${email}</div>
      </div>
      <div class="verify-field">
        <div class="verify-field-label">Phone No</div>
        <div class="verify-field-value">${phone}</div>
      </div>
      <div class="verify-drawer-actions">
        <button class="btn-neu" id="verify-approve" data-id="${student.id}"><span class="material-symbols-outlined" style="font-size:16px">check_circle</span> ${student.is_approved ? "Already Approved" : "Approve Account &amp; Verify ID"}</button>
        <button class="btn-neu danger" id="verify-reject" data-id="${student.id}"><span class="material-symbols-outlined" style="font-size:16px">cancel</span> Reject Submission</button>
      </div>
    `;
    drawer.classList.add("open");

    // Approve handler
    const approveBtn = document.getElementById("verify-approve");
    if (approveBtn && !student.is_approved) {
      approveBtn.addEventListener("click", async () => {
        approveBtn.disabled = true;
        approveBtn.textContent = "Approving...";
        try {
          const { error } = await supabase
            .from("profiles")
            .update({ is_approved: true })
            .eq("id", student.id);
          if (error) throw error;
          student.is_approved = true;
          approveBtn.textContent = "Approved ✓";
          approveBtn.style.color = "#16a34a";
          loadStudents(document.getElementById("student-search")?.value || "");
        } catch (err) {
          console.error("VerifyDrawer approve:", err);
          approveBtn.disabled = false;
          approveBtn.textContent = "Approve Account & Verify ID";
          alert("Failed: " + errMsg(err));
        }
      });
    }

    // Reject handler
    const rejectBtn = document.getElementById("verify-reject");
    if (rejectBtn) {
      rejectBtn.addEventListener("click", async () => {
        if (!confirm(`Reject registration for ${escapeHtml(student.legal_name || student.username)}? This will clear the entry.`)) return;
        rejectBtn.disabled = true;
        rejectBtn.textContent = "Rejecting...";
        try {
          // Delete dasthar photo if exists
          if (student.dasthar_url) {
            await supabase.storage.from("dasthar").remove([student.dasthar_url]);
          }
          // Delete the auth user (cascades to profile)
          const { error } = await supabase.rpc("delete_user", { user_id: student.id });
          if (error) {
            // Fallback: just clear profile data
            await supabase.from("profiles").delete().eq("id", student.id);
          }
          drawer.classList.remove("open");
          loadStudents(document.getElementById("student-search")?.value || "");
        } catch (err) {
          console.error("VerifyDrawer reject:", err);
          rejectBtn.disabled = false;
          rejectBtn.textContent = "Reject Submission";
          alert("Failed: " + errMsg(err));
        }
      });
    }
  }

  // Close drawer
  document.getElementById("verify-drawer-close")?.addEventListener("click", () => {
    document.getElementById("verify-drawer")?.classList.remove("open");
  });
  document.querySelector(".verify-drawer-backdrop")?.addEventListener("click", () => {
    document.getElementById("verify-drawer")?.classList.remove("open");
  });

  /* ── Photo Inspection Modal ── */
  function openPhotoInspect(url) {
    let modal = document.getElementById("photo-inspect-modal");
    if (!modal) {
      modal = document.createElement("div");
      modal.id = "photo-inspect-modal";
      modal.className = "photo-inspect";
      modal.innerHTML = `<button class="photo-inspect-close" id="photo-inspect-close"><span class="material-symbols-outlined">close</span></button><img src="" alt="Dasthar full" />`;
      document.body.appendChild(modal);
      document.getElementById("photo-inspect-close")?.addEventListener("click", () => modal.classList.remove("open"));
      modal.addEventListener("click", (e) => { if (e.target === modal) modal.classList.remove("open"); });
    }
    modal.querySelector("img").src = url;
    modal.classList.add("open");
  }

  /* ── Mentors ── */
  async function loadMentors() {
    const container = document.getElementById("mentors-container");
    if (!container) return;
    try {
      const { data, error } = await supabase
        .from("mentors")
        .select("*")
        .order("name");
      if (error) throw error;
      if (!data || data.length === 0) {
        container.innerHTML = '<div class="empty-state">No mentors registered yet.</div>';
        return;
      }
      container.innerHTML = `
        <div class="data-table-wrap">
          <table class="data-table">
            <thead><tr><th>Name</th><th>Created</th><th>Action</th></tr></thead>
            <tbody>
              ${data
                .map(
                  (m) => `
                <tr>
                  <td><strong>${escapeHtml(m.name)}</strong></td>
                  <td>${new Date(m.created_at).toLocaleDateString()}</td>
                  <td><button class="btn-neu btn-neu-sm danger" data-id="${m.id}" data-name="${escapeHtml(m.name)}">Delete</button></td>
                </tr>
              `
                )
                .join("")}
            </tbody>
          </table>
        </div>
      `;
      container.querySelectorAll(".btn-neu.danger").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const name = btn.getAttribute("data-name");
          if (!confirm(`Delete mentor "${name}"? This may affect student profiles.`)) return;
          const id = btn.getAttribute("data-id");
          btn.disabled = true;
          btn.textContent = "Deleting...";
          try {
            const { error } = await supabase.from("mentors").delete().eq("id", id);
            if (error) throw error;
            btn.closest("tr")?.remove();
            const tbody = container.querySelector("tbody");
            if (tbody && tbody.children.length === 0) {
              container.innerHTML = '<div class="empty-state">No mentors registered yet.</div>';
            }
          } catch (err) {
            console.error("IdentityManager mentorDelete:", err);
            btn.disabled = false;
            btn.textContent = "Delete";
            alert("Failed: " + errMsg(err));
          }
        });
      });
    } catch (err) {
      console.error("IdentityManager loadMentors:", err);
      container.innerHTML = `<div class="error-state">Failed to load: ${errMsg(err)}</div>`;
    }
  }

  document.getElementById("add-mentor-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const input = document.getElementById("mentor-name");
    const errorEl = document.getElementById("mentor-error");
    if (!input || !errorEl) return;
    errorEl.textContent = "";
    const name = input.value.trim();
    if (!name) return;
    input.disabled = true;
    try {
      const { error } = await supabase.from("mentors").insert({ name });
      if (error) throw error;
      input.value = "";
      loadMentors();
    } catch (err) {
      console.error("IdentityManager addMentor:", err);
      errorEl.textContent = errMsg(err);
    } finally {
      input.disabled = false;
      input.focus();
    }
  });

  /* ── Achievements ── */
  let achCache = [];
  let achView = "pending";

  document.querySelectorAll("[data-ach-view]").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll("[data-ach-view]").forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      achView = btn.getAttribute("data-ach-view");
      renderAchievements(document.getElementById("achievement-search")?.value || "");
    });
  });

  async function loadAchievements() {
    const container = document.getElementById("achievements-container");
    if (!container) return;
    try {
      const { data: profiles, error: pErr } = await supabase
        .from("profiles")
        .select("id, username, display_name, legal_name, milestones, campuses(name)")
        .not("milestones", "eq", "[]")
        .order("created_at", { ascending: false });
      if (pErr) throw pErr;

      const { data: verifications, error: vErr } = await supabase
        .from("achievement_verifications")
        .select("*");
      if (vErr) throw vErr;

      achCache = { profiles: profiles || [], verifications: verifications || [] };
      renderAchievements("");
    } catch (err) {
      console.error("IdentityManager loadAchievements:", err);
      container.innerHTML = `<div class="error-state">Failed to load: ${errMsg(err)}</div>`;
    }
  }

  function renderAchievements(filter) {
    const container = document.getElementById("achievements-container");
    if (!container) return;
    const { profiles, verifications } = achCache;
    if (!profiles || profiles.length === 0) {
      container.innerHTML = '<div class="empty-state">No profiles with milestones found.</div>';
      return;
    }

    const filtered = filter
      ? profiles.filter(
          (p) =>
            (p.display_name || p.username || "").toLowerCase().includes(filter.toLowerCase()) ||
            (p.legal_name || "").toLowerCase().includes(filter.toLowerCase())
        )
      : profiles;

    const allRows = [];
    for (const p of filtered) {
      const milestones = Array.isArray(p.milestones) ? p.milestones : [];
      for (let i = 0; i < milestones.length; i++) {
        const m = milestones[i];
        const v = (verifications || []).find(
          (v) => v.profile_id === p.id && v.milestone_index === i
        );
        const isVerified = v?.is_verified || false;
        if (achView === "pending" && isVerified) continue;
        allRows.push({
          profileId: p.id,
          username: p.username || "—",
          displayName: p.display_name || p.legal_name || p.username || "Unknown",
          campus: p.campuses?.name || "—",
          idx: i,
          title: m.title || "Milestone " + (i + 1),
          credentialUrl: m.credential_url || "",
          isVerified,
          verifiedAt: v?.verified_at || null,
        });
      }
    }

    if (allRows.length === 0) {
      const msg = achView === "pending"
        ? "No pending submissions. All milestones verified."
        : "No milestones found.";
      container.innerHTML = `<div class="empty-state">${msg}</div>`;
      return;
    }

    container.innerHTML = `
      <div style="margin-bottom:0.5rem;font-size:12px;color:var(--color-on-surface-variant)">${allRows.length} submission${allRows.length === 1 ? "" : "s"}</div>
      <div class="data-table-wrap">
        <table class="data-table">
          <thead><tr>
            <th>Student ID</th>
            <th>Name</th>
            <th>Milestone</th>
            <th>Proof</th>
            <th>Status</th>
            <th>Action</th>
          </tr></thead>
          <tbody>
            ${allRows.map((r) => `
              <tr>
                <td><code style="color:var(--color-primary)">${escapeHtml(r.username)}</code></td>
                <td><strong>${escapeHtml(r.displayName)}</strong></td>
                <td>${escapeHtml(r.title)}</td>
                <td>${r.credentialUrl
                  ? `<a href="${escapeHtml(r.credentialUrl)}" target="_blank" class="btn-neu btn-neu-sm" style="text-decoration:none;font-size:11px"><span class="material-symbols-outlined" style="font-size:14px">open_in_new</span> View</a>`
                  : '<span style="color:var(--color-on-surface-variant);font-size:12px">No proof</span>'
                }</td>
                <td>
                  <span class="status-badge">
                    <span class="status-dot ${r.isVerified ? "approved" : "pending"}"></span>
                    <span class="status-label ${r.isVerified ? "approved" : "pending"}">${r.isVerified ? "Verified" : "Pending"}</span>
                  </span>
                  ${r.verifiedAt ? `<br><small style="font-size:10px;color:var(--color-on-surface-variant)">${new Date(r.verifiedAt).toLocaleDateString()}</small>` : ""}
                </td>
                <td>
                  <div style="display:flex;gap:0.35rem">
                    ${!r.isVerified
                      ? `<button class="btn-neu btn-neu-sm" data-action="approve" data-profile="${r.profileId}" data-idx="${r.idx}">Approve &amp; Sign</button>`
                      : `<button class="btn-neu btn-neu-sm danger" data-action="revoke" data-profile="${r.profileId}" data-idx="${r.idx}">Revoke</button>`
                    }
                  </div>
                </td>
              </tr>
            `).join("")}
          </tbody>
        </table>
      </div>
    `;

    container.querySelectorAll("[data-action]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const action = btn.getAttribute("data-action");
        const profileId = btn.getAttribute("data-profile");
        const idx = parseInt(btn.getAttribute("data-idx"));
        btn.disabled = true;
        try {
          const { data: userData } = await supabase.auth.getUser();
          const adminId = userData?.user?.id;
          if (action === "revoke") {
            await supabase
              .from("achievement_verifications")
              .delete()
              .eq("profile_id", profileId)
              .eq("milestone_index", idx);
          } else {
            await supabase.from("achievement_verifications").upsert({
              profile_id: profileId,
              milestone_index: idx,
              is_verified: true,
              verified_by: adminId,
              verified_at: new Date().toISOString(),
            }, { onConflict: "profile_id, milestone_index" });
          }
          loadAchievements();
        } catch (err) {
          console.error("IdentityManager verify action:", err);
          btn.disabled = false;
          alert("Failed: " + errMsg(err));
        }
      });
    });
  }

  document.getElementById("achievement-search")?.addEventListener("input", (e) => {
    renderAchievements(e.target.value);
  });
  document.getElementById("refresh-achievements")?.addEventListener("click", loadAchievements);

  loadStudents("");
  loadMentors();
  loadAchievements();
</script>
