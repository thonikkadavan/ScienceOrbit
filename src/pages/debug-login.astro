---
let result = "ok";
let stack = "";
try {
  const { createClient } = await import("../lib/supabase");
  result += " | imported createClient";
  const supabase = createClient({ request: Astro.request, cookies: Astro.cookies });
  result += " | createClient ok";
  const { data: { user } } = await supabase.auth.getUser();
  result += " | getUser done";
  const { data: rpcResult, error: rpcErr } = await supabase.rpc("lookup_username_email", { p_username: "mdjtk" });
  result += " | rpc done: " + (rpcResult ?? "null") + (rpcErr ? " err=" + rpcErr.message : "");
} catch (e: any) {
  result = "EXN: " + (e?.message ?? String(e));
  stack = e?.stack ?? "";
}
---
<html><body>
<pre>{result}</pre>
{stack && <pre style="white-space:pre-wrap;font-size:11px">{stack}</pre>}
</body></html>
