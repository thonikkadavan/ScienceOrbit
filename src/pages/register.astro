---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Register">
  <div class="auth-page">
    <div class="auth-card">
      <div class="auth-card-inner">
        <h1>Create Account</h1>
        <p class="auth-subtitle">Join Science Orbit</p>
        <form id="register-form" class="auth-form">
          <div class="form-group">
            <label for="username">Username</label>
            <input
              type="text"
              id="username"
              required
              placeholder="your-username"
              title="Letters, numbers, hyphens, and underscores only"
            />
          </div>
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" required placeholder="you@example.com" />
          </div>
          <div class="form-group">
            <label for="full-name">Full Name</label>
            <input type="text" id="full-name" required placeholder="Enter your full legal name" />
          </div>
          <div class="form-group">
            <label for="father-name">Father's Name</label>
            <input type="text" id="father-name" required placeholder="Enter your father's name" />
          </div>
          <div class="form-group">
            <label for="phone">Phone No</label>
            <input type="tel" id="phone" required placeholder="Enter your phone number" title="Phone number (digits, +, -, spaces, parentheses only)" />
          </div>
          <div class="form-group">
            <label for="academic-tier">Academic Tier</label>
            <select id="academic-tier" required>
              <option value="">— Select your tier —</option>
              <option value="JUNIOR">Junior</option>
              <option value="FOUNDATION">Foundation</option>
              <option value="UG">UG (Undergraduate)</option>
              <option value="PG">PG (Postgraduate)</option>
              <option value="PHD">PhD (Doctorate)</option>
            </select>
          </div>
          <div class="form-group" id="tier-campus-group" style="display:none">
            <label for="tier-campus">Campus</label>
            <select id="tier-campus" required></select>
          </div>
          <div class="form-group" id="course-group" style="display:none">
            <label for="course-name">Course Name / Subject</label>
            <input type="text" id="course-name" placeholder="e.g. BSc Physics, MA History, PhD Computer Science" />
          </div>
          <div class="form-group">
            <label for="dasthar">Photo (Dasthar)</label>
            <input type="file" id="dasthar" accept="image/jpeg,image/png,image/webp" required />
            <div id="dasthar-preview" class="dasthar-preview"></div>
            <small style="color:var(--color-on-surface-variant);font-size:0.75rem">JPEG, PNG, or WebP. Max 5MB. Passport-style photo recommended.</small>
          </div>
          <div class="form-group">
            <label for="password">Password</label>
            <input
              type="password"
              id="password"
              required
              minlength="6"
              placeholder="At least 6 characters"
            />
          </div>
          <p id="error-msg" class="error-msg"></p>
          <button type="submit" class="btn-primary" id="submit-btn">
            Create Account
          </button>
        </form>
        <p class="auth-footer">
          Already have an account? <a href="/login">Sign in</a>
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { createBrowserClient } from "@supabase/ssr";

  // Hardcoded campus lookup arrays per tier
  const JUNIOR_CAMPUSES = ["Baithul Izza", "Hasaniyya", "Hasanul Basari", "Dunnurain", "Al Munavvara"];
  const FOUNDATION_CAMPUSES = ["Baithul Izza", "Isra", "Qadariyya", "Tharbiyath", "Miraj"];

  // Dasthar photo preview
  const dastharInput = document.getElementById("dasthar");
  const dastharPreview = document.getElementById("dasthar-preview");
  dastharInput?.addEventListener("change", () => {
    const file = dastharInput.files?.[0];
    if (!file) { dastharPreview.innerHTML = ""; return; }
    if (file.size > 5 * 1024 * 1024) {
      dastharPreview.innerHTML = '<span style="color:var(--color-error);font-size:0.8rem">File too large. Max 5MB.</span>';
      dastharInput.value = "";
      return;
    }
    const reader = new FileReader();
    reader.onload = (e) => {
      dastharPreview.innerHTML = `<img src="${e.target.result}" class="dasthar-preview-img" />`;
    };
    reader.readAsDataURL(file);
  });

  // Academic tier → conditional campus/course fields
  const tierSelect = document.getElementById("academic-tier");
  const tierCampusGroup = document.getElementById("tier-campus-group");
  const tierCampusSelect = document.getElementById("tier-campus");
  const courseGroup = document.getElementById("course-group");

  tierSelect?.addEventListener("change", () => {
    const tier = tierSelect.value;
    tierCampusGroup.style.display = "none";
    courseGroup.style.display = "none";
    tierCampusSelect.innerHTML = "";

    if (tier === "JUNIOR") {
      JUNIOR_CAMPUSES.forEach((c) => {
        const opt = document.createElement("option");
        opt.value = c; opt.textContent = c;
        tierCampusSelect.appendChild(opt);
      });
      tierCampusSelect.required = true;
      tierCampusGroup.style.display = "block";
    } else if (tier === "FOUNDATION") {
      FOUNDATION_CAMPUSES.forEach((c) => {
        const opt = document.createElement("option");
        opt.value = c; opt.textContent = c;
        tierCampusSelect.appendChild(opt);
      });
      tierCampusSelect.required = true;
      tierCampusGroup.style.display = "block";
    } else if (["UG", "PG", "PHD"].includes(tier)) {
      document.getElementById("course-name").required = true;
      courseGroup.style.display = "block";
    }
  });

  const form = document.getElementById("register-form");
  const errorMsg = document.getElementById("error-msg");
  const submitBtn = document.getElementById("submit-btn");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorMsg.textContent = "";
    submitBtn.disabled = true;
    submitBtn.textContent = "Creating account...";

    const username = document.getElementById("username").value.trim();
    const email = document.getElementById("email").value.trim();
    const password = document.getElementById("password").value;
    const fullName = document.getElementById("full-name").value.trim();
    const fatherName = document.getElementById("father-name").value.trim();
    const phone = document.getElementById("phone").value.trim();
    const academicTier = document.getElementById("academic-tier").value;
    const campusName = document.getElementById("tier-campus").value;
    const courseName = document.getElementById("course-name").value.trim();
    const dastharFile = dastharInput?.files?.[0];

    if (!/^[a-zA-Z0-9_-]+$/.test(username)) {
      errorMsg.textContent = "Username: letters, numbers, hyphens, and underscores only.";
      submitBtn.disabled = false;
      submitBtn.textContent = "Create Account";
      return;
    }

    if (fullName.length < 2) {
      errorMsg.textContent = "Please enter your full legal name.";
      submitBtn.disabled = false;
      submitBtn.textContent = "Create Account";
      return;
    }

    if (!academicTier) {
      errorMsg.textContent = "Please select your academic tier.";
      submitBtn.disabled = false;
      submitBtn.textContent = "Create Account";
      return;
    }

    if (dastharFile && dastharFile.size > 5 * 1024 * 1024) {
      errorMsg.textContent = "Photo exceeds 5MB limit.";
      submitBtn.disabled = false;
      submitBtn.textContent = "Create Account";
      return;
    }

    try {
      const supabase = createBrowserClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY
      );

      const meta = {
        username,
        legal_name: fullName,
        father_name: fatherName,
        phone,
        academic_tier: academicTier,
        campus_name: campusName || "",
        course_name: courseName || "",
      };

      const { data: signUpData, error: signUpError } = await supabase.auth.signUp({
        email,
        password,
        options: { data: meta },
      });

      if (signUpError) throw signUpError;

      const userId = signUpData?.user?.id;
      if (!userId) throw new Error("Sign-up succeeded but no user ID returned.");

      // Establish session if available (auto-confirm on)
      if (signUpData.session) {
        await supabase.auth.setSession(signUpData.session);
      }

      // Look up campus_id and update profile with academic fields
      if (signUpData.session && campusName) {
        const { data: campuses } = await supabase
          .from("campuses")
          .select("id")
          .eq("name", campusName)
          .single();
        if (campuses) {
          await supabase.from("profiles").update({
            campus_id: campuses.id,
            academic_tier: academicTier,
            course_name: courseName || null,
          }).eq("id", userId);
        }
      } else if (signUpData.session && ["UG", "PG", "PHD"].includes(academicTier)) {
        await supabase.from("profiles").update({
          academic_tier: academicTier,
          course_name: courseName || null,
        }).eq("id", userId);
      }

      // Upload dasthar photo (only possible if session exists)
      if (dastharFile && signUpData.session) {
        const ext = dastharFile.name.split(".").pop() || "jpg";
        const filePath = `${userId}/dasthar.${ext}`;
        const { error: uploadErr } = await supabase.storage
          .from("dasthar")
          .upload(filePath, dastharFile, { upsert: true, contentType: dastharFile.type });
        if (uploadErr) throw uploadErr;

        const { error: updateErr } = await supabase
          .from("profiles")
          .update({ dasthar_url: filePath })
          .eq("id", userId);

        if (updateErr) console.error("Dasthar URL update:", updateErr);
      }

      window.location.href = "/dashboard/feed";
    } catch (err) {
      errorMsg.textContent = err.message || "Registration failed.";
      submitBtn.disabled = false;
      submitBtn.textContent = "Create Account";
    }
  });
</script>

<style is:global>
  .auth-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 2rem;
    background: var(--color-neu-base);
  }

  .auth-card {
    width: 100%;
    max-width: 420px;
    padding: 2px;
  }

  .auth-card-inner {
    background: var(--color-surface-container-low);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    box-shadow: var(--shadow-extruded);
  }

  .auth-card h1 {
    font-family: var(--font-headline);
    font-size: 1.75rem;
    margin-bottom: 0.25rem;
  }

  .auth-subtitle {
    color: var(--color-on-surface-variant);
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-group label {
    font-family: var(--font-label);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-on-surface-variant);
  }

  .form-group input {
    padding: 0.75rem 1rem;
    border: none;
    border-radius: var(--radius-default);
    font-size: 0.95rem;
    outline: none;
    background: var(--color-neu-base);
    box-shadow: var(--shadow-recessed);
    transition: box-shadow 0.15s;
  }

  .form-group input:focus {
    box-shadow: var(--shadow-recessed), 0 0 0 2px var(--color-primary-container);
  }

  .form-group input::placeholder {
    color: var(--color-outline);
  }

  .form-group select {
    padding: 0.75rem 1rem;
    border: none;
    border-radius: var(--radius-default);
    font-size: 0.95rem;
    outline: none;
    background: var(--color-neu-base);
    box-shadow: var(--shadow-recessed);
    transition: box-shadow 0.15s;
    font-family: inherit;
    cursor: pointer;
    appearance: auto;
  }

  .form-group select:focus {
    box-shadow: var(--shadow-recessed), 0 0 0 2px var(--color-primary-container);
  }

  .error-msg {
    color: var(--color-error);
    font-size: 0.85rem;
    min-height: 1.25rem;
  }

  .btn-primary {
    background: var(--color-neu-base);
    color: var(--color-primary);
    padding: 0.75rem;
    border: none;
    border-radius: var(--radius-default);
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 1rem;
    box-shadow: var(--shadow-extruded);
    transition: all 0.15s;
    letter-spacing: 0.02em;
  }

  .btn-primary:hover:not(:disabled) {
    box-shadow: var(--shadow-extruded-hover);
    color: var(--color-primary);
  }

  .btn-primary:active:not(:disabled) {
    box-shadow: var(--shadow-recessed);
  }

  .btn-primary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .auth-footer {
    margin-top: 1.5rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--color-on-surface-variant);
  }
  .dasthar-preview {
    margin-top: 0.5rem;
  }
  .dasthar-preview-img {
    width: 100px;
    height: 120px;
    object-fit: cover;
    border-radius: var(--radius-default);
    box-shadow: var(--shadow-extruded-sm);
  }
</style>
