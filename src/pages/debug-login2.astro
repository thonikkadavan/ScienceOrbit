---
import BaseLayout from "../layouts/BaseLayout.astro";
import { createClient } from "../lib/supabase";

let result = "waiting";
if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const login = formData.get("login")?.toString() ?? "";
    const password = formData.get("password")?.toString() ?? "";

    if (!login || !password) { result = "missing fields"; }
    else {
      const supabase = createClient({ request: Astro.request, cookies: Astro.cookies });
      let email = login;
      if (!login.includes("@")) {
        const { data: emailResult } = await supabase.rpc("lookup_username_email", { p_username: login });
        if (!emailResult) { result = "no email found for " + login; }
        else { email = emailResult; }
      }
      if (email) {
        const { error } = await supabase.auth.signInWithPassword({ email, password });
        result = error ? "signin err: " + error.message : "signin OK!";
      }
    }
  } catch (e: any) {
    result = "EXN: " + (e?.message ?? String(e));
  }
}
---
<BaseLayout title="Debug Login2">
  <form method="POST">
    <input name="login" placeholder="login" />
    <input name="password" type="password" placeholder="password" />
    <button type="submit">Submit</button>
  </form>
  <pre>{result}</pre>
</BaseLayout>
