---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DashboardSidebar from "../../components/DashboardSidebar.astro";
import { createClient } from "../../lib/supabase";
import { getProfile } from "../../lib/auth";
import type { Campus, Subject, Mentor } from "../../types/database";

const supabase = createClient({ request: Astro.request, cookies: Astro.cookies });
const profile = await getProfile(supabase);

if (!profile) {
  return Astro.redirect("/login");
}

const campuses = (
  await supabase.from("campuses").select("*").order("name")
).data as Campus[] | null;

const subjects = (
  await supabase.from("subjects").select("*").order("name")
).data as Subject[] | null;

const mentors = (
  await supabase.from("mentors").select("*").order("name")
).data as Mentor[] | null;

const avatarUrl = profile.avatar_url
  ? supabase.storage.from("avatars").getPublicUrl(profile.avatar_url).data.publicUrl
  : null;
const avatarTag = avatarUrl
  ? `<img src="${avatarUrl}" alt="" class="mob-avatar-img" id="mob-avatar-img" />`
  : `<div class="mob-avatar-placeholder" id="mob-avatar-placeholder"><span class="material-symbols-outlined">person</span></div>`;
const previewAvatarTag = avatarUrl
  ? `<img src="${avatarUrl}" alt="Profile" class="preview-avatar-img" />`
  : `<span class="material-symbols-outlined preview-avatar-icon">person</span>`;

const campusName = campuses?.find((c) => c.id === profile.campus_id)?.name ?? "";
const profileSubjects = profile.subjects ?? [];
const techStack: string[] = profile.tech_stack || [];
let milestones: { title: string; issuer: string; url: string }[] = [];
try {
  milestones = typeof profile.milestones === "string" ? JSON.parse(profile.milestones) : (profile.milestones || []);
} catch { milestones = []; }
const commonTechTags = ["JavaScript","TypeScript","Python","React","Vue","Angular","Svelte","Astro","Node.js","Next.js","Tailwind CSS","Supabase","PostgreSQL","Git","Docker","TensorFlow","PyTorch","Rust","Go","C++","Java","R","MATLAB","Julia","GraphQL","REST","Prisma","Drizzle","Laravel","Django","Flask","FastAPI"];

const socialPlatforms = ["GitHub","LinkedIn","X / Twitter","Instagram","Discord","YouTube","TikTok","Snapchat","Facebook","Reddit","Threads","Bluesky","Mastodon","WhatsApp","Telegram","Signal","Slack","Medium","Dev.to","Hashnode","Stack Overflow","ResearchGate","Google Scholar","ORCID","Academia.edu"];

const socialLinks: { platform: string; value: string }[] = [];
try {
  socialLinks.splice(0, socialLinks.length, ...(typeof profile.social_links === "string" ? JSON.parse(profile.social_links) : (profile.social_links || [])));
} catch {}
---

<BaseLayout title="Student Profile Editor">
  <DashboardSidebar current="edit" />
  <div class="ed-root">
    <main class="ed-main">
      {!profile.is_approved ? (
        <div class="approval-card">
          <div class="approval-card-inner">
            <h2>Account Created</h2>
            <p>Your account is awaiting admin approval. You'll get access to edit your profile as soon as an administrator approves your account.</p>
          </div>
        </div>
      ) : (
        <div class="split-layout">
          <!-- Left: Public Preview -->
          <section class="preview-col">
            <div class="preview-header">
              <h2>Public Preview</h2>
              <p class="preview-subtitle">This is how your profile appears to researchers and peers.</p>
            </div>
            <div class="preview-card">
              <div class="preview-card-bg"></div>
              <div class="preview-avatar-wrap">
                <div class="preview-avatar">
                  {avatarUrl ? (
                    <img src={avatarUrl} alt="Profile" />
                  ) : (
                    <span class="material-symbols-outlined preview-avatar-icon">person</span>
                  )}
                </div>
              </div>
              <h3 class="preview-name">{profile.display_name || profile.username}</h3>
              <p class="preview-title">{profile.mentors?.name || profile.mentor_name || "Student"}</p>
              <div class="preview-details">
                <div class="preview-detail-box">
                  <span class="preview-detail-label">Campus Affiliation</span>
                  <span class="preview-detail-value">
                    <span class="material-symbols-outlined preview-detail-icon">school</span>
                    {campusName || "Not set"}
                  </span>
                </div>
                <div class="preview-detail-box">
                  <span class="preview-detail-label">Academic Subjects</span>
                  <span class="preview-detail-value">
                    <span class="material-symbols-outlined preview-detail-icon">menu_book</span>
                    <span id="preview-subjects">{profileSubjects.length ? profileSubjects.join(", ") : "None selected"}</span>
                  </span>
                </div>
                <div class="preview-detail-box">
                  <span class="preview-detail-label">Achievements</span>
                  <span class="preview-detail-value" style="align-items: flex-start;">
                    <span class="material-symbols-outlined preview-detail-icon" style="margin-top:2px">emoji_events</span>
                    <span class="preview-achievements-text">{profile.achievements ? profile.achievements.split("\n").filter(Boolean).length + " milestone(s)" : "None listed"}</span>
                  </span>
                </div>
                {profile.biography && profile.biography.trim() && (
                  <div class="preview-detail-box">
                    <span class="preview-detail-label">Biography</span>
                    <span class="preview-detail-value" style="align-items: flex-start;">
                      <span class="material-symbols-outlined preview-detail-icon" style="margin-top:2px">fingerprint</span>
                      <span class="preview-bio-text">{profile.biography}</span>
                    </span>
                  </div>
                )}
                <div class="preview-detail-box">
                  <span class="preview-detail-label">Current Project</span>
                  <span class="preview-detail-value" style="flex-direction:column;align-items:flex-start;gap:0.25rem;">
                    <span class="preview-detail-value">
                      <span class="material-symbols-outlined preview-detail-icon">science</span>
                      <span id="preview-project-title">{profile.project_title || "No project set"}</span>
                    </span>
                    {profile.project_progress > 0 && (
                      <span class="preview-project-progress">Progress: {profile.project_progress}%</span>
                    )}
                  </span>
                </div>
              </div>
            </div>
          </section>

          <!-- Right: Editor -->
          <section class="editor-col">
            <!-- Mobile profile card (shown only on mobile) -->
            <div class="mob-profile-card">
              <div class="mob-avatar-wrap" id="mob-avatar-trigger">
                {avatarUrl ? (
                  <img src={avatarUrl} alt="" class="mob-avatar-img" id="mob-avatar-img" />
                ) : (
                  <div class="mob-avatar-placeholder" id="mob-avatar-placeholder">
                    <span class="material-symbols-outlined">person</span>
                  </div>
                )}
                <div class="mob-camera-badge">
                  <span class="material-symbols-outlined mob-camera-icon">photo_camera</span>
                </div>
              </div>
              <h2 class="mob-name">{profile.display_name || profile.username}</h2>
              <p class="mob-title">{profile.mentors?.name || profile.mentor_name || "Student"}</p>
              <div class="mob-campus-row">
                <span class="material-symbols-outlined mob-campus-icon">school</span>
                <span class="mob-campus-text">{campusName || "No campus"}</span>
              </div>
            </div>

            <div class="editor-header">
              <h1>Edit Portfolio</h1>
              <p class="editor-subtitle">Update your academic details.</p>
            </div>

            <div class="editor-card">
              <form id="profile-form" class="editor-form">
                <div class="form-group">
                  <label for="display_name">Full Name</label>
                  <input type="text" id="display_name" class="neu-input" placeholder="Enter your full name" value={profile.display_name || ""} />
                </div>

                <div class="form-group">
                  <label for="campus_id">Campus / Institution</label>
                  <div class="neu-input-wrap">
                    <span class="material-symbols-outlined neu-input-icon">search</span>
                    <select id="campus_id" class="neu-input neu-input-iconed">
                      <option value="">Select campus...</option>
                      {campuses?.map((c) => (
                        <option value={c.id} selected={profile.campus_id === c.id}>{c.name}</option>
                      ))}
                    </select>
                  </div>
                </div>

                <div class="form-group">
                  <label for="mentor_name">Current Major / Focus</label>
                  <div class="neu-input-wrap">
                    <input type="text" id="mentor_name" class="neu-input" placeholder="e.g. Quantum Computing" value={profile.mentor_name || ""} />
                    <span class="material-symbols-outlined neu-input-suffix">expand_more</span>
                  </div>
                </div>

                <div class="form-group">
                  <label for="academic_tier">Academic Tier</label>
                  <div class="neu-input-wrap">
                    <select id="academic_tier" class="neu-input neu-input-iconed">
                      <option value="">— Select tier —</option>
                      <option value="JUNIOR" selected={profile.academic_tier === "JUNIOR"}>Junior</option>
                      <option value="FOUNDATION" selected={profile.academic_tier === "FOUNDATION"}>Foundation</option>
                      <option value="UG" selected={profile.academic_tier === "UG"}>UG (Undergraduate)</option>
                      <option value="PG" selected={profile.academic_tier === "PG"}>PG (Postgraduate)</option>
                      <option value="PHD" selected={profile.academic_tier === "PHD"}>PhD (Doctorate)</option>
                    </select>
                  </div>
                </div>

                <div class="form-group" id="edit-course-group" style={["UG","PG","PHD"].includes(profile.academic_tier) ? "" : "display:none"}>
                  <label for="course_name">Course Name / Subject</label>
                  <input type="text" id="course_name" class="neu-input" placeholder="e.g. BSc Physics, MA History" value={profile.course_name || ""} />
                </div>

                <div class="form-group">
                  <label for="mentor_id">Academic Mentor / Supervisor</label>
                  <div class="neu-input-wrap">
                    <span class="material-symbols-outlined neu-input-icon">school</span>
                    <select id="mentor_id" class="neu-input neu-input-iconed">
                      <option value="">Select mentor...</option>
                      {mentors?.map((m) => (
                        <option value={m.id} selected={profile.mentor_id === m.id}>{m.name}</option>
                      ))}
                    </select>
                  </div>
                </div>

                <div class="form-group">
                  <label>Research Subjects</label>
                  <div class="subject-panel">
                    <div class="subject-pills" id="subject-pills">
                      {profileSubjects.map((s) => (
                        <div class="subject-pill" data-subject={s}>
                          <span>{s}</span>
                          <span class="subject-pill-remove material-symbols-outlined" data-subject={s}>close</span>
                        </div>
                      ))}
                    </div>
                    <div class="subject-add-row">
                      <select id="subject-select" class="neu-input subject-select">
                        <option value="">Add a subject...</option>
                        {subjects?.filter((s) => !profileSubjects.includes(s.name)).map((s) => (
                          <option value={s.name}>{s.name}</option>
                        ))}
                      </select>
                      <button type="button" id="add-subject-btn" class="btn-icon">
                        <span class="material-symbols-outlined">add</span>
                      </button>
                    </div>
                  </div>
                </div>

                <div class="form-group">
                  <label>Professional Employment</label>
                  <div style="display:flex;gap:0.5rem;flex-wrap:wrap">
                    <div class="neu-input-wrap" style="flex:1;min-width:140px">
                      <input type="text" id="job_title" class="neu-input" placeholder="Job Title" value={profile.job_title || ""} />
                    </div>
                    <div class="neu-input-wrap" style="flex:1;min-width:140px">
                      <input type="text" id="organisation" class="neu-input" placeholder="Organisation" value={profile.organisation || ""} />
                    </div>
                  </div>
                  <small style="color:var(--color-on-surface-variant);font-size:0.75rem">If filled, your profile will show an "Alumni" badge.</small>
                </div>

                <div class="form-section-divider">
                  <span class="form-section-line"></span>
                  <span class="form-section-label">Biography</span>
                  <span class="form-section-line"></span>
                </div>

                <div class="form-group">
                  <label for="biography">Academic Statement</label>
                  <textarea id="biography" class="neu-input neu-textarea" maxlength="400" rows="3" placeholder="Briefly state your core scientific interests, research objectives, or current focus fields within the Madeenathunnoor community...">{profile.biography || ""}</textarea>
                  <div class="bio-counter"><span id="bio-count">{profile.biography ? profile.biography.length : 0}</span> / 400</div>
                </div>

                <div class="form-section-divider">
                  <span class="form-section-line"></span>
                  <span class="form-section-label">Social Links</span>
                  <span class="form-section-line"></span>
                </div>

                <div class="form-group">
                  <div id="social-links-container">
                    {socialLinks.map((sl, i) => (
                      <div class="social-link-row" data-index={i}>
                        <select class="neu-input social-platform">
                          {socialPlatforms.map((p) => (
                            <option value={p} selected={sl.platform === p}>{p}</option>
                          ))}
                        </select>
                        <input type="text" class="neu-input social-value" placeholder="Username or URL" value={sl.value} />
                        <button type="button" class="social-remove-btn" title="Remove">
                          <span class="material-symbols-outlined">close</span>
                        </button>
                      </div>
                    ))}
                  </div>
                  <div class="social-add-row">
                    <select id="social-platform-select" class="neu-input">
                      {socialPlatforms.map((p) => (
                        <option value={p}>{p}</option>
                      ))}
                    </select>
                    <input type="text" id="social-value-input" class="neu-input" placeholder="Username or URL" />
                    <button type="button" id="add-social-btn" class="btn-icon">
                      <span class="material-symbols-outlined">add</span>
                    </button>
                  </div>
                </div>

                <div class="form-section-divider">
                  <span class="form-section-line"></span>
                  <span class="form-section-label">Technical Capabilities</span>
                  <span class="form-section-line"></span>
                </div>

                <div class="form-group">
                  <label>Developer Stack</label>
                  <div class="subject-panel">
                    <div class="subject-pills" id="tech-pills">
                      {techStack.map((s) => (
                        <div class="subject-pill" data-tech={s}>
                          <span>{s}</span>
                          <span class="subject-pill-remove material-symbols-outlined" data-tech={s}>close</span>
                        </div>
                      ))}
                    </div>
                    <div class="subject-add-row">
                      <select id="tech-select" class="neu-input subject-select">
                        <option value="">Add a technology...</option>
                        {commonTechTags.filter((t) => !techStack.includes(t)).map((t) => (
                          <option value={t}>{t}</option>
                        ))}
                      </select>
                      <button type="button" id="add-tech-btn" class="btn-icon">
                        <span class="material-symbols-outlined">add</span>
                      </button>
                    </div>
                  </div>
                </div>

                <div class="form-section-divider">
                  <span class="form-section-line"></span>
                  <span class="form-section-label">Verifiable Milestones</span>
                  <span class="form-section-line"></span>
                </div>

                <div class="form-group">
                  <div id="milestones-container">
                    {(milestones || []).map((m, i) => (
                      <div class="milestone-row" data-index={i}>
                        <input type="text" class="neu-input milestone-title" placeholder="Milestone title" value={m.title} />
                        <input type="text" class="neu-input milestone-issuer" placeholder="Issuing body" value={m.issuer} />
                        <input type="url" class="neu-input milestone-url" placeholder="Verification URL" value={m.url} />
                        <button type="button" class="milestone-remove-btn" title="Remove">
                          <span class="material-symbols-outlined">close</span>
                        </button>
                      </div>
                    ))}
                  </div>
                  <button type="button" id="add-milestone-btn" class="btn-neu btn-secondary neu-button" style="margin-top:0.5rem;width:100%;justify-content:center">
                    <span class="material-symbols-outlined">add</span>
                    Add Milestone
                  </button>
                </div>

                <div class="form-group">
                  <label>Profile Photo</label>
                  <div class="avatar-upload">
                    {avatarUrl ? (
                      <img src={avatarUrl} alt="Current" class="avatar-preview-img" id="avatar-preview" />
                    ) : (
                      <div class="avatar-placeholder" id="avatar-placeholder">
                        <span class="material-symbols-outlined">person</span>
                      </div>
                    )}
                    <div class="avatar-controls">
                      <label class="btn-upload">
                        Choose Image
                        <input type="file" id="avatar-input" accept=".jpg,.jpeg,.png" style="display:none" />
                      </label>
                      <p class="avatar-hint">JPG or PNG only. Max 2MB.</p>
                      <p id="avatar-error" class="error-msg"></p>
                    </div>
                  </div>
                </div>

                <input type="hidden" id="subjects-input" name="subjects" value={JSON.stringify(profileSubjects)} />

                <div class="form-section-divider">
                  <span class="form-section-line"></span>
                  <span class="form-section-label">Current Project</span>
                  <span class="form-section-line"></span>
                </div>

                <div class="form-group">
                  <label for="repo_url">Repository URL</label>
                  <input type="url" id="repo_url" class="neu-input" placeholder="https://github.com/username/repo" value={profile.repo_url || ""} />
                </div>

                <div class="form-group">
                  <label for="deploy_url">Deployment URL (Live Site)</label>
                  <input type="url" id="deploy_url" class="neu-input" placeholder="https://your-project.vercel.app" value={profile.deploy_url || ""} />
                </div>

                <div class="form-group">
                  <label for="project_title">Project Title</label>
                  <input type="text" id="project_title" class="neu-input" placeholder="e.g. Exoplanet Transit Modeling" value={profile.project_title || ""} />
                </div>

                <div class="form-group">
                  <label for="project_description">Project Description</label>
                  <textarea id="project_description" class="neu-input neu-textarea" rows="3" placeholder="Describe your current research project...">{profile.project_description || ""}</textarea>
                </div>

                <div class="form-group">
                  <label for="project_progress">Completion Progress: <span id="progress-val">{profile.project_progress || 0}</span>%</label>
                  <div class="progress-slider-wrap">
                    <input type="range" id="project_progress" class="progress-slider" min="0" max="100" value={profile.project_progress || 0} />
                    <div class="progress-slider-labels">
                      <span>0%</span>
                      <span>50%</span>
                      <span>100%</span>
                    </div>
                  </div>
                </div>

                <p id="form-error" class="error-msg"></p>
                <p id="form-success" class="success-msg"></p>

                <div class="form-actions">
                  <button type="button" class="btn-neu btn-secondary neu-button" id="discard-btn">Discard Changes</button>
                  <button type="submit" class="btn-neu btn-primary neu-button" id="save-btn">
                    <span class="material-symbols-outlined">save</span>
                    Save Profile
                  </button>
                </div>
              </form>

              <!-- Discard confirmation modal -->
              <div class="discard-modal-overlay" id="discard-modal">
                <div class="discard-modal">
                  <div class="discard-modal-icon">
                    <span class="material-symbols-outlined">info</span>
                  </div>
                  <h3 class="discard-modal-title">Discard Changes?</h3>
                  <p class="discard-modal-text">You have unsaved changes. Are you sure you want to go back?</p>
                  <div class="discard-modal-actions">
                    <button class="btn-neu btn-secondary" id="discard-cancel">Stay</button>
                    <button class="btn-neu btn-primary discard-modal-danger" id="discard-confirm">Discard</button>
                  </div>
                </div>
              </div>
            </div>
          </section>
        </div>
      )
    }
    </main>
  </div>

<nav class="pe-bottom-nav">
  <a href="/dashboard/feed" class="pe-nav-item">
    <span class="material-symbols-outlined">dynamic_feed</span>
    <span>Feed</span>
  </a>
  <a href="/dashboard" class="pe-nav-item">
    <span class="material-symbols-outlined">account_circle</span>
    <span>Portfolio</span>
  </a>
  <a href="/dashboard/events" class="pe-nav-item">
    <span class="material-symbols-outlined">event</span>
    <span>Events</span>
  </a>
   <a href="/dashboard/settings" class="pe-nav-item">
    <span class="material-symbols-outlined">settings</span>
    <span>Settings</span>
  </a>
</nav>
</BaseLayout>

<script>
  import { createBrowserClient } from "@supabase/ssr";
  const form = document.getElementById("profile-form");
  const errorEl = document.getElementById("form-error");
  const successEl = document.getElementById("form-success");
  const saveBtn = document.getElementById("save-btn");
  const discardBtn = document.getElementById("discard-btn");
  const avatarInput = document.getElementById("avatar-input");
  const avatarPreview = document.getElementById("avatar-preview");
  const avatarPlaceholder = document.getElementById("avatar-placeholder");
  const avatarError = document.getElementById("avatar-error");
  const subjectSelect = document.getElementById("subject-select");
  const addSubjectBtn = document.getElementById("add-subject-btn");
  const subjectPills = document.getElementById("subject-pills");
  const subjectsInput = document.getElementById("subjects-input");

  let selectedSubjects = JSON.parse(subjectsInput?.value || "[]");
  let selectedTech = [];

  // Initialize tech stack
  const techPills = document.getElementById("tech-pills");
  const techSelect = document.getElementById("tech-select");
  const addTechBtn = document.getElementById("add-tech-btn");
  const techInput = document.getElementById("tech-stack-input");

  // Populate tech select options
  if (techSelect) {
    const commonTags = JSON.parse(techSelect.dataset.allTags || "[]");
    // Set selected tech from existing pills
    techPills?.querySelectorAll(".subject-pill").forEach((pill) => {
      const t = pill.dataset.tech;
      if (t && !selectedTech.includes(t)) selectedTech.push(t);
    });

    // Initialize with current selection
    updateTechOptions();
  }

  function updateTechOptions() {
    if (!techSelect) return;
    const val = techSelect.value;
    techSelect.innerHTML = '<option value="">Add a technology...</option>';
    const allTags = JSON.parse(techSelect.dataset.allTags || "[]");
    allTags
      .filter((t) => !selectedTech.includes(t))
      .forEach((t) => {
        const opt = document.createElement("option");
        opt.value = t;
        opt.textContent = t;
        techSelect.appendChild(opt);
      });
    techSelect.value = val && !selectedTech.includes(val) ? "" : val;
  }

  function renderTechPills() {
    if (!techPills) return;
    techPills.innerHTML = selectedTech
      .map((t) => `<div class="subject-pill" data-tech="${t}"><span>${t}</span><span class="subject-pill-remove material-symbols-outlined" data-tech="${t}">close</span></div>`)
      .join("");
    techPills.querySelectorAll(".subject-pill-remove").forEach((btn) => {
      btn.addEventListener("click", () => {
        selectedTech = selectedTech.filter((t) => t !== btn.dataset.tech);
        renderTechPills();
        updateTechOptions();
      });
    });
  }

  addTechBtn?.addEventListener("click", () => {
    const val = techSelect?.value;
    if (!val || selectedTech.includes(val)) return;
    selectedTech.push(val);
    renderTechPills();
    updateTechOptions();
    techSelect.value = "";
  });

  function updateSubjectsInput() {
    subjectsInput.value = JSON.stringify(selectedSubjects);
  }

  function renderPills() {
    if (!subjectPills) return;
    subjectPills.innerHTML = selectedSubjects
      .map((s) => `<div class="subject-pill" data-subject="${s}"><span>${s}</span><span class="subject-pill-remove material-symbols-outlined" data-subject="${s}">close</span></div>`)
      .join("");
    subjectPills.querySelectorAll(".subject-pill-remove").forEach((btn) => {
      btn.addEventListener("click", () => {
        selectedSubjects = selectedSubjects.filter((s) => s !== btn.dataset.subject);
        updateSubjectsInput();
        renderPills();
        updateSubjectOptions();
      });
    });
  }

  function updateSubjectOptions() {
    if (!subjectSelect) return;
    const currentVal = subjectSelect.value;
    subjectSelect.innerHTML = '<option value="">Add a subject...</option>';
    const allSubjects = JSON.parse(subjectSelect.dataset.allSubjects || "[]");
    allSubjects
      .filter((s) => !selectedSubjects.includes(s))
      .forEach((s) => {
        const opt = document.createElement("option");
        opt.value = s;
        opt.textContent = s;
        subjectSelect.appendChild(opt);
      });
    subjectSelect.value = currentVal && !selectedSubjects.includes(currentVal) ? "" : currentVal;
  }

  addSubjectBtn?.addEventListener("click", () => {
    const val = subjectSelect?.value;
    if (!val || selectedSubjects.includes(val)) return;
    selectedSubjects.push(val);
    updateSubjectsInput();
    renderPills();
    updateSubjectOptions();
    subjectSelect.value = "";
  });

  document.getElementById("mob-avatar-trigger")?.addEventListener("click", () => {
    avatarInput?.click();
  });

  avatarInput?.addEventListener("change", (e) => {
    avatarError.textContent = "";
    const file = e.target.files?.[0];
    if (!file) return;

    const validTypes = ["image/jpeg", "image/png"];
    if (!validTypes.includes(file.type)) {
      avatarError.textContent = "Only JPG and PNG files are allowed.";
      e.target.value = "";
      return;
    }

    if (file.size > 2 * 1024 * 1024) {
      avatarError.textContent = "File size exceeds 2MB limit.";
      e.target.value = "";
      return;
    }

    const reader = new FileReader();
    reader.onload = (ev) => {
      if (avatarPreview) {
        avatarPreview.src = ev.target?.result;
      } else if (avatarPlaceholder) {
        const img = document.createElement("img");
        img.src = ev.target?.result;
        img.className = "avatar-preview-img";
        img.id = "avatar-preview";
        avatarPlaceholder.replaceWith(img);
      }
      const mobImg = document.getElementById("mob-avatar-img");
      const mobPlaceholder = document.getElementById("mob-avatar-placeholder");
      if (mobImg) {
        mobImg.src = ev.target?.result;
      } else if (mobPlaceholder) {
        const img = document.createElement("img");
        img.src = ev.target?.result;
        img.className = "mob-avatar-img";
        img.id = "mob-avatar-img";
        mobPlaceholder.replaceWith(img);
      }
      // Sync preview card avatar
      const previewAvatar = document.querySelector(".preview-avatar img");
      const previewPlaceholder = document.querySelector(".preview-avatar .material-symbols-outlined");
      if (previewAvatar) {
        previewAvatar.src = ev.target?.result;
      } else if (previewPlaceholder) {
        const pImg = document.createElement("img");
        pImg.src = ev.target?.result;
        pImg.alt = "Profile";
        previewPlaceholder.replaceWith(pImg);
      }
    };
    reader.readAsDataURL(file);
  });


  function getSupabase() {
    return createBrowserClient(
      import.meta.env.PUBLIC_SUPABASE_URL,
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY
    );
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.textContent = "";
    successEl.textContent = "";
    saveBtn.disabled = true;
    saveBtn.innerHTML = "Saving...";

    try {
      const supabase = await getSupabase();

      const { data: { user } } = await supabase.auth.getUser();
      if (!user) throw new Error("Not authenticated");

            // Collect milestones
      const milestoneRows = document.querySelectorAll(".milestone-row");
      const milestones = Array.from(milestoneRows).map((row) => ({
        title: row.querySelector(".milestone-title")?.value?.trim() || "",
        issuer: row.querySelector(".milestone-issuer")?.value?.trim() || "",
        url: row.querySelector(".milestone-url")?.value?.trim() || "",
      })).filter((m) => m.title);

            // Collect social links
      const socialRows = document.querySelectorAll(".social-link-row");
      const socialLinks = Array.from(socialRows).map((row) => ({
        platform: row.querySelector(".social-platform")?.value || "",
        value: row.querySelector(".social-value")?.value?.trim() || "",
      })).filter((s) => s.platform && s.value);

      const displayName = document.getElementById("display_name").value.trim();
      const campusId = document.getElementById("campus_id").value;
      const mentorName = document.getElementById("mentor_name").value.trim();
      const mentorId = document.getElementById("mentor_id").value;
      const academicTier = document.getElementById("academic_tier").value;
      const courseName = document.getElementById("course_name").value.trim();
      const jobTitle = document.getElementById("job_title").value.trim();
      const organisation = document.getElementById("organisation").value.trim();
      const achievements = document.getElementById("achievements")?.value?.trim() || "";
      const biography = document.getElementById("biography")?.value?.trim() || "";
      const repoUrl = document.getElementById("repo_url").value.trim();
      const deployUrl = document.getElementById("deploy_url").value.trim();
      const projectTitle = document.getElementById("project_title").value.trim();
      const projectDescription = document.getElementById("project_description").value.trim();
      const projectProgress = parseInt(document.getElementById("project_progress").value, 10) || 0;

      const { error: updateError } = await supabase
        .from("profiles")
        .update({
          display_name: displayName,
          campus_id: campusId || null,
          mentor_name: mentorName,
          mentor_id: mentorId || null,
          academic_tier: academicTier,
          course_name: courseName,
          job_title: jobTitle,
          organisation: organisation,
          subjects: selectedSubjects,
          achievements,
          biography,
          tech_stack: selectedTech,
          milestones,
          social_links: socialLinks,
          repo_url: repoUrl,
          deploy_url: deployUrl,
          project_title: projectTitle,
          project_description: projectDescription,
          project_progress: projectProgress,
        })
        .eq("id", user.id);

      if (updateError) throw updateError;

      const fileInput = avatarInput;
      if (fileInput?.files?.[0]) {
        const file = fileInput.files[0];
        const ext = file.name.split(".").pop();
        const filePath = `${user.id}/${Date.now()}.${ext}`;

        const { error: uploadError } = await supabase.storage
          .from("avatars")
          .upload(filePath, file, { upsert: true });

        if (uploadError) throw uploadError;

        await supabase
          .from("profiles")
          .update({ avatar_url: filePath })
          .eq("id", user.id);
      }

      successEl.textContent = "Profile saved successfully!";
      setTimeout(() => window.location.href = "/dashboard", 1500);
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message : "Failed to save profile.";
    } finally {
      saveBtn.disabled = false;
      saveBtn.innerHTML = '<span class="material-symbols-outlined">save</span> Save Profile';
    }
  });

  (function init() {
    const select = document.getElementById("subject-select");
    if (select) {
      const options = select.querySelectorAll("option");
      const all = Array.from(options).map((o) => o.value).filter(Boolean);
      select.dataset.allSubjects = JSON.stringify(all);
    }
    renderPills();

    // Milestones add/remove
    const milestonesContainer = document.getElementById("milestones-container");
    document.getElementById("add-milestone-btn")?.addEventListener("click", () => {
      const row = document.createElement("div");
      row.className = "milestone-row";
      row.innerHTML = `
        <input type="text" class="neu-input milestone-title" placeholder="Milestone title" />
        <input type="text" class="neu-input milestone-issuer" placeholder="Issuing body" />
        <input type="url" class="neu-input milestone-url" placeholder="Verification URL" />
        <button type="button" class="milestone-remove-btn" title="Remove"><span class="material-symbols-outlined">close</span></button>
      `;
      row.querySelector(".milestone-remove-btn").addEventListener("click", () => row.remove());
      milestonesContainer?.appendChild(row);
    });
    milestonesContainer?.querySelectorAll(".milestone-remove-btn").forEach((btn) => {
      btn.addEventListener("click", () => btn.closest(".milestone-row")?.remove());
    });

    // Social links add/remove
    const socialContainer = document.getElementById("social-links-container");
    document.getElementById("add-social-btn")?.addEventListener("click", () => {
      const platform = document.getElementById("social-platform-select")?.value;
      const value = document.getElementById("social-value-input")?.value?.trim();
      if (!platform || !value) return;
      const row = document.createElement("div");
      row.className = "social-link-row";
      row.innerHTML = `
        <select class="neu-input social-platform">${Array.from(document.getElementById("social-platform-select")?.querySelectorAll("option") || []).map((o) => `<option value="${o.value}"${o.value === platform ? " selected" : ""}>${o.textContent}</option>`).join("")}</select>
        <input type="text" class="neu-input social-value" value="${value.replace(/"/g, "&quot;")}" placeholder="Username or URL" />
        <button type="button" class="social-remove-btn" title="Remove"><span class="material-symbols-outlined">close</span></button>
      `;
      row.querySelector(".social-remove-btn").addEventListener("click", () => row.remove());
      socialContainer?.appendChild(row);
      document.getElementById("social-value-input").value = "";
    });
    socialContainer?.querySelectorAll(".social-remove-btn").forEach((btn) => {
      btn.addEventListener("click", () => btn.closest(".social-link-row")?.remove());
    });

    // Tech stack tag options
    if (techSelect) {
      const tags = Array.from(techSelect.querySelectorAll("option")).map((o) => o.value).filter(Boolean);
      techSelect.dataset.allTags = JSON.stringify(tags);
    }

    // Progress slider live value
    const progressSlider = document.getElementById("project_progress");
    const progressVal = document.getElementById("progress-val");
    progressSlider?.addEventListener("input", () => {
      if (progressVal) progressVal.textContent = progressSlider.value;
    });

    // Academic tier → toggle course name
    const tierSelect = document.getElementById("academic_tier");
    const courseGroup = document.getElementById("edit-course-group");
    tierSelect?.addEventListener("change", () => {
      const val = tierSelect.value;
      if (courseGroup) {
        courseGroup.style.display = ["UG", "PG", "PHD"].includes(val) ? "block" : "none";
      }
    });

    // Discard confirmation
    discardBtn?.addEventListener("click", () => {
      document.getElementById("discard-modal")?.classList.add("open");
    });
    document.getElementById("discard-confirm")?.addEventListener("click", () => {
      window.location.href = "/dashboard";
    });
    document.getElementById("discard-cancel")?.addEventListener("click", () => {
      document.getElementById("discard-modal")?.classList.remove("open");
    });
    document.getElementById("discard-modal")?.addEventListener("click", (e) => {
      if (e.target === e.currentTarget) {
        document.getElementById("discard-modal")?.classList.remove("open");
      }
    });

    // ── Biography char counter ──
    const bioInput = document.getElementById("biography");
    const bioCount = document.getElementById("bio-count");
    function updateBioCount() {
      if (bioInput && bioCount) {
        const len = bioInput.value.length;
        bioCount.textContent = len;
        bioCount.closest(".bio-counter")?.classList.toggle("near-limit", len >= 380);
      }
    }
    bioInput?.addEventListener("input", updateBioCount);
    updateBioCount();
  })();
</script>

