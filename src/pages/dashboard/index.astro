<script>
  import { createBrowserClient } from "@supabase/ssr";

  // "See more" toggle for post content
  document.addEventListener("click", (e) => {
    const btn = e.target.closest(".pp-post-seemore");
    if (!btn) return;
    const text = btn.parentElement.querySelector(".pp-post-text");
    if (!text) return;
    text.classList.toggle("expanded");
    btn.textContent = text.classList.contains("expanded") ? "Show less" : "See more";
  });
  document.querySelectorAll(".pp-post-text").forEach((el) => {
    if (el.scrollHeight > el.clientHeight) {
      const btn = el.parentElement.querySelector(".pp-post-seemore");
      if (btn) btn.style.display = "";
    }
  });

  // Copy portfolio link
  const copyBtn = document.getElementById("copy-portfolio-link");
  copyBtn?.addEventListener("click", async () => {
    const url = copyBtn.getAttribute("data-url");
    if (!url) return;
    try {
      await navigator.clipboard.writeText(url);
      copyBtn.innerHTML = '<span class="material-symbols-outlined" style="font-size:16px">check</span> Copied!';
      setTimeout(() => {
        copyBtn.innerHTML = '<span class="material-symbols-outlined" style="font-size:16px">link</span> Copy Portfolio Link';
      }, 2000);
    } catch {
      const ta = document.createElement("textarea");
      ta.value = url;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      document.body.removeChild(ta);
    }
  });

  // Follow toggle
  const orbitBtn = document.getElementById("orbit-btn");
  orbitBtn?.addEventListener("click", async () => {
    const userId = orbitBtn.dataset.userId;
    const isOrbiting = orbitBtn.dataset.orbiting === "true";
    const supabase = createBrowserClient(
      import.meta.env.PUBLIC_SUPABASE_URL,
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY
    );
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) return;
    if (isOrbiting) {
      const { error } = await supabase.from("orbits").delete().eq("orbiter_id", user.id).eq("orbiting_id", userId);
      if (error) { console.error(error); return; }
      orbitBtn.dataset.orbiting = "false";
      orbitBtn.textContent = "Follow";
      const countEl = document.getElementById("orbiting-count");
      if (countEl) countEl.textContent = Math.max(0, parseInt(countEl.textContent) - 1);
    } else {
      const { error } = await supabase.from("orbits").insert({ orbiter_id: user.id, orbiting_id: userId });
      if (error) { console.error(error); return; }
      orbitBtn.dataset.orbiting = "true";
      orbitBtn.textContent = "Following";
      const countEl = document.getElementById("orbiting-count");
      if (countEl) countEl.textContent = parseInt(countEl.textContent) + 1;
    }
  });

  // Mobile tab switching
  const tabs = document.querySelectorAll(".pp-mtab");
  const panels = document.querySelectorAll(".pp-tab-panel");
  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const target = tab.dataset.tab;
      tabs.forEach((t) => t.classList.remove("active"));
      tab.classList.add("active");
      panels.forEach((p) => {
        p.classList.toggle("pp-tab-panel--active", p.dataset.tab === target);
      });
    });
  });

  // Like / unlike on portfolio
  document.querySelectorAll(".pp-like-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const postId = btn.dataset.postId;
      const liked = btn.dataset.liked === "true";
      const icon = btn.querySelector(".pp-like-icon");
      const countEl = btn.querySelector(".pp-like-count");
      const supabase = createBrowserClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY
      );
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) return;
      if (liked) {
        const { error } = await supabase.from("post_likes").delete().eq("post_id", postId).eq("user_id", user.id);
        if (error) { console.error(error); return; }
        btn.dataset.liked = "false";
        if (icon) icon.textContent = "favorite_border";
        if (countEl) countEl.textContent = Math.max(0, parseInt(countEl.textContent) - 1);
      } else {
        const { error } = await supabase.from("post_likes").insert({ post_id: postId, user_id: user.id });
        if (error) { console.error(error); return; }
        btn.dataset.liked = "true";
        if (icon) icon.textContent = "favorite";
        if (countEl) countEl.textContent = parseInt(countEl.textContent) + 1;
      }
    });
  });
</script>

<style is:global>
  .pp-root {
    display: flex;
    min-height: 100vh;
    background: #f7f9fc;
    font-family: Inter, sans-serif;
  }

  .pp-main {
    flex: 1;
    overflow-y: auto;
    padding: 2rem;
    margin-left: 64px;
    transition: margin-left 0.2s ease;
  }

  body:has(.ds-sidebar:hover) .pp-main {
    margin-left: 240px;
  }

  .pp-container {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 1024px) {
    .pp-container {
      grid-template-columns: 2fr 1fr;
    }
  }

  /* ── Card base ── */
  .pp-card {
    background: #f7f9fc;
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 8px 8px 16px #D1D9E6, -8px -8px 16px #FFFFFF;
    margin-bottom: 1.5rem;
  }

  /* ── Hero card ── */
  .pp-hero-inner {
