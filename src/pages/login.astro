---
import BaseLayout from "../layouts/BaseLayout.astro";
import SplashScreen from "../components/SplashScreen.astro";
const errorParam = Astro.url.searchParams.get("error");
const loginPrefill = Astro.url.searchParams.get("login") ?? Astro.url.searchParams.get("email");
---

<BaseLayout title="Login">
  <SplashScreen autoHide={3000} oncePerSession />
  <div class="auth-page">
    <div class="auth-card">
      <div class="auth-card-inner">
        <h1>Welcome Back</h1>
        <p class="auth-subtitle">Sign in to <b>Science Orbit</b></p>
        <form id="login-form" class="auth-form">
          <div class="form-group">
            <label for="login">Email or Username</label>
            <input type="text" id="login" name="login" required placeholder="Your email or username" value={loginPrefill ?? ""} />
          </div>
          <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" required placeholder="Your password" />
          </div>
          <p id="error-msg" class="error-msg">{errorParam}</p>
          <button type="submit" class="btn-primary" id="submit-btn">Sign In</button>
        </form>
        <p class="auth-footer">
          Don't have an account? <a href="/register">Register here</a>
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { createBrowserClient } from "@supabase/ssr";
  const form = document.getElementById("login-form");
  const errorMsg = document.getElementById("error-msg");
  const submitBtn = document.getElementById("submit-btn");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (errorMsg) errorMsg.textContent = "";
    if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = "Signing in..."; }

    const login = document.getElementById("login").value.trim();
    const password = document.getElementById("password").value;

    try {
      const supabase = createBrowserClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY
      );

      let email = login;
      if (!login.includes("@")) {
        const { data: emailResult, error: rpcErr } = await supabase.rpc("lookup_username_email", { p_username: login });
        if (rpcErr) throw rpcErr;
        if (!emailResult) throw new Error("Invalid username or password");
        email = emailResult;
      }

      const { error: signInError } = await supabase.auth.signInWithPassword({ email, password });
      if (signInError) throw signInError;

      const { data: { user } } = await supabase.auth.getUser();
      if (user) {
        const { data: profile } = await supabase
          .from("profiles")
          .select("is_admin")
          .eq("id", user.id)
          .single();
        if (profile?.is_admin) {
          window.location.href = "/admin";
          return;
        }
      }

       window.location.href = "/dashboard";
    } catch (err) {
      if (errorMsg) errorMsg.textContent = err.message || "Sign in failed.";
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = "Sign In"; }
    }
  });
</script>

<style is:global>
  .auth-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 2rem;
    background: var(--color-neu-base);
  }

  .auth-card {
    width: 100%;
    max-width: 420px;
    padding: 2px;
  }

  .auth-card-inner {
    background: var(--color-surface-container-low);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: var(--shadow-extruded);
  }

  .auth-card h1 {
    font-family: var(--font-headline);
    font-size: 1.5rem;
    margin-bottom: 0;
  }

  .auth-subtitle {
    color: var(--color-on-surface-variant);
    margin-bottom: 2rem;
    font-size: 0.8rem;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 0.25rem;
  }

  .form-group label {
    font-family: var(--font-label);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-on-surface-variant);
  }

  .form-group input {
    padding: .6rem .85rem;
    border-bottom: 1px solid #000000 !important;
    border: none;
    border-radius: var(--radius-default);
    font-size: .9rem;
    outline: none;
    background: #f2f4f7;
    box-shadow: inset -7px -5px 6px var(--color-neu-highlight);
    transition: box-shadow 0.15s;
  }

  .form-group input:focus {
    box-shadow: var(--shadow-recessed), 0 0 0 2px var(--color-primary-container);
  }

  .form-group input::placeholder {
    color: var(--color-outline);
  }

  .error-msg {
    color: var(--color-error);
    font-size: 0.82rem;
    min-height: 1rem;
  }

  .btn-primary {
    background: var(--color-neu-base);
    color: var(--color-primary);
    padding: 0.6rem 1.1rem;
    border: none;
    border-radius: var(--radius-default);
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 0.88rem;
    box-shadow: var(--shadow-extruded);
    transition: all 0.15s;
    letter-spacing: 0.02em;
    margin-top: 0.5rem;
  }

  .btn-primary:hover:not(:disabled) {
    box-shadow: var(--shadow-extruded-hover);
    color: var(--color-primary);
  }

  .btn-primary:active:not(:disabled) {
    box-shadow: var(--shadow-recessed);
  }

  .btn-primary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .auth-footer {
    margin-top: 1.25rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--color-on-surface-variant);
  }
</style>
