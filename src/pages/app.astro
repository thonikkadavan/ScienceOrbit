---
import BaseLayout from "../layouts/BaseLayout.astro";
import MobileAppShell from "../components/MobileAppShell.astro";
import { createClient } from "../lib/supabase";
import { getProfile, getSessionUser, getProfileById } from "../lib/auth";

const supabase = createClient({ request: Astro.request, cookies: Astro.cookies });
const sessionUser = await getSessionUser(supabase);
const profile = await getProfile(supabase);

const avatarUrl = profile?.avatar_url
  ? supabase.storage.from("avatars").getPublicUrl(profile.avatar_url).data.publicUrl
  : null;

// ── Feed data ──
const { data: newUsers } = await supabase
  .from("profiles")
  .select("id, username, display_name, avatar_url, legal_name")
  .order("created_at", { ascending: false })
  .limit(3);

const { data: posts } = await supabase
  .from("posts")
  .select("id, user_id, content, title, created_at, image_url, file_url, file_name")
  .order("created_at", { ascending: false })
  .limit(50);

const authorIds = [...new Set((posts || []).map((p) => p.user_id))];
const { data: authors } = authorIds.length
  ? await supabase.from("profiles").select("id, username, display_name, avatar_url").in("id", authorIds)
  : { data: [] };
const authorMap = new Map((authors || []).map((a) => [a.id, a]));
const postsWithAuthors = (posts || []).map((p) => ({ ...p, author: authorMap.get(p.user_id) || null }));

for (let i = postsWithAuthors.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [postsWithAuthors[i], postsWithAuthors[j]] = [postsWithAuthors[j], postsWithAuthors[i]];
}

const postIds = (posts || []).map((p) => p.id);
const { data: likeCounts } = postIds.length
  ? await supabase.from("post_likes").select("post_id").in("post_id", postIds)
  : { data: [] };
const likeCountMap = new Map<string, number>();
(likeCounts || []).forEach((l) => {
  likeCountMap.set(l.post_id, (likeCountMap.get(l.post_id) || 0) + 1);
});
let likedPosts = new Set<string>();
if (sessionUser && postIds.length) {
  const { data: myLikes } = await supabase
    .from("post_likes")
    .select("post_id")
    .in("post_id", postIds)
    .eq("user_id", sessionUser.id);
  likedPosts = new Set((myLikes || []).map((l) => l.post_id));
}

// ── Portfolio data ──
const targetProfile = profile;
const isOwner = sessionUser?.id === targetProfile?.id;
const isApproved = targetProfile?.is_approved ?? false;

const dastharUrl = targetProfile?.dasthar_url
  ? supabase.storage.from("dasthar").getPublicUrl(targetProfile.dasthar_url).data.publicUrl
  : null;

const campusName = targetProfile?.campuses?.name ?? "";
const mentorName = targetProfile?.mentors?.name || targetProfile?.mentor_name;
const portfolioUrl = targetProfile ? `${Astro.url.origin}/dashboard?user=${targetProfile.id}` : "";
const projectTitle = targetProfile?.project_title || "";
const projectDescription = targetProfile?.project_description || "";
const projectProgress = targetProfile?.project_progress || 0;
const githubHandle = targetProfile?.github_handle || "";
const linkedinUrl = targetProfile?.linkedin_url || "";
const academicTier = targetProfile?.academic_tier || "";
const courseName = targetProfile?.course_name || "";
const jobTitle = targetProfile?.job_title || "";
const organisation = targetProfile?.organisation || "";
const isAlumni = !!(jobTitle && organisation);
const techStack: string[] = targetProfile?.tech_stack || [];
const repoUrl = targetProfile?.repo_url || "";
const deployUrl = targetProfile?.deploy_url || "";

let milestones: { title: string; issuer: string; url: string }[] = [];
try {
  milestones = typeof targetProfile?.milestones === "string"
    ? JSON.parse(targetProfile.milestones)
    : (targetProfile?.milestones || []);
} catch { milestones = []; }

let socialLinks: { platform: string; value: string }[] = [];
try {
  socialLinks = typeof targetProfile?.social_links === "string"
    ? JSON.parse(targetProfile.social_links)
    : (targetProfile?.social_links || []);
} catch {}

const legacyAchievements: string[] = targetProfile?.achievements
  ? targetProfile.achievements.split("\n").filter(Boolean)
  : [];

const { data: userPosts } = await supabase
  .from("posts")
  .select("id, content, title, created_at, image_url, file_url, file_name")
  .eq("user_id", targetProfile?.id || "")
  .order("created_at", { ascending: false })
  .limit(20);

const userPostIds = (userPosts || []).map((p) => p.id);
const { data: upLikes } = userPostIds.length
  ? await supabase.from("post_likes").select("post_id").in("post_id", userPostIds)
  : { data: [] };
const portfolioLikeMap = new Map<string, number>();
(upLikes || []).forEach((l) => {
  portfolioLikeMap.set(l.post_id, (portfolioLikeMap.get(l.post_id) || 0) + 1);
});
let portfolioLikedPosts = new Set<string>();
if (sessionUser && userPostIds.length) {
  const { data: myUpLikes } = await supabase
    .from("post_likes")
    .select("post_id")
    .in("post_id", userPostIds)
    .eq("user_id", sessionUser.id);
  portfolioLikedPosts = new Set((myUpLikes || []).map((l) => l.post_id));
}

// ── Events data ──
const { data: events } = await supabase.from("events").select("*").order("event_date", { ascending: true });
const { data: registrations } = await supabase
  .from("event_registrations")
  .select("event_id")
  .eq("user_id", targetProfile?.id || "");
const registeredIds = new Set((registrations || []).map((r) => r.event_id));
const now = new Date().toISOString();
const allEvents = events || [];
const upcomingEvents = allEvents.filter((e) => e.event_date >= now);
const pastEvents = allEvents.filter((e) => e.event_date < now);
const liveEvent = upcomingEvents.find((e) => e.is_live);
const featuredEvent = liveEvent || upcomingEvents[0] || null;
const upNextEvents = upcomingEvents.slice(1, 4);
const gridEvents = upcomingEvents.filter((e) => !featuredEvent || e.id !== featuredEvent.id);
const myCalendarEvents = allEvents.filter((e) => registeredIds.has(e.id) && e.event_date >= now);
---

<BaseLayout title="Mobile SPA">
  <MobileAppShell
    sessionUser={sessionUser}
    profile={profile}
    avatarUrl={avatarUrl}
    newUsers={newUsers || []}
    postsWithAuthors={postsWithAuthors}
    likeCountMap={likeCountMap}
    likedPosts={likedPosts}
    isOwner={isOwner}
    isApproved={isApproved}
    dastharUrl={dastharUrl}
    campusName={campusName}
    mentorName={mentorName}
    portfolioUrl={portfolioUrl}
    projectTitle={projectTitle}
    projectDescription={projectDescription}
    projectProgress={projectProgress}
    githubHandle={githubHandle}
    linkedinUrl={linkedinUrl}
    academicTier={academicTier}
    courseName={courseName}
    jobTitle={jobTitle}
    organisation={organisation}
    isAlumni={isAlumni}
    techStack={techStack}
    repoUrl={repoUrl}
    deployUrl={deployUrl}
    milestones={milestones}
    socialLinks={socialLinks}
    legacyAchievements={legacyAchievements}
    userPosts={userPosts || []}
    portfolioLikeMap={portfolioLikeMap}
    portfolioLikedPosts={portfolioLikedPosts}
    events={allEvents}
    registeredIds={registeredIds}
    featuredEvent={featuredEvent}
    upNextEvents={upNextEvents}
    gridEvents={gridEvents}
    myCalendarEvents={myCalendarEvents}
    pastEvents={pastEvents}
    liveEvent={liveEvent}
  />
</BaseLayout>
